<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h3>📋 الواجبات الأونلاين</h3>
</div>

<!-- فلترة الواجبات -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3">🔎 فلتر الواجبات</h6>
    <form action="/hw/assignments" method="GET" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small">بحث عام</label>
        <input type="text" name="q" class="form-control" placeholder="عنوان أو وصف" value="<%= filters?.q || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small">المادة</label>
        <select name="subject_id" class="form-select">
          <option value="">كل المواد</option>
          <% subjects.forEach(s => { %>
            <option value="<%= s.id %>" <%= filters?.subject_id == s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small">السنتر</label>
        <select name="center_id" class="form-select">
          <option value="">كل السنتر</option>
          <% centers.forEach(c => { %>
            <option value="<%= c.id %>" <%= filters?.center_id == c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small">الحصة</label>
        <select name="session_id" class="form-select session-select">
          <option value="">كل الحصص</option>
          <% sessions.forEach(s => { %>
            <option value="<%= s.id %>" <%= filters?.session_id == s.id ? 'selected' : '' %>><%= s.Subject.name %> - <%= s.Center.name %> - حصة <%= s.lesson_number %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary w-100">تطبيق</button>
      </div>
    </form>
  </div>
</div>

<!-- إنشاء واجب جديد -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3">➕ إنشاء واجب جديد</h6>
    <form action="/hw/assignments/create" method="POST" class="row g-2">
      <div class="col-md-2">
        <input type="number" name="order_number" class="form-control" placeholder="رقم الواجب" required min="1">
      </div>
      <div class="col-md-3">
        <input type="text" name="title" class="form-control" placeholder="عنوان الواجب" required>
      </div>
      <div class="col-md-4">
        <textarea name="description" class="form-control" placeholder="وصف الواجب (اختياري)" rows="1"></textarea>
      </div>
      <div class="col-md-3">
        <select name="subject_id" class="form-select">
          <option value="">-- المادة --</option>
          <% subjects.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <select name="session_ids" class="form-select session-select" multiple style="height:auto;">
          <% sessions.forEach(s => { %><option value="<%= s.id %>"><%= s.Subject.name %> - <%= s.Center.name %> - حصة <%= s.lesson_number %></option><% }) %>
        </select>
        <small class="text-muted">اختر واحدة أو أكثر لربط الواجب بعدة حصص</small>
      </div>
      <div class="col-md-2">
        <div class="form-check" style="margin-top: 0.9rem;">
          <input class="form-check-input" type="checkbox" name="show_for_all" id="showForAll" value="1">
          <label class="form-check-label small" for="showForAll">اظهر هذا الواجب للجميع</label>
        </div>
      </div>
      <div class="col-md-2">
        <label class="form-label small">بداية التسليم</label>
        <input type="date" name="start_date" class="form-control" required>
      </div>
      <div class="col-md-2">
        <label class="form-label small">نهاية التسليم</label>
        <input type="date" name="end_date" class="form-control" required>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">إنشاء</button>
      </div>
    </form>
  </div>
</div>

<!-- قائمة الواجبات -->
<div class="row g-3">
  <% assignments.forEach(a => { %>
    <div class="col-md-4">
      <div class="card shadow-sm h-100" role="button" tabindex="0"
        onclick="openAssignment(event, '<%= a.id %>')"
        onkeydown="if (event.key === 'Enter' || event.key === ' ') openAssignment(event, '<%= a.id %>')"
        style="cursor:pointer;">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge" style="background:#EEF0FB;color:#4338CA;">واجب رقم <%= a.order_number %></span>
            <form action="/hw/assignments/<%= a.id %>/delete" method="POST" onsubmit="return confirm('حذف الواجب؟')">
              <button class="btn btn-sm btn-outline-danger">🗑️</button>
            </form>
          </div>
          <h6 class="mb-1"><%= a.title %></h6>
          <p class="small text-muted mb-2"><%= a.description || '' %></p>
          <p class="small text-muted mb-3">
            📅 <%= a.start_date %> → <%= a.end_date %><br>
            <% if (a.Subject) { %>📚 <%= a.Subject.name %><br><% } %>
            <% if (a.Session) { %>🔗 الحصة الرئيسية: <%= a.Session.Subject.name %> - <%= a.Session.Center.name %> - حصة <%= a.Session.lesson_number %><br><% } %>
            <% const linkedSessions = (a.LinkedSessions || []).filter(s => String(s.id) !== String(a.SessionId)); %>
            <% if (linkedSessions.length) { %>
              🔗 حصص مرتبطة: <%= linkedSessions.map(s => `${s.Subject.name} - ${s.Center.name} (حصة ${s.lesson_number})`).join('، ') %>
            <% } %>
          </p>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<script>
function openAssignment(event, assignmentId) {
  if (event.target.closest('form, button, a, input, select, textarea')) return;
  window.location.href = `/hw/assignments/${assignmentId}`;
}
</script>

<%- include('partials/footer') %>