<%- include('partials/header') %>

<% function canShow(key) { return userRole === 'admin' || (userPermissions && userPermissions.includes(key)); } %>
<% const DAYS_EN = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']; %>

<style>
  /* Theme-aware layout adjustments for schedule cards */
  .today-session-card {
    background: var(--sf-table-header-bg) !important;
    border: 1px solid var(--sf-input-border);
    border-radius: 10px;
    transition: box-shadow 0.2s ease;
  }
  
  .grid-entry-active {
    background-color: rgba(16, 185, 129, 0.15) !important;
    color: var(--sf-text) !important;
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 6px;
    transition: transform 0.15s ease;
  }
  .grid-entry-active:hover { transform: scale(1.03); }
  
  .grid-entry-inactive {
    background-color: var(--sf-table-header-bg) !important;
    color: var(--sf-muted) !important;
    border: 1px solid var(--sf-input-border);
    border-radius: 6px;
  }

  .table-primary-adaptive {
    background-color: var(--sf-primary) !important;
    color: #ffffff !important;
  }

  [data-theme="dark"] .table-td-today {
    background-color: rgba(99, 102, 241, 0.05) !important;
  }
  [data-theme="light"] .table-td-today {
    background-color: rgba(67, 56, 202, 0.05) !important;
  }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-1">📅 <span class="ar-only">الجدول الأسبوعي</span><span class="en-only" style="display:none;">Weekly Schedule</span></h3>
    <p class="text-muted small mb-0">
      <span class="ar-only">اليوم:</span><span class="en-only" style="display:none;">Today:</span>
      <strong>
        <span class="ar-only"><%= ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'][todayDay] %></span>
        <span class="en-only" style="display:none;"><%= DAYS_EN[todayDay] %></span>
      </strong>
    </p>
  </div>
  <% if (userRole === 'admin') { %>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addEntryModal">+ <span class="ar-only">إضافة حصة للجدول</span><span class="en-only" style="display:none;">Add Session to Schedule</span></button>
  <% } %>
</div>

<!-- حصص اليوم -->
<% if (todayEntries.length > 0) { %>
<div class="card mb-4" style="border-right: 4px solid var(--sf-accent) !important;">
  <div class="card-body">
    <h6 class="mb-3">🔴 <span class="ar-only">حصص اليوم</span><span class="en-only" style="display:none;">Today's Sessions</span></h6>
    <div class="row g-2">
      <% todayEntries && todayEntries.forEach(entry => { %>
        <% if (entry && entry.Subject && entry.Center) { %>
        <div class="col-md-4">
          <div class="p-3 rounded today-session-card">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <strong class="small" style="color: var(--sf-text);"><%= entry.Subject.name %></strong>
              <span class="badge bg-primary"><%= entry.start_time ? entry.start_time.slice(0,5) : 'N/A' %></span>
            </div>
            <p class="small text-muted mb-2"><%= entry.Center.name %> | <%= entry.duration_minutes || 'N/A' %> <span class="ar-only">دقيقة</span><span class="en-only" style="display:none;">min</span></p>
          </div>
        </div>
        <% } %>
      <% }) %>
    </div>
  </div>
</div>
<% } %>

<!-- الجدول الأسبوعي Grid -->
<div class="card mb-4">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-bordered mb-0">
        <thead>
          <tr>
            <% DAYS.forEach((day, i) => { %>
              <th class="text-center small <%= i === todayDay ? 'table-primary-adaptive' : '' %>" style="min-width:120px;">
                <span class="ar-only"><%= day %></span><span class="en-only" style="display:none;"><%= DAYS_EN[i] %></span>
                <% if (i === todayDay) { %><br><span class="badge bg-light text-dark mt-1" style="font-size:0.65rem;"><span class="ar-only">اليوم</span><span class="en-only" style="display:none;">Today</span></span><% } %>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <tr>
            <% for (let i = 0; i < 7; i++) { %>
              <td class="<%= i === todayDay ? 'table-td-today' : '' %>" style="vertical-align:top; padding:8px;">
                <% if (weekGrid[i] && weekGrid[i].length > 0) { %>
                  <% weekGrid[i] && weekGrid[i].forEach(entry => { %>
                    <% if (entry && entry.Subject && entry.Center) { %>
                    <div class="mb-2 p-2 rounded <%= entry.is_active ? 'grid-entry-active' : 'grid-entry-inactive' %>">
                      <div class="small fw-bold"><%= entry.start_time ? entry.start_time.slice(0,5) : 'N/A' %></div>
                      <div class="small fw-semibold"><%= entry.Subject.name %></div>
                      <div class="small opacity-75"><%= entry.Center.name %></div>
                      <% if (entry.end_date && entry.end_date !== 'Invalid Date') { %>
                        <div class="small opacity-75"><span class="ar-only">حتى:</span><span class="en-only" style="display:none;">Until:</span> <%= entry.end_date %></div>
                        <%
                          try {
                            const today = new Date();
                            const end = new Date(entry.end_date);
                            if (end instanceof Date && !isNaN(end)) {
                              const diffDays = Math.ceil((end - today) / (1000*60*60*24));
                              const weeksLeft = Math.ceil(diffDays / 7);
                        %>
                              <% if (entry.expected_sessions_count) { %>
                                <div class="small mt-1 fw-medium" style="color: var(--sf-primary);">
                                  <span class="ar-only">باقي ~<%= weeksLeft %> حصة | تم جدولة: <%= entry.expected_sessions_count %></span>
                                  <span class="en-only" style="display:none;">~<%= weeksLeft %> session(s) remaining | Scheduled: <%= entry.expected_sessions_count %></span>
                                </div>
                              <% } %>
                        <%
                            }
                          } catch(e) {
                            // Invalid date, skip calculation
                          }
                        %>
                      <% } %>
                      <% if (userRole === 'admin') { %>
                        <div class="d-flex gap-1 mt-2">
                          <form action="/schedule/<%= entry.id %>/toggle" method="POST">
                            <button class="btn btn-sm py-1 px-2" style="font-size:0.65rem; background-color: var(--sf-input-border); color: var(--sf-text);">
                              <%= entry.is_active ? 'إيقاف' : 'تفعيل' %>
                            </button>
                          </form>
                          <form action="/schedule/<%= entry.id %>/delete" method="POST" onsubmit="return confirm('حذف؟')">
                            <button class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size:0.65rem;">🗑</button>
                          </form>
                        </div>
                      <% } %>
                    </div>
                    <% } %>
                  <% }) %>
                <% } else { %>
                  <span class="text-muted small">-</span>
                <% } %>
              </td>
            <% } %>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- مودال إضافة حصة -->
<div class="modal fade" id="addEntryModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content card">
      <div class="modal-header border-bottom-0">
        <h5 class="modal-title"><span class="ar-only">إضافة حصة للجدول</span><span class="en-only" style="display:none;">Add Session to Schedule</span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/schedule/add" method="POST">
        <div class="modal-body row g-2">
          <div class="col-6">
            <label class="form-label small"><span class="ar-only">اليوم</span><span class="en-only" style="display:none;">Day</span></label>
            <select name="day_of_week" class="form-select" required>
              <% DAYS.forEach((d, i) => { %><option value="<%= i %>"><span class="ar-only"><%= d %></span><span class="en-only" style="display:none;"><%= DAYS_EN[i] %></span></option><% }) %>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label small"><span class="ar-only">وقت البداية</span><span class="en-only" style="display:none;">Start Time</span></label>
            <input type="time" name="start_time" class="form-control" required>
          </div>
          <div class="col-6">
            <label class="form-label small"><span class="ar-only">المادة</span><span class="en-only" style="display:none;">Subject</span></label>
            <select name="subject_id" class="form-select" required>
              <% if (subjects && subjects.length > 0) { %>
                <% subjects.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
              <% } else { %>
                <option disabled><span class="ar-only">لا توجد مواد متاحة</span><span class="en-only" style="display:none;">No subjects available</span></option>
              <% } %>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label small"><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></label>
            <select name="center_id" class="form-select" required>
              <% if (centers && centers.length > 0) { %>
                <% centers.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
              <% } else { %>
                <option disabled><span class="ar-only">لا توجد سنترات متاحة</span><span class="en-only" style="display:none;">No centers available</span></option>
              <% } %>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label small"><span class="ar-only">المدة (دقيقة)</span><span class="en-only" style="display:none;">Duration (minutes)</span></label>
            <input type="number" name="duration_minutes" class="form-control" value="90" min="30">
          </div>
          <div class="col-6">
            <label class="form-label small"><span class="ar-only">عدد الحصص المتوقعة</span><span class="en-only" style="display:none;">Expected Sessions Count</span></label>
            <input type="number" name="expected_sessions_count" class="form-control" placeholder="مثال: 30">
          </div>
          <div class="col-6">
            <label class="form-label small"><span class="ar-only">تاريخ الانتهاء</span><span class="en-only" style="display:none;">End Date</span></label>
            <input type="date" name="end_date" class="form-control">
          </div>
          <div class="col-12">
            <label class="form-label small"><span class="ar-only">ملاحظات</span><span class="en-only" style="display:none;">Notes</span></label>
            <input type="text" name="notes" class="form-control" placeholder="اختياري">
          </div>
        </div>
        <div class="modal-footer border-top-0">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><span class="ar-only">إلغاء</span><span class="en-only" style="display:none;">Cancel</span></button>
          <button type="submit" class="btn btn-primary"><span class="ar-only">إضافة</span><span class="en-only" style="display:none;">Add</span></button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>