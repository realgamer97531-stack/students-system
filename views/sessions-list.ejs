<%- include('partials/header') %>

<style>
  /* Fix hardcoded color states for Dark/Light adaptive themes */
  [data-theme="dark"] .table-success-adaptive {
    background-color: rgba(16, 185, 129, 0.15) !important;
    color: #10b981 !important;
  }
  [data-theme="light"] .table-success-adaptive {
    background-color: #ecfdf5 !important;
  }

  /* Status Badges adaptive styles */
  .badge-status-cancelled {
    background-color: rgba(239, 68, 68, 0.15) !important; 
    color: #ef4444 !important;
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 8px;
    font-weight: 600;
  }
  .session-serial { font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: 0.3px; }
  .session-num {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 30px; height: 30px; padding: 0 8px; border-radius: 10px;
    background: var(--sf-panel-bg); border: 1px solid var(--sf-input-border);
    font-weight: 800; font-variant-numeric: tabular-nums;
  }
  .sessions-table-card td { white-space: nowrap; }
  .badge-status-active {
    background-color: rgba(16, 185, 129, 0.15) !important;
    color: #10b981 !important;
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 8px;
    font-weight: 600;
  }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-1">
      <span class="ar-only">🗂️ كل الحصص</span>
      <span class="en-only" style="display:none;">🗂️ All Sessions</span>
    </h3>
    <p class="text-muted small mb-0">
      <span class="ar-only">إدارة ومتابعة كل حصص السناتر والأونلاين</span>
      <span class="en-only" style="display:none;">Manage all center and online sessions</span>
    </p>
  </div>
  <a href="/sessions/new" class="btn btn-primary">
    <span class="ar-only">+ بدء حصة جديدة</span>
    <span class="en-only" style="display:none;">+ New Session</span>
  </a>
</div>

<form method="GET" action="/sessions" class="card p-3 mb-3">
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <label for="centerFilter" class="form-label mb-1">
        <span class="ar-only">السنتر</span>
        <span class="en-only" style="display:none;">Center</span>
      </label>
      <select id="centerFilter" name="center_id" class="form-select">
        <option value="">كل السناتر</option>
        <% centers.forEach(center => { %>
          <option value="<%= center.id %>" <%- sf.colorAttr('center', center) %> <%= String(selectedCenterId) === String(center.id) ? 'selected' : '' %>>
            <%= center.name %>
          </option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4">
      <label for="subjectFilter" class="form-label mb-1">
        <span class="ar-only">المادة</span>
        <span class="en-only" style="display:none;">Subject</span>
      </label>
      <select id="subjectFilter" name="subject_id" class="form-select">
        <option value="">كل المواد</option>
        <% subjects.forEach(subject => { %>
          <option value="<%= subject.id %>" <%- sf.colorAttr('subject', subject) %> <%= String(selectedSubjectId) === String(subject.id) ? 'selected' : '' %>>
            <%= subject.name %>
          </option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4 d-flex gap-2">
      <button type="submit" class="btn btn-primary flex-grow-1">
        <span class="ar-only">تصفية</span>
        <span class="en-only" style="display:none;">Filter</span>
      </button>
      <a href="/sessions" class="btn btn-outline-secondary">
        <span class="ar-only">مسح</span>
        <span class="en-only" style="display:none;">Clear</span>
      </a>
    </div>
  </div>
</form>

<div class="table-responsive card sessions-table-card">
  <table class="table align-middle mb-0 sf-collapsible" data-sf-table="sessions">
    <thead>
      <tr>
        <th><span class="ar-only">السيريال</span><span class="en-only" style="display:none;">Serial</span></th>
        <th><span class="ar-only">المادة</span><span class="en-only" style="display:none;">Subject</span></th>
        <th><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></th>
        <th class="text-center"><span class="ar-only">الرقم النسبي</span><span class="en-only" style="display:none;">Lesson #</span></th>
        <th class="text-center sf-x"><span class="ar-only">الأسبوع</span><span class="en-only" style="display:none;">Week</span></th>
        <th><span class="ar-only">التاريخ</span><span class="en-only" style="display:none;">Date</span></th>
        <th class="sf-x"><span class="ar-only">الحالة</span><span class="en-only" style="display:none;">Status</span></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!sessions.length) { %>
        <tr><td colspan="8" class="text-center text-muted py-5">
          <span class="ar-only">مفيش حصص بالفلتر ده</span><span class="en-only" style="display:none;">No sessions match this filter</span>
        </td></tr>
      <% } %>
      <% sessions.forEach(s => { %>
        <% const isRunning = String(s.id) === String(activeSessionId); %>
        <tr class="<%= isRunning ? 'table-success-adaptive' : '' %>">
          <td><span class="session-serial"><%= s.serial_number %></span><% if (s.status === 'cancelled') { %> <span class="badge badge-status-cancelled sf-x-hint" title="ملغية / Cancelled">⛔</span><% } %></td>
          <td><%- sf.subject(s.Subject, 'N/A') %></td>
          <td><%- sf.center(s.Center, 'N/A') %></td>
          <td class="text-center"><span class="session-num"><%= s.lesson_number %></span></td>
          <td class="text-center sf-x"><%= s.week_number ?? '—' %></td>
          <td class="text-nowrap"><%= s.session_date %></td>
          <td class="sf-x">
            <% if (s.status === 'cancelled') { %>
              <span class="badge badge-status-cancelled">
                <span class="ar-only">⛔ ملغية</span>
                <span class="en-only" style="display:none;">⛔ Cancelled</span>
              </span>
            <% } else { %>
              <span class="badge badge-status-active">
                <span class="ar-only">✓ عادية</span>
                <span class="en-only" style="display:none;">✓ Active</span>
              </span>
            <% } %>
          </td>
          <td>
            <div class="sf-actions">
              <% if (isRunning) { %>
                <span class="badge bg-primary">
                  <span class="ar-only">✓ الشغالة دلوقتي</span>
                  <span class="en-only" style="display:none;">✓ Running</span>
                </span>
              <% } else { %>
                <form action="/sessions/<%= s.id %>/activate" method="POST">
                  <button type="submit" class="btn btn-sm btn-outline-primary">
                    <span class="ar-only">تفعيل</span>
                    <span class="en-only" style="display:none;">Activate</span>
                  </button>
                </form>
              <% } %>
              <a href="/sessions/<%= s.id %>/report" class="btn btn-sm btn-outline-secondary">
                <span class="ar-only">📊 تقرير</span>
                <span class="en-only" style="display:none;">📊 Report</span>
              </a>

              <% if (userRole === 'admin') { %>
                <div class="dropdown">
                  <button type="button" class="btn btn-sm btn-outline-secondary sf-icon-btn" data-bs-toggle="dropdown"
                    data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" title="المزيد / More">
                    <i class="bi bi-three-dots-vertical"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                      <button type="button" class="dropdown-item"
                        onclick="openEditModal(<%= s.id %>, '<%= s.session_date %>', <%= s.lesson_number %>)">
                        ✏️ <span class="ar-only">تعديل</span><span class="en-only" style="display:none;">Edit</span>
                      </button>
                    </li>
                    <li>
                      <button type="button" class="dropdown-item"
                        onclick="openWeekEditModal(<%= s.id %>, <%= s.week_number == null ? 'null' : s.week_number %>)">
                        📅 <span class="ar-only">تعديل الأسبوع</span><span class="en-only" style="display:none;">Edit Week</span>
                      </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <% if (s.status === 'cancelled') { %>
                      <li>
                        <form action="/sessions/<%= s.id %>/restore" method="POST">
                          <button type="submit" class="dropdown-item text-success">
                            ↩️ <span class="ar-only">إلغاء الإلغاء</span><span class="en-only" style="display:none;">Restore</span>
                          </button>
                        </form>
                      </li>
                    <% } else { %>
                      <li>
                        <button type="button" class="dropdown-item text-danger"
                          onclick="openCancelModal(<%= s.id %>, '<%= s.lesson_number %>', '<%= s.Subject ? s.Subject.name : "N/A" %>')">
                          🚫 <span class="ar-only">إلغاء الحصة</span><span class="en-only" style="display:none;">Cancel</span>
                        </button>
                      </li>
                    <% } %>
                    <li>
                      <form action="/sessions/<%= s.id %>/delete" method="POST"
                        onsubmit="return confirmSessionDelete(this, '<%= s.Center ? s.Center.name : "N/A" %>')">
                        <button type="submit" class="dropdown-item text-danger">
                          🗑️ <span class="ar-only">حذف</span><span class="en-only" style="display:none;">Delete</span>
                        </button>
                      </form>
                    </li>
                  </ul>
                </div>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="modal fade" id="cancelModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content card">
      <div class="modal-header border-bottom-0">
        <h5 class="modal-title">إلغاء حصة</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="cancelForm" method="POST">
        <div class="modal-body">
          <p>هتلغي حصة رقم <strong id="cancelLessonNumber"></strong> من مادة <strong id="cancelSubjectName"></strong></p>
          <div class="form-check mb-2">
            <input class="form-check-input" type="radio" name="scope" value="single" id="scopeSingle" checked>
            <label class="form-check-label" for="scopeSingle">
              إلغاء من هذا السنتر بس (اللي اخترته)
            </label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="scope" value="all" id="scopeAll">
            <label class="form-check-label" for="scopeAll">
              إلغاء من <strong>كل السناتر</strong> (نفس رقم الحصة في كل مكان)
            </label>
          </div>
        </div>
        <div class="modal-footer border-top-0">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">رجوع</button>
          <button type="submit" class="btn btn-danger">تأكيد الإلغاء</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content card">
      <div class="modal-header border-bottom-0">
        <h5 class="modal-title">تعديل الحصة</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editForm" method="POST">
        <div class="modal-body">
          <label class="form-label">التاريخ الصحيح</label>
          <input type="date" name="session_date" id="editDateInput" class="form-control" required>
          <label class="form-label mt-3">الرقم النسبي</label>
          <input type="number" name="lesson_number" id="editLessonInput" class="form-control" min="1" step="1" required>
          <div class="form-text">تغيير الرقم النسبي بيغيّر السيريال كمان (أساس السيريال + الرقم النسبي).</div>
        </div>
        <div class="modal-footer border-top-0">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">رجوع</button>
          <button type="submit" class="btn btn-primary">حفظ</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="weekEditModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content card">
      <div class="modal-header border-bottom-0">
        <h5 class="modal-title">تعديل الأسبوع</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="weekEditForm" method="POST">
        <div class="modal-body">
          <label class="form-label">اختر الأسبوع</label>
          <select name="week_number" id="weekEditInput" class="form-select">
            <option value="">لا يوجد أسبوع</option>
            <option value="1">الأسبوع 1</option>
            <option value="2">الأسبوع 2</option>
            <option value="3">الأسبوع 3</option>
            <option value="4">الأسبوع 4</option>
            <option value="5">الأسبوع 5</option>
            <option value="6">الأسبوع 6</option>
            <option value="7">الأسبوع 7</option>
            <option value="8">الأسبوع 8</option>
            <option value="9">الأسبوع 9</option>
            <option value="10">الأسبوع 10</option>
          </select>
        </div>
        <div class="modal-footer border-top-0">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">رجوع</button>
          <button type="submit" class="btn btn-primary">حفظ</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openCancelModal(sessionId, lessonNumber, subjectName) {
    document.getElementById('cancelLessonNumber').textContent = lessonNumber;
    document.getElementById('cancelSubjectName').textContent = subjectName;
    document.getElementById('cancelForm').action = `/sessions/${sessionId}/cancel`;
    const modal = new bootstrap.Modal(document.getElementById('cancelModal'));
    modal.show();
  }

  function openEditModal(sessionId, currentDate, currentLesson) {
    document.getElementById('editDateInput').value = currentDate;
    document.getElementById('editLessonInput').value = currentLesson;
    document.getElementById('editForm').action = `/sessions/${sessionId}/edit`;
    const modal = new bootstrap.Modal(document.getElementById('editModal'));
    modal.show();
  }

  function openWeekEditModal(sessionId, currentWeek) {
    const select = document.getElementById('weekEditInput');
    select.value = currentWeek == null ? '' : String(currentWeek);
    document.getElementById('weekEditForm').action = `/sessions/${sessionId}/update-week`;
    const modal = new bootstrap.Modal(document.getElementById('weekEditModal'));
    modal.show();
  }

  function confirmSessionDelete(form, centerName) {
    if (!confirm('متأكد من حذف الحصة دي بالكامل؟ ده غير قابل للتراجع.')) return false;
    if (centerName !== 'أونلاين') {
      const password = prompt('هذه الحصة ليست أونلاين. ادخل كلمة المرور الإدارية للتأكيد:');
      if (!password || !password.trim()) {
        alert('لم تُدخل كلمة المرور الإدارية. تم إلغاء الحذف.');
        return false;
      }
      let hidden = form.querySelector('input[name="admin_password"]');
      if (!hidden) {
        hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'admin_password';
        form.appendChild(hidden);
      }
      hidden.value = password.trim();
    }
    return true;
  }
</script>

<%- include('partials/footer') %>