<%- include('partials/header') %>

<h3 class="mb-2">🎬 <%= video.title %></h3>
<p class="text-muted mb-4">
  <%- sf.session(video.Session) %>
</p>
<div class="mb-4"><a href="/admin/popup-questions/video/<%= video.id %>" class="btn btn-outline-primary">❓ الأسئلة المنبثقة للدرس (Popup)</a></div>

<div class="card shadow-sm mb-4" id="questionsPlacement">
  <div class="card-body">
    <h6 class="mb-1">📍 مكان ظهور فيديو الأسئلة للطالب</h6>
    <p class="text-muted small mb-3">بتحدد هنا الطالب هيشوف فيديو "الأسئلة" (اللي بتضيفه تحت في كارت ❓ فيديو الأسئلة) فين. نفس صلاحية الوصول للحصة بتتطبق في كل الحالات.</p>
    <form action="/admin/videos/<%= video.id %>/questions-display" method="POST">
      <% const placementOptions = [
        ['inside', 'جوه صفحة الدرس بس', 'تبويب "❓ الأسئلة" جوه صفحة مشاهدة الدرس. مفيش كارت منفصل في صفحة الدروس.'],
        ['outside', 'برا جنب الحصة بس', 'كارت "❓ الأسئلة" منفصل في صفحة الدروس جنب كارت الحصة، ومفيش تبويب جوه الدرس.'],
        ['both', 'الاتنين مع بعض', 'الكارت المنفصل في صفحة الدروس + التبويب جوه صفحة الدرس.']
      ]; %>
      <% placementOptions.forEach(([value, title, desc]) => { %>
        <label class="d-flex gap-2 align-items-start p-2 mb-2 rounded border" style="cursor:pointer;">
          <input type="radio" name="questions_display" value="<%= value %>" class="form-check-input mt-1" <%= (video.questions_display || 'inside') === value ? 'checked' : '' %>>
          <span><strong><%= title %></strong><br><span class="small text-muted"><%= desc %></span></span>
        </label>
      <% }) %>
      <button type="submit" class="btn btn-primary btn-sm">💾 حفظ مكان الظهور</button>
    </form>
  </div>
</div>

<%
  const nextOrderByCategory = {};
  ['explanation', 'questions', 'homework_solution'].forEach(cat => {
    const orders = videoParts.filter(p => p.category === cat).map(p => Number(p.order_index) || 0);
    nextOrderByCategory[cat] = (orders.length ? Math.max(...orders) : 0) + 1;
  });
%>
<style>
  .bulk-links textarea { font-family: ui-monospace, Consolas, monospace; font-size: 0.85rem; direction: ltr; text-align: left; min-height: 120px; }
  .bulk-preview { display: flex; flex-direction: column; gap: 4px; max-height: 260px; overflow-y: auto; }
  .bulk-preview .row-ok, .bulk-preview .row-bad {
    display: flex; gap: 8px; align-items: center; padding: 4px 10px; border-radius: 10px; font-size: 0.8rem;
    background: var(--sf-panel-bg); border: 1px solid var(--sf-input-border); min-width: 0;
  }
  .bulk-preview .row-bad { background: var(--sf-danger-soft-bg); color: var(--sf-danger-soft-text); }
  .bulk-preview .num { font-weight: 800; white-space: nowrap; }
  .bulk-preview .url { direction: ltr; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; }
  .bulk-preview .dur { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--sf-muted); }
</style>
<div class="card shadow-sm mb-4 bulk-links" id="addParts">
  <div class="card-body">
    <h6 class="mb-1"><span class="ar-only">➕ إضافة فيديوهات للدرس (كذا لينك مرة واحدة)</span><span class="en-only" style="display:none;">➕ Add videos to this lesson (many links at once)</span></h6>
    <p class="small text-muted mb-3">
      <span class="ar-only">حط كل لينك في سطر بالترتيب. لو عايز مدة لكل لينك اكتبها بعده في نفس السطر (مثال: <code dir="ltr">https://... 25:30</code> أو <code dir="ltr">1:05:00</code>)، ولو مكتبتش هتاخد المدة اللي تحت.</span>
      <span class="en-only" style="display:none;">One link per line, in order. To give each link its own duration put it after the link on the same line (e.g. <code>https://... 25:30</code> or <code>1:05:00</code>); otherwise the duration below is used.</span>
    </p>
    <% if (typeof partsMessage !== 'undefined' && partsMessage) { %>
      <div class="alert alert-success py-2"><%= partsMessage %></div>
    <% } %>
    <form id="bulkPartsForm" class="row g-3" onsubmit="return submitBulkParts(event)">
      <div class="col-md-4">
        <label class="form-label small mb-1"><span class="ar-only">النوع</span><span class="en-only" style="display:none;">Type</span></label>
        <select id="bulkCategory" class="form-select">
          <option value="explanation"><span class="ar-only">📖 فيديو الشرح</span><span class="en-only" style="display:none;">📖 Explanation</span></option>
          <option value="questions"><span class="ar-only">❓ فيديو الأسئلة</span><span class="en-only" style="display:none;">❓ Questions</span></option>
          <option value="homework_solution"><span class="ar-only">✅ فيديو حل الواجب</span><span class="en-only" style="display:none;">✅ Homework solution</span></option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-1"><span class="ar-only">يبدأ من جزء رقم</span><span class="en-only" style="display:none;">Start at part #</span></label>
        <input type="number" id="bulkStart" class="form-control" min="1">
      </div>
      <div class="col-md-5">
        <label class="form-label small mb-1"><span class="ar-only">المدة لأي لينك من غير مدة</span><span class="en-only" style="display:none;">Duration for links without one</span></label>
        <div class="d-flex gap-1 align-items-center">
          <input type="number" id="durHours" class="form-control" placeholder="ساعة" min="0" value="0" style="width:72px;" title="ساعة">
          <span>:</span>
          <input type="number" id="durMinutes" class="form-control" placeholder="دقيقة" min="0" max="59" value="0" style="width:72px;" title="دقيقة">
          <span>:</span>
          <input type="number" id="durSeconds" class="form-control" placeholder="ثانية" min="0" max="59" value="0" style="width:72px;" title="ثانية">
        </div>
      </div>
      <div class="col-12">
        <textarea id="bulkLinks" class="form-control" rows="5" placeholder="https://youtu.be/xxxx 25:30&#10;https://vimeo.com/yyyy&#10;https://drive.google.com/... 1:02:10"></textarea>
      </div>
      <div class="col-12">
        <div id="bulkPreview" class="bulk-preview"></div>
      </div>
      <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
        <button type="submit" id="bulkSubmit" class="btn btn-success" disabled>
          <span class="ar-only">💾 احفظ كل اللينكات</span><span class="en-only" style="display:none;">💾 Save all links</span>
        </button>
        <span id="bulkStatus" class="small"></span>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    const NEXT_ORDER = <%- JSON.stringify(nextOrderByCategory) %>;
    const form = document.getElementById('bulkPartsForm');
    const category = document.getElementById('bulkCategory');
    const start = document.getElementById('bulkStart');
    const links = document.getElementById('bulkLinks');
    const preview = document.getElementById('bulkPreview');
    const submit = document.getElementById('bulkSubmit');
    const status = document.getElementById('bulkStatus');
    const en = (localStorage.getItem('language') || 'ar') === 'en';
    let startTouched = false;

    function esc(v) { const d = document.createElement('div'); d.textContent = v; return d.innerHTML; }
    function fmt(sec) {
      const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60;
      return (h ? h + ':' + String(m).padStart(2, '0') : String(m)) + ':' + String(s).padStart(2, '0');
    }
    // "25:30" / "1:05:00" / "25" (دقايق)
    function parseDuration(text) {
      if (!text) return null;
      const parts = text.split(':').map(x => x.trim());
      if (parts.some(x => !/^\d+$/.test(x))) return NaN;
      const n = parts.map(Number);
      if (n.length === 1) return n[0] * 60;
      if (n.length === 2) return n[0] * 60 + n[1];
      if (n.length === 3) return n[0] * 3600 + n[1] * 60 + n[2];
      return NaN;
    }
    function defaultDuration() {
      const h = parseInt(document.getElementById('durHours').value, 10) || 0;
      const m = parseInt(document.getElementById('durMinutes').value, 10) || 0;
      const s = parseInt(document.getElementById('durSeconds').value, 10) || 0;
      return h * 3600 + m * 60 + s;
    }
    function parseLines() {
      const fallback = defaultDuration();
      return links.value.split(/\r?\n/).map(line => line.trim()).filter(Boolean).map(line => {
        const bits = line.split(/[\s|]+/).filter(Boolean);
        const url = bits[0] || '';
        const own = parseDuration(bits.slice(1).join(''));
        let error = '';
        if (!/^https?:\/\/\S+$/i.test(url)) error = en ? 'not a link' : 'ده مش لينك';
        else if (url.length > 255) error = en ? 'link too long' : 'اللينك طويل جدًا';
        else if (Number.isNaN(own)) error = en ? 'bad duration' : 'المدة مش مظبوطة';
        const duration = own == null ? fallback : own;
        if (!error && !(duration > 0)) error = en ? 'needs a duration' : 'محتاج مدة';
        return { url, duration, error };
      });
    }
    function render() {
      if (!startTouched) start.value = NEXT_ORDER[category.value] || 1;
      const rows = parseLines();
      const first = parseInt(start.value, 10) || 1;
      preview.innerHTML = rows.map((row, i) => `<div class="${row.error ? 'row-bad' : 'row-ok'}">
          <span class="num">${en ? 'Part' : 'جزء'} ${first + i}</span>
          <span class="url">${esc(row.url)}</span>
          <span class="dur">${row.error ? '⚠️ ' + esc(row.error) : '⏱ ' + fmt(row.duration)}</span>
        </div>`).join('');
      const bad = rows.filter(row => row.error).length;
      submit.disabled = !rows.length || bad > 0;
      status.className = 'small ' + (bad ? 'text-danger' : 'text-muted');
      status.textContent = !rows.length ? '' : bad
        ? (en ? `${bad} line(s) need fixing` : `${bad} سطر محتاج يتصلح`)
        : (en ? `${rows.length} video(s) ready` : `${rows.length} فيديو جاهز للحفظ`);
    }
    window.submitBulkParts = async function (event) {
      event.preventDefault();
      const rows = parseLines();
      if (!rows.length || rows.some(row => row.error)) return false;
      submit.disabled = true;
      status.className = 'small text-muted';
      status.textContent = en ? 'Saving…' : 'بيحفظ...';
      try {
        const response = await fetch('/admin/videos/<%= video.id %>/add-parts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            category: category.value,
            start_order: parseInt(start.value, 10) || null,
            parts: rows.map(row => ({ url: row.url, duration_seconds: row.duration })),
          }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) throw new Error(data.message || ('HTTP ' + response.status));
        // تحميل واحد بس في الآخر عشان القايمة تحت تتحدث
        location.href = '/admin/videos/<%= video.id %>?parts_msg=' + encodeURIComponent(data.message) + '#cat-' + category.value;
      } catch (error) {
        status.className = 'small text-danger';
        status.textContent = error.message;
        submit.disabled = false;
      }
      return false;
    };
    category.addEventListener('change', () => { startTouched = false; render(); });
    start.addEventListener('input', () => { startTouched = true; render(); });
    links.addEventListener('input', render);
    ['durHours', 'durMinutes', 'durSeconds'].forEach(id => document.getElementById(id).addEventListener('input', render));
    render();
  })();
</script>

<% ['explanation', 'questions', 'homework_solution'].forEach(cat => { %>
  <% const labels = { explanation: '📖 فيديو الشرح', questions: '❓ فيديو الأسئلة', homework_solution: '✅ فيديو حل الواجب' }; %>
  <% const labelsEn = { explanation: 'Explanation Video', questions: 'Questions Video', homework_solution: 'Homework Solution Video' }; %>
  <div class="card shadow-sm mb-3" id="cat-<%= cat %>">
    <div class="card-body">
      <h6 class="mb-3"><span class="ar-only"><%= labels[cat] %></span><span class="en-only" style="display:none;"><%= labelsEn[cat] %></span></h6>
      <% const parts = videoParts.filter(p => p.category === cat); %>
      <% if (parts.length === 0) { %>
        <p class="text-muted small"><span class="ar-only">لا يوجد فيديو من هذا النوع حتى الآن</span><span class="en-only" style="display:none;">No video of this type yet</span></p>
      <% } %>
      <% if (parts.length > 0) { %>
      <table class="table table-sm">
        <tbody>
          <% parts.forEach(p => { %>
            <% const h = Math.floor(p.duration_seconds / 3600); %>
            <% const m = Math.floor((p.duration_seconds % 3600) / 60); %>
            <% const s = p.duration_seconds % 60; %>
            <tr>
              <td><span class="ar-only">الجزء</span><span class="en-only" style="display:none;">Part</span> <%= p.order_index %></td>
              <td class="small">
                <% if (p.source_type === 'link') { %>
                  <a href="<%= p.video_url %>" target="_blank" class="text-decoration-none">🔗 <span class="ar-only">لينك خارجي</span><span class="en-only" style="display:none;">External Link</span></a>
                <% } else { %>📁 <span class="ar-only">ملف مرفوع</span><span class="en-only" style="display:none;">Uploaded File</span><% } %>
              </td>
              <td>
                <%= h > 0 ? String(h).padStart(2, '0') + ':' : '' %><%= String(m).padStart(2, '0') %>:<%= String(s).padStart(2, '0') %>
              </td>
              <td class="d-flex gap-1">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="toggleEditRow('<%= p.id %>')"><span class="ar-only">تعديل</span><span class="en-only" style="display:none;">Edit</span></button>
                <form action="/admin/videos/part/<%= p.id %>/delete" method="POST" onsubmit="return confirm('متأكد من الحذف؟')">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><span class="ar-only">حذف</span><span class="en-only" style="display:none;">Delete</span></button>
                </form>
              </td>
            </tr>
            <tr id="editRow<%= p.id %>" style="display:none;">
              <td colspan="4">
                <form action="/admin/videos/part/<%= p.id %>/update" method="POST" class="row g-2 align-items-end" onsubmit="return combineEditDuration('<%= p.id %>')">
                  <input type="hidden" name="category" value="<%= p.category %>">
                  <div class="col-md-2">
                    <label class="form-label small text-muted mb-1 d-block"><span class="ar-only">الترتيب</span><span class="en-only" style="display:none;">Order</span></label>
                    <input type="number" name="order_index" class="form-control" value="<%= p.order_index %>" min="1" required>
                  </div>
                  <div class="col-md-5" id="editLinkBox<%= p.id %>">
                    <label class="form-label small text-muted mb-1 d-block"><span class="ar-only">لينك الفيديو</span><span class="en-only" style="display:none;">Video Link</span></label>
                    <input type="text" name="video_url" class="form-control" placeholder="لينك الفيديو" value="<%= p.source_type === 'link' ? p.video_url : '' %>" <%= p.source_type === 'upload' ? '' : 'required' %>>
                    <% if (p.source_type === 'upload') { %><p class="small text-muted mb-0 mt-1"><span class="ar-only">ده ملف مرفوع قديم — حط لينك بداله</span><span class="en-only" style="display:none;">Old uploaded file — replace it with a link</span></p><% } %>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small text-muted mb-1 d-block"><span class="ar-only">مدة الفيديو</span><span class="en-only" style="display:none;">Video Duration</span></label>
                    <div class="d-flex gap-1">
                      <input type="number" id="editDurHours<%= p.id %>" class="form-control" placeholder="ساعة" min="0" value="<%= h %>" style="width:70px;">
                      <input type="number" id="editDurMinutes<%= p.id %>" class="form-control" placeholder="دقيقة" min="0" max="59" value="<%= m %>" style="width:70px;">
                      <input type="number" id="editDurSeconds<%= p.id %>" class="form-control" placeholder="ثانية" min="0" max="59" value="<%= s %>" style="width:70px;">
                    </div>
                    <input type="hidden" name="duration_seconds" id="editDurationSecondsHidden<%= p.id %>" required>
                  </div>
                  <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary"><span class="ar-only">حفظ</span><span class="en-only" style="display:none;">Save</span></button>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="toggleEditRow('<%= p.id %>')"><span class="ar-only">إلغاء</span><span class="en-only" style="display:none;">Cancel</span></button>
                  </div>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
<% }) %>

<div class="card shadow-sm mb-3">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <h6 class="mb-1">🔐 <span class="ar-only">إدارة وصول المشاهدة</span><span class="en-only" style="display:none;">Manage Viewing Access</span></h6>
      <p class="text-muted small mb-0"><span class="ar-only">نقل التحكم في الحصص والطلاب المسموح لهم إلى صفحة مخصصة.</span><span class="en-only" style="display:none;">Control over allowed sessions and students has been moved to a dedicated page.</span></p>
    </div>
    <a href="/admin/videos/<%= video.id %>/access" class="btn btn-primary"><span class="ar-only">الذهاب إلى صفحة الوصول</span><span class="en-only" style="display:none;">Go to Access Page</span></a>
  </div>
</div>

<div class="card shadow-sm mb-3">
  <div class="card-body">
    <h6 class="mb-3">🏫 <span class="ar-only">الحصص المسموح لها بمشاهدة هذا الفيديو</span><span class="en-only" style="display:none;">Sessions Allowed to Watch This Video</span></h6>

    <div class="d-flex flex-wrap gap-2 mb-3">
      <% if (videoSessions.length === 0) { %>
        <span class="text-muted small"><span class="ar-only">لا توجد حصص مرتبطة (الفيديو مرئي للجميع!)</span><span class="en-only" style="display:none;">No linked sessions (the video is visible to everyone!)</span></span>
      <% } %>
      <% videoSessions.forEach(vs => { %>
        <div class="d-flex align-items-center gap-1">
          <%- sf.session(vs.Session) %>
          <form action="/admin/videos/<%= video.id %>/remove-session/<%= vs.SessionId %>" method="POST">
            <button class="btn btn-sm" style="padding:1px 6px;background:var(--sf-danger-soft-bg);color:var(--sf-danger-soft-text);font-size:0.65rem;">✕</button>
          </form>
        </div>
      <% }) %>
    </div>

    <form action="/admin/videos/<%= video.id %>/add-session" method="POST" class="d-flex gap-2">
      <select name="session_id" class="form-select session-select" placeholder="إضافة حصة جديدة" required>
        <option value=""><span class="ar-only">-- إضافة حصة جديدة --</span><span class="en-only" style="display:none;">-- Add New Session --</span></option>
        <% allSessions.forEach(s => { %>
          <% const alreadyAdded = videoSessions.some(vs => vs.SessionId === s.id); %>
          <% if (!alreadyAdded) { %>
            <option value="<%= s.id %>" <%- sf.sessionOption(s) %>><%= sf.sessionText(s) %></option>
          <% } %>
        <% }) %>
      </select>
      <button class="btn btn-sm btn-primary">+ <span class="ar-only">إضافة</span><span class="en-only" style="display:none;">Add</span></button>
    </form>
  </div>
</div>

<div class="card shadow-sm mb-3">
  <div class="card-body">
    <h6 class="mb-3" id="students">👤 <span class="ar-only">وصول فردي لطلاب بعينهم (خارج المجموعات المسموح بها)</span><span class="en-only" style="display:none;">Individual Access for Specific Students (Outside Allowed Groups)</span></h6>
    <% if (typeof accessMessage !== 'undefined' && accessMessage) { %>
      <div class="alert <%= /^❌/.test(accessMessage) ? 'alert-danger' : 'alert-success' %> py-2"><%= accessMessage %></div>
    <% } %>
    <p class="small text-muted mb-2"><span class="ar-only">لشيل الفيديو من طالب في مجموعة الحصة نفسها استخدم صفحة "التحكم".</span><span class="en-only" style="display:none;">To remove the video from a student in the session's own group, use the "Control" page.</span> <a href="/admin/videos/<%= video.id %>/access#students">🔐 <span class="ar-only">التحكم</span><span class="en-only" style="display:none;">Control</span></a></p>

    <% if (studentAccesses.length === 0) { %>
      <p class="text-muted small mb-3"><span class="ar-only">لا يوجد طلاب بوصول فردي</span><span class="en-only" style="display:none;">No students with individual access</span></p>
    <% } else { %>
      <div class="table-responsive mb-3">
        <table class="table table-sm align-middle">
          <thead class="table-light">
            <tr>
              <th><span class="ar-only">الكود</span><span class="en-only" style="display:none;">Code</span></th>
              <th><span class="ar-only">الاسم</span><span class="en-only" style="display:none;">Name</span></th>
              <th><span class="ar-only">الفرقة / السنتر</span><span class="en-only" style="display:none;">Group / Center</span></th>
              <th><span class="ar-only">إجراء</span><span class="en-only" style="display:none;">Action</span></th>
            </tr>
          </thead>
          <tbody>
            <% studentAccesses.forEach(sa => { %>
              <tr>
                <td><%= sa.Student?.student_code %></td>
                <td><%= sa.Student?.name %></td>
                <td><span class="sf-chip-row"><%- sf.subject(sa.Student?.Subject) %><%- sf.center(sa.Student?.Center) %></span></td>
                <td>
                  <form action="/admin/videos/<%= video.id %>/remove-student-access/<%= sa.id %>" method="POST">
                    <button class="btn btn-sm btn-outline-danger"><span class="ar-only">إلغاء الوصول</span><span class="en-only" style="display:none;">Revoke Access</span></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <form action="/admin/videos/<%= video.id %>/add-student-access" method="POST" class="d-flex flex-wrap gap-2 align-items-center">
      <input type="text" name="student_code" class="form-control form-control-sm" style="max-width:220px;"
        placeholder="كود الطالب (مثال: 15 أو STU-00015)" required>
      <button class="btn btn-sm btn-success">+ <span class="ar-only">إضافة طالب للفيديو</span><span class="en-only" style="display:none;">Add student to video</span></button>
      <span class="small text-muted"><span class="ar-only">أي طالب، حتى لو من مجموعة تانية — بيفتحله الفيديو ببلاش</span><span class="en-only" style="display:none;">Any student, even from another group — opens for free</span></span>
    </form>
  </div>
</div>

<script>
  function combineDuration() {
    const h = parseInt(document.getElementById('durHours').value, 10) || 0;
    const m = parseInt(document.getElementById('durMinutes').value, 10) || 0;
    const s = parseInt(document.getElementById('durSeconds').value, 10) || 0;
    const total = (h * 3600) + (m * 60) + s;
    if (total <= 0) {
      alert('من فضلك حدد مدة الفيديو');
      return false;
    }
    document.getElementById('durationSecondsHidden').value = total;
    return true;
  }

  function toggleEditRow(partId) {
    const row = document.getElementById('editRow' + partId);
    row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
  }

  function combineEditDuration(partId) {
    const h = parseInt(document.getElementById('editDurHours' + partId).value, 10) || 0;
    const m = parseInt(document.getElementById('editDurMinutes' + partId).value, 10) || 0;
    const s = parseInt(document.getElementById('editDurSeconds' + partId).value, 10) || 0;
    const total = (h * 3600) + (m * 60) + s;
    if (total <= 0) {
      alert('من فضلك حدد مدة الفيديو');
      return false;
    }
    document.getElementById('editDurationSecondsHidden' + partId).value = total;
    return true;
  }
</script>

