<%- include('partials/header') %>
  <div class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
      <div class="card-body p-4">
        <h3 class="mb-4 text-center"><span class="ar-only">بدء حصة</span><span class="en-only" style="display:none;">Start Session</span></h3>

        <% if (typeof duplicate !== 'undefined' && duplicate) { %>
        <div class="alert alert-warning">
          <div class="fw-bold mb-1">⚠️ الحصة دي موجودة بالفعل — مينفعش تتعمل مرتين</div>
          <div class="mb-2"><%= describeSession(duplicate) %></div>
          <form action="/sessions/<%= duplicate.id %>/activate" method="POST" class="d-inline">
            <button class="btn btn-warning btn-sm fw-bold">✅ فعّل الحصة الموجودة</button>
          </form>
        </div>
        <% } %>

        <form action="/sessions" method="POST" id="startSessionForm">
          <div class="mb-3">
            <label class="form-label"><span class="ar-only">المادة</span><span class="en-only" style="display:none;">Subject</span></label>
            <select name="subject_id" class="form-select" required>
              <option value=""><span class="ar-only">-- اختر المادة --</span><span class="en-only" style="display:none;">-- Choose Subject --</span></option>
              <% subjects.forEach(subj => { %>
                <option value="<%= subj.id %>"><%= subj.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label"><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></label>
            <select name="center_id" class="form-select" required>
              <option value=""><span class="ar-only">-- اختر السنتر --</span><span class="en-only" style="display:none;">-- Choose Center --</span></option>
              <% centers.forEach(center => { %>
                <option value="<%= center.id %>"><%= center.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label"><span class="ar-only">نوع الحصة</span><span class="en-only" style="display:none;">Session Type</span></label>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="mode" id="modeNew" value="new" checked>
              <label class="form-check-label" for="modeNew">
                <span class="ar-only">الحصة الجاية تلقائي (بعد آخر حصة لنفس السنتر والمادة — من غير ما تكتب رقم)</span>
                <span class="en-only" style="display:none;">Next session automatically (after the last one for this center and subject)</span>
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="mode" id="modeRepeat" value="repeat">
              <label class="form-check-label" for="modeRepeat">
                <span class="ar-only">تكرار حصة سابقة في سنتر تاني (أنا أحدد رقمها)</span>
                <span class="en-only" style="display:none;">Repeat a previous session in another center (I specify its number)</span>
              </label>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label"><span class="ar-only">رقم الأسبوع</span><span class="en-only" style="display:none;">Week Number</span></label>
            <select name="week_number" class="form-select">
              <option value=""><span class="ar-only">-- اختر الأسبوع (اختياري) --</span><span class="en-only" style="display:none;">-- Choose Week (optional) --</span></option>
              <option value="1"><span class="ar-only">الأسبوع 1</span><span class="en-only" style="display:none;">Week 1</span></option>
              <option value="2"><span class="ar-only">الأسبوع 2</span><span class="en-only" style="display:none;">Week 2</span></option>
              <option value="3"><span class="ar-only">الأسبوع 3</span><span class="en-only" style="display:none;">Week 3</span></option>
              <option value="4"><span class="ar-only">الأسبوع 4</span><span class="en-only" style="display:none;">Week 4</span></option>
              <option value="5"><span class="ar-only">الأسبوع 5</span><span class="en-only" style="display:none;">Week 5</span></option>
              <option value="6"><span class="ar-only">الأسبوع 6</span><span class="en-only" style="display:none;">Week 6</span></option>
              <option value="7"><span class="ar-only">الأسبوع 7</span><span class="en-only" style="display:none;">Week 7</span></option>
              <option value="8"><span class="ar-only">الأسبوع 8</span><span class="en-only" style="display:none;">Week 8</span></option>
              <option value="9"><span class="ar-only">الأسبوع 9</span><span class="en-only" style="display:none;">Week 9</span></option>
              <option value="10"><span class="ar-only">الأسبوع 10</span><span class="en-only" style="display:none;">Week 10</span></option>
            </select>
          </div>

          <div class="mb-3" id="lessonNumberBox" style="display: none;">
            <label class="form-label"><span class="ar-only">رقم الحصة النسبي (مثلاً 3)</span><span class="en-only" style="display:none;">Relative Session Number (e.g. 3)</span></label>
            <input type="number" name="lesson_number" id="lessonNumberInput" class="form-control" min="1">
          </div>

          <div id="nextPreview" class="alert alert-info py-2 small" style="display:none"></div>

          <button type="submit" class="btn btn-success w-100"><span class="ar-only">بدء الحصة</span><span class="en-only" style="display:none;">Start Session</span></button>
        </form>
      </div>
    </div>
  </div>

  <script>
    const modeRepeat = document.getElementById('modeRepeat');
    const modeNew = document.getElementById('modeNew');
    const lessonNumberBox = document.getElementById('lessonNumberBox');

    function toggleBox() {
      lessonNumberBox.style.display = modeRepeat.checked ? 'block' : 'none';
    }
    modeRepeat.addEventListener('change', toggleBox);
    modeNew.addEventListener('change', toggleBox);

    // معاينة: آخر حصة لنفس السنتر والمادة، والرقم اللي هيتعمل — ولو الرقم ده موجود نقول ونقترح التفعيل
    (function () {
      const form = document.getElementById('startSessionForm');
      const subject = form.querySelector('[name="subject_id"]');
      const center = form.querySelector('[name="center_id"]');
      const lessonInput = document.getElementById('lessonNumberInput');
      const box = document.getElementById('nextPreview');
      let timer = null;
      let lastResult = null;
      async function refresh() {
        if (!subject.value || !center.value) { box.style.display = 'none'; lastResult = null; return; }
        const params = new URLSearchParams({ center_id: center.value, subject_id: subject.value });
        if (modeRepeat.checked && lessonInput.value) params.set('lesson_number', lessonInput.value);
        try {
          const res = await fetch('/sessions/next-number?' + params.toString(), { headers: { Accept: 'application/json' } });
          const data = await res.json();
          if (!data.success) return;
          lastResult = data;
          let html = '';
          if (!data.hasSeries) {
            box.className = 'alert alert-danger py-2 small';
            html = '❌ مفيش أساس سيريال للسنتر والمادة دول — لازم يتعرّف الأول.';
          } else if (modeRepeat.checked) {
            if (data.existing) {
              box.className = 'alert alert-warning py-2 small';
              html = '⚠️ حصة ' + data.existing.lesson_number + ' موجودة بالفعل هنا (سيريال ' + data.existing.serial_number + (data.existing.session_date ? '، ' + data.existing.session_date : '') + '). '
                + '<button type="button" class="btn btn-sm btn-warning fw-bold ms-1" data-activate="' + data.existing.id + '">✅ فعّلها</button>';
            } else {
              box.className = 'alert alert-info py-2 small';
              html = lessonInput.value ? '✔️ رقم ' + lessonInput.value + ' مش موجود قبل كده — هيتعمل جديد.' : 'اكتب رقم الحصة.';
            }
          } else {
            box.className = 'alert alert-info py-2 small';
            html = (data.last ? 'آخر حصة هنا: <b>' + data.last.lesson_number + '</b> (سيريال ' + data.last.serial_number + '). ' : 'مفيش حصص قبل كده للسنتر والمادة دول. ')
              + 'الحصة الجديدة هتبقى رقم <b>' + data.next + '</b>.';
          }
          box.innerHTML = html;
          box.style.display = '';
        } catch (e) { box.style.display = 'none'; }
      }
      function schedule() { clearTimeout(timer); timer = setTimeout(refresh, 250); }
      [subject, center, modeRepeat, modeNew].forEach((el) => el.addEventListener('change', schedule));
      lessonInput.addEventListener('input', schedule);
      box.addEventListener('click', (e) => {
        const id = e.target && e.target.getAttribute('data-activate');
        if (!id) return;
        const f = document.createElement('form');
        f.method = 'POST'; f.action = '/sessions/' + id + '/activate';
        document.body.appendChild(f); f.submit();
      });
      form.addEventListener('submit', (e) => {
        if (modeRepeat.checked && lastResult && lastResult.existing && String(lastResult.existing.lesson_number) === lessonInput.value) {
          e.preventDefault();
          alert('الحصة دي موجودة بالفعل — اضغط "فعّلها" بدل ما تعمل واحدة جديدة.');
        }
      });
    })();
  </script>
<%- include('partials/footer') %>