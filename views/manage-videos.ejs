<%- include('partials/header') %>

<h3 class="mb-4">🎬 إدارة فيديوهات الحصص</h3>

<div class="card mb-4">
  <div class="card-body">
    <h5 class="mb-3 fw-bold">إنشاء درس جديد مرتبط بحصة</h5>
    <form action="/admin/videos/create" method="POST" class="row g-2">
      <div class="col-md-4">
        <select name="session_ids" class="form-select session-select" multiple required style="height:auto;">
  <% allSessions.forEach(s => { %>
    <option value="<%= s.id %>">
      <%= s.Subject.name %> - <%= s.Center.name %> (حصة <%= s.lesson_number %> | سيريال <%= s.serial_number %>)
    </option>
  <% }) %>
</select>
<small class="text-muted">اضغط Ctrl للاختيار من أكثر من حصة في نفس الوقت</small>
      </div>
      <div class="col-md-6">
        <input type="text" name="title" class="form-control" placeholder="اسم الدرس (مثال: التفاضل - الجزء الأول)" required>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">إنشاء</button>
      </div>
    </form>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <h5 class="mb-3 fw-bold">🔗 روابط الامتحان للحصة</h5>
    <form action="/admin/videos/session/exam" method="POST" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small">اختر الحصة</label>
        <select name="session_id" class="form-select" required>
          <option value="">-- اختر حصة --</option>
          <% allSessions.forEach(s => { %>
            <option value="<%= s.id %>"><%= s.Subject.name %> - <%= s.Center.name %> (حصة <%= s.lesson_number %> | سيريال <%= s.serial_number %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-5">
        <label class="form-label small">رابط الاختبار</label>
        <input type="url" name="exam_url" class="form-control" placeholder="https://example.com/quiz">
      </div>
      <div class="col-md-5">
        <label class="form-label small">رابط فيديو إجابة الاختبار</label>
        <input type="url" name="exam_video_url" class="form-control" placeholder="https://vimeo.com/...">
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-warning w-100">حفظ روابط الاختبار</button>
      </div>
    </form>
    <p class="text-muted small mt-2 mb-0">يمكنك إضافة رابط الاختبار ورابط فيديو الإجابة معًا. سيظهر كل واحد في بطاقة مستقلة.</p>
  </div>
</div>

<h5 class="mb-3 fw-bold">الدروس الموجودة</h5>
<div class="row g-3">
  <% videos.forEach(v => { %>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
              <form action="/admin/videos/<%= v.id %>/update-title" method="POST" class="d-flex align-items-center gap-2 flex-grow-1">
                <input type="text" name="title" value="<%= v.title %>" class="form-control form-control-sm" required>
                <button type="submit" class="btn btn-sm btn-outline-primary" title="تحديث اسم الفيديو">حفظ</button>
              </form>
              <form action="/admin/videos/delete/<%= v.id %>" method="POST" onsubmit="return confirm('متأكد من حذف الدرس بالكامل؟ سيُحذف كل ما يتعلق به (فيديوهات، صلاحيات مشاهدة).')">
                <button type="submit" class="btn btn-sm btn-outline-danger border-0 py-1 px-2" title="حذف الدرس بالكامل">🗑️</button>
              </form>
            </div>
            <p class="text-muted small mb-3">
              <%= v.Session.Subject.name %> - <%= v.Session.Center.name %><br>
              حصة رقم <%= v.Session.lesson_number %> • <%= v.Session.session_date %>
            </p>
          </div>
          <div class="d-flex gap-2 mt-2">
            <a href="/admin/videos/<%= v.id %>" class="btn btn-sm btn-outline-primary flex-grow-1">إدارة الفيديوهات</a>
            <a href="/admin/videos/<%= v.id %>/access" class="btn btn-sm btn-outline-secondary flex-grow-1">التحكم</a>
          </div>

          <% const examUrl = v.Session && v.Session.exam_url ? v.Session.exam_url : ''; %>
          <% if (examUrl) { %>
            <div class="mt-2">
              <a href="<%= examUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-warning w-100">🔗 فتح رابط الامتحان</a>
            </div>
          <% } else { %>
            <div class="mt-2 small text-muted">لا يوجد رابط امتحان لهذه الحصة</div>
          <% } %>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>