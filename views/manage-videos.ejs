<%- include('partials/header') %>

<style>
  .vl-head { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .vl-head h3 { margin: 0; }
  .vl-count { font-size: 0.85rem; color: var(--sf-muted); font-weight: 600; }
  .vl-panel .card-body { padding: 1.1rem 1.25rem; }
  .vl-toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 12px 14px; }
  .vl-toolbar .vl-search { flex: 1 1 220px; min-width: 180px; }
  .vl-toolbar .form-select { width: auto; min-width: 150px; }
  .vl-view { display: inline-flex; border: 1px solid var(--sf-input-border); border-radius: 11px; overflow: hidden; }
  .vl-view button { border: none; background: transparent; color: var(--sf-muted); padding: 6px 12px; font-size: 1rem; line-height: 1; }
  .vl-view button.active { background: var(--sf-primary); color: #fff; }

  /* one markup, two layouts: every form works the same in both */
  .vl-list.vl-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .vl-list.vl-cards .vl-rowhead { display: none; }
  .vl-cards .vl-item {
    background: var(--sf-card-bg); border-radius: var(--sf-radius); box-shadow: var(--sf-shadow);
    padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; transition: box-shadow .2s;
  }
  .vl-cards .vl-item:hover { box-shadow: var(--sf-shadow-md); }
  .vl-cards .vl-actions { margin-top: auto; }

  .vl-list.vl-rows { background: var(--sf-card-bg); border-radius: var(--sf-radius); box-shadow: var(--sf-shadow); overflow: hidden; }
  .vl-rows .vl-rowhead, .vl-rows .vl-item {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.8fr) 190px 220px;
    gap: 14px; align-items: center; padding: 10px 16px;
  }
  .vl-rows .vl-rowhead { background: var(--sf-table-header-bg); color: var(--sf-muted); font-size: 0.78rem; font-weight: 700; }
  .vl-rows .vl-item { border-top: 1px solid var(--sf-input-border); }
  .vl-rows .vl-item:hover { background: color-mix(in srgb, var(--sf-primary) 4%, var(--sf-card-bg)); }
  .vl-rows .vl-sessions { flex-direction: row; flex-wrap: wrap; }
  @media (max-width: 992px) {
    .vl-rows .vl-rowhead { display: none; }
    .vl-rows .vl-item { grid-template-columns: 1fr; gap: 8px; }
  }

  .vl-title { display: flex; align-items: flex-start; gap: 6px; min-width: 0; }
  .vl-title form { display: flex; gap: 6px; align-items: flex-start; margin: 0; }
  .vl-title form.vl-title-form { flex: 1; min-width: 0; }
  .vl-title textarea { resize: none; overflow: hidden; line-height: 1.5; font-weight: 700; border-color: transparent; background: transparent; padding-inline: 6px; }
  .vl-title textarea:hover, .vl-title textarea:focus { border-color: var(--sf-input-border); background: var(--sf-card-bg); }
  .vl-title .vl-save { display: none; }
  .vl-title form.dirty .vl-save { display: inline-flex; }
  .vl-sessions { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; min-width: 0; }
  .vl-exam { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .vl-link { display: inline-flex; align-items: center; border-radius: 999px; overflow: hidden; border: 1px solid var(--sf-input-border); font-size: 0.78rem; font-weight: 700; }
  .vl-link a { padding: 3px 10px; }
  .vl-link.exam a { background: var(--sf-warning-soft-bg); color: var(--sf-warning-soft-text); }
  .vl-link.answer a { background: var(--sf-info-soft-bg); color: var(--sf-info-soft-text); }
  .vl-link form { display: inline-flex; margin: 0; }
  .vl-link button { border: none; background: var(--sf-card-bg); color: var(--sf-danger); padding: 3px 8px; font-size: 0.75rem; }
  .vl-link button:hover { background: var(--sf-danger-soft-bg); }
  .vl-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .vl-actions .vl-visible-row { flex-basis: 100%; }
  .vl-actions .btn { white-space: nowrap; }
  .vl-cards .vl-actions .btn { flex: 1; }
  .vl-del { border: none; background: none; color: var(--sf-muted); padding: 4px 6px; border-radius: 8px; }
  .vl-del:hover { background: var(--sf-danger-soft-bg); color: var(--sf-danger); }
  .vl-visible { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 13px; font-weight: 600; }
  .vl-visible .form-check-input { width: 2.4em; height: 1.25em; margin: 0; cursor: pointer; }
  .vl-hidden-badge { display: none; font-size: 12px; font-weight: 700; color: var(--sf-danger); background: var(--sf-danger-soft-bg); border-radius: 999px; padding: 2px 10px; }
  .vl-item.is-hidden .vl-hidden-badge { display: inline-block; }
  .vl-item.is-hidden .vl-title, .vl-item.is-hidden .vl-sessions, .vl-item.is-hidden .vl-exam { opacity: .55; }
</style>

<div class="vl-head">
  <div>
    <h3>🎬 <span class="ar-only">إدارة فيديوهات الحصص</span><span class="en-only" style="display:none;">Manage Session Videos</span></h3>
    <div class="vl-count"><span class="ar-only"><%= videos.length %> درس</span><span class="en-only" style="display:none;"><%= videos.length %> lessons</span></div>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#createPanel" aria-expanded="false" aria-controls="createPanel">
      ➕ <span class="ar-only">درس جديد</span><span class="en-only" style="display:none;">New lesson</span>
    </button>
    <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#examPanel" aria-expanded="false" aria-controls="examPanel">
      🔗 <span class="ar-only">روابط الاختبار</span><span class="en-only" style="display:none;">Exam links</span>
    </button>
  </div>
</div>

<div class="collapse" id="createPanel">
  <div class="card mb-3 vl-panel">
    <div class="card-body">
      <h6 class="mb-3 fw-bold"><span class="ar-only">إنشاء درس جديد مرتبط بحصة</span><span class="en-only" style="display:none;">Create New Lesson Linked to a Session</span></h6>
      <form action="/admin/videos/create" method="POST" class="row g-2">
        <div class="col-md-5">
          <select name="session_ids" class="form-select session-select" multiple required style="height:auto;" placeholder="اختار حصة أو أكتر">
            <% allSessions.forEach(s => { %>
              <option value="<%= s.id %>" <%- sf.sessionOption(s) %>><%= sf.sessionText(s) %></option>
            <% }) %>
          </select>
          <small class="text-muted"><span class="ar-only">تقدر تختار أكتر من حصة</span><span class="en-only" style="display:none;">You can pick more than one session</span></small>
        </div>
        <div class="col-md-5">
          <input type="text" name="title" class="form-control" placeholder="اسم الدرس (مثال: التفاضل - الجزء الأول)" required>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100"><span class="ar-only">إنشاء</span><span class="en-only" style="display:none;">Create</span></button>
        </div>
      </form>
    </div>
  </div>
</div>

<%
  const examSubjects = new Map();
  (examTargets || []).forEach(t => { if (!examSubjects.has(t.subjectId)) examSubjects.set(t.subjectId, t.subjectName); });
%>
<div class="collapse" id="examPanel">
  <div class="card mb-3 vl-panel">
    <div class="card-body">
      <h6 class="mb-3 fw-bold">🔗 <span class="ar-only">روابط الاختبار</span><span class="en-only" style="display:none;">Exam Links</span></h6>
      <form action="/admin/videos/exam-links" method="POST" id="examLinksForm" class="row g-2 align-items-end">
        <div class="col-md-4">
          <label class="form-label small"><span class="ar-only">المادة</span><span class="en-only" style="display:none;">Subject</span></label>
          <select name="subject_id" id="examSubject" class="form-select" required onchange="refreshExamForm()">
            <option value="">-- اختر المادة --</option>
            <% [...examSubjects.entries()].forEach(([id, name]) => { %>
              <option value="<%= id %>" <%- sf.colorAttr('subject', { id, name }) %>><%= name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small"><span class="ar-only">رقم الحصة</span><span class="en-only" style="display:none;">Session Number</span></label>
          <select name="lesson_number" id="examLesson" class="form-select" required onchange="refreshExamForm(true)">
            <option value="">-- اختر رقم الحصة --</option>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label small mb-1"><span class="ar-only">السناتر (لو مختارتش أي سنتر الرابط هيظهر لكل سناتر المادة)</span><span class="en-only" style="display:none;">Centers (none selected = all centers of this subject)</span></label>
          <div id="examCenters" class="d-flex flex-wrap gap-3 border rounded p-2 small text-muted">
            <span>اختر المادة ورقم الحصة الأول</span>
          </div>
        </div>
        <div class="col-md-5">
          <label class="form-label small"><span class="ar-only">رابط الاختبار</span><span class="en-only" style="display:none;">Exam Link</span></label>
          <input type="url" name="exam_url" class="form-control" placeholder="https://example.com/quiz">
        </div>
        <div class="col-md-5">
          <label class="form-label small"><span class="ar-only">رابط فيديو إجابة الاختبار</span><span class="en-only" style="display:none;">Exam Answer Video Link</span></label>
          <input type="url" name="exam_video_url" class="form-control" placeholder="https://vimeo.com/...">
        </div>
        <div class="col-md-2">
          <button type="submit" name="action" value="save" class="btn btn-warning w-100"><span class="ar-only">حفظ روابط الاختبار</span><span class="en-only" style="display:none;">Save Exam Links</span></button>
        </div>
        <div class="col-12 d-flex flex-wrap gap-3 align-items-center small">
          <label class="mb-0"><input type="checkbox" name="delete_exam_url" value="1"> <span class="ar-only">رابط الاختبار</span><span class="en-only" style="display:none;">Exam link</span></label>
          <label class="mb-0"><input type="checkbox" name="delete_exam_video_url" value="1"> <span class="ar-only">فيديو الإجابة</span><span class="en-only" style="display:none;">Answer video</span></label>
          <button type="submit" name="action" value="delete" formnovalidate class="btn btn-sm btn-outline-danger" onclick="return confirmExamDelete()"><span class="ar-only">حذف المحدد من السناتر المختارة</span><span class="en-only" style="display:none;">Delete checked for selected centers</span></button>
        </div>
      </form>
      <div id="examCurrentLinks" class="small mt-2"></div>
      <p class="text-muted small mt-2 mb-0"><span class="ar-only">الرابط بيتحط لكل حصص المادة اللي بالرقم ده في السناتر المختارة (أو كل السناتر لو مختارتش)، وبيظهر للطلاب في كارت الاختبار جوه الأسبوع.</span><span class="en-only" style="display:none;">The link is applied to every session of this subject with this number in the selected centers (or all centers if none selected), and appears to students as the exam card inside the week.</span></p>
    </div>
  </div>
</div>

<script>
  const EXAM_TARGETS = <%- JSON.stringify(examTargets || []).replace(/</g, '\\u003c') %>;

  function escapeExamHtml(value) {
    return String(value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
  }

  function refreshExamForm(lessonChanged) {
    const subjectId = Number(document.getElementById('examSubject').value);
    const lessonSelect = document.getElementById('examLesson');
    const subjectTargets = EXAM_TARGETS.filter(t => t.subjectId === subjectId);

    if (!lessonChanged) {
      const previous = lessonSelect.value;
      const numbers = [...new Set(subjectTargets.map(t => t.lessonNumber))].sort((a, b) => a - b);
      lessonSelect.innerHTML = '<option value="">-- اختر رقم الحصة --</option>' +
        numbers.map(n => `<option value="${n}">${n}</option>`).join('');
      if (numbers.includes(Number(previous))) lessonSelect.value = previous;
    }

    const lessonNumber = lessonSelect.value === '' ? null : Number(lessonSelect.value);
    const centersBox = document.getElementById('examCenters');
    const currentBox = document.getElementById('examCurrentLinks');
    if (!subjectId || lessonNumber === null) {
      centersBox.innerHTML = '<span>اختر المادة ورقم الحصة الأول</span>';
      currentBox.innerHTML = '';
      return;
    }

    const centers = new Map();
    subjectTargets.filter(t => t.lessonNumber === lessonNumber).forEach(t => {
      const c = centers.get(t.centerId) || { name: t.centerName, examUrl: '', examVideoUrl: '' };
      c.examUrl = c.examUrl || t.examUrl;
      c.examVideoUrl = c.examVideoUrl || t.examVideoUrl;
      centers.set(t.centerId, c);
    });

    centersBox.innerHTML = [...centers.entries()].map(([id, c]) =>
      `<label class="mb-0 text-body"><input type="checkbox" name="center_ids" value="${id}"> ${escapeExamHtml(c.name)}</label>`
    ).join('');

    currentBox.innerHTML = [...centers.values()].map(c => {
      const links = [
        c.examUrl ? `🔗 <a href="${escapeExamHtml(c.examUrl)}" target="_blank" rel="noopener noreferrer">رابط الاختبار</a>` : '',
        c.examVideoUrl ? `▶ <a href="${escapeExamHtml(c.examVideoUrl)}" target="_blank" rel="noopener noreferrer">فيديو الإجابة</a>` : '',
      ].filter(Boolean).join(' &nbsp; ');
      return `<div><strong>${escapeExamHtml(c.name)}:</strong> ${links || '<span class="text-muted">لا توجد روابط</span>'}</div>`;
    }).join('');
  }

  function confirmExamDelete() {
    const form = document.getElementById('examLinksForm');
    if (!form.subject_id.value || form.lesson_number.value === '') { alert('اختر المادة ورقم الحصة'); return false; }
    if (!form.delete_exam_url.checked && !form.delete_exam_video_url.checked) { alert('علّم على الرابط اللي عايز تحذفه'); return false; }
    const anyCenter = form.querySelectorAll('input[name="center_ids"]:checked').length > 0;
    return confirm(anyCenter ? 'حذف الروابط المحددة من السناتر المختارة؟' : 'حذف الروابط المحددة من كل سناتر المادة؟');
  }
</script>

<%
  const centersMap = new Map();
  const subjectsMap = new Map();
  videos.forEach(v => {
    const linked = [v.Session, ...(v.VideoSessions || []).map(vs => vs.Session)].filter(Boolean);
    linked.forEach(s => {
      if (s.Center) centersMap.set(s.Center.id, s.Center.name);
      if (s.Subject) subjectsMap.set(s.Subject.id, s.Subject.name);
    });
  });
%>

<div class="card mb-3">
  <div class="vl-toolbar">
    <input type="search" id="filterTitle" class="form-control form-control-sm vl-search" placeholder="🔍 دور باسم الدرس..." oninput="applyVideoFilters()">
    <select id="filterCenter" class="form-select form-select-sm" onchange="applyVideoFilters()" title="السنتر">
      <option value=""><span class="ar-only">كل السناتر</span><span class="en-only" style="display:none;">All Centers</span></option>
      <% [...centersMap.entries()].forEach(([id, name]) => { %>
        <option value="<%= id %>" <%- sf.colorAttr('center', { id, name }) %>><%= name %></option>
      <% }) %>
    </select>
    <select id="filterSubject" class="form-select form-select-sm" onchange="applyVideoFilters()" title="المادة">
      <option value=""><span class="ar-only">كل المواد</span><span class="en-only" style="display:none;">All Subjects</span></option>
      <% [...subjectsMap.entries()].forEach(([id, name]) => { %>
        <option value="<%= id %>" <%- sf.colorAttr('subject', { id, name }) %>><%= name %></option>
      <% }) %>
    </select>
    <span class="vl-count ms-auto" id="shownCount"></span>
    <div class="vl-view" role="group" aria-label="طريقة العرض / View">
      <button type="button" data-view="cards" title="كروت / Cards"><i class="bi bi-grid-3x2-gap"></i></button>
      <button type="button" data-view="rows" title="صفوف / Rows"><i class="bi bi-list-ul"></i></button>
    </div>
  </div>
</div>

<div class="vl-list vl-cards" id="videosContainer">
  <div class="vl-rowhead">
    <div><span class="ar-only">الدرس</span><span class="en-only" style="display:none;">Lesson</span></div>
    <div><span class="ar-only">الحصص المرتبطة</span><span class="en-only" style="display:none;">Linked sessions</span></div>
    <div><span class="ar-only">الاختبار</span><span class="en-only" style="display:none;">Exam</span></div>
    <div></div>
  </div>
  <% videos.forEach(v => { %>
    <% const linkedSessions = [v.Session, ...(v.VideoSessions || []).map(videoSession => videoSession.Session)].filter(Boolean); %>
    <% const cardCenterIds = [...new Set(linkedSessions.map(s => s.Center?.id).filter(Boolean))].join(','); %>
    <% const cardSubjectIds = [...new Set(linkedSessions.map(s => s.Subject?.id).filter(Boolean))].join(','); %>
    <% const examSession = linkedSessions.find(session => session.exam_url || session.exam_video_url); %>
    <% const examUrl = examSession?.exam_url || ''; %>
    <% const examVideoUrl = examSession?.exam_video_url || ''; %>
    <div class="vl-item video-card-col<%= v.is_visible === false ? ' is-hidden' : '' %>" data-centers="<%= cardCenterIds %>" data-subjects="<%= cardSubjectIds %>" data-title="<%= String(v.title || '').toLowerCase() %>">
      <div class="vl-title">
        <form action="/admin/videos/<%= v.id %>/update-title" method="POST" class="vl-title-form">
          <textarea name="title" rows="1" class="form-control form-control-sm video-title-input" required title="اضغط عشان تعدل الاسم"><%= v.title %></textarea>
          <button type="submit" class="btn btn-sm btn-primary vl-save" title="تحديث اسم الفيديو"><span class="ar-only">حفظ</span><span class="en-only" style="display:none;">Save</span></button>
        </form>
        <form action="/admin/videos/delete/<%= v.id %>" method="POST" onsubmit="return confirm('متأكد من حذف الدرس بالكامل؟ سيُحذف كل ما يتعلق به (فيديوهات، صلاحيات مشاهدة).')">
          <button type="submit" class="vl-del" title="حذف الدرس بالكامل"><i class="bi bi-trash3"></i></button>
        </form>
      </div>
      <div class="vl-sessions">
        <% if (linkedSessions.length) { %>
          <% linkedSessions.forEach(session => { %><%- sf.session(session) %><% }) %>
        <% } else { %>
          <span class="small text-muted"><span class="ar-only">لا توجد حصص مرتبطة</span><span class="en-only" style="display:none;">No Linked Sessions</span></span>
        <% } %>
      </div>
      <div class="vl-exam">
        <% if (examUrl) { %>
          <span class="vl-link exam">
            <a href="<%= examUrl %>" target="_blank" rel="noopener noreferrer">🔗 <span class="ar-only">الاختبار</span><span class="en-only" style="display:none;">Exam</span></a>
            <form action="/admin/videos/session/exam/delete" method="POST" onsubmit="return confirm('حذف رابط الاختبار؟')">
              <input type="hidden" name="video_id" value="<%= v.id %>">
              <input type="hidden" name="field" value="exam_url">
              <button type="submit" title="حذف رابط الاختبار">✕</button>
            </form>
          </span>
        <% } %>
        <% if (examVideoUrl) { %>
          <span class="vl-link answer">
            <a href="<%= examVideoUrl %>" target="_blank" rel="noopener noreferrer">▶ <span class="ar-only">فيديو الإجابة</span><span class="en-only" style="display:none;">Answer video</span></a>
            <form action="/admin/videos/session/exam/delete" method="POST" onsubmit="return confirm('حذف فيديو إجابة الاختبار؟')">
              <input type="hidden" name="video_id" value="<%= v.id %>">
              <input type="hidden" name="field" value="exam_video_url">
              <button type="submit" title="حذف فيديو الإجابة">✕</button>
            </form>
          </span>
        <% } %>
        <% if (!examUrl && !examVideoUrl) { %>
          <span class="small text-muted"><span class="ar-only">مفيش روابط اختبار</span><span class="en-only" style="display:none;">No exam links</span></span>
        <% } %>
      </div>
      <div class="vl-actions">
        <div class="vl-visible-row d-flex align-items-center justify-content-between gap-2 flex-wrap">
          <label class="form-check form-switch vl-visible" title="لو اتقفل، الدرس بيختفي من البوابة والأبلكيشن عند كل الطلاب">
            <input class="form-check-input vl-visible-toggle" type="checkbox" role="switch" data-video-id="<%= v.id %>" <%= v.is_visible === false ? '' : 'checked' %>>
            <span><span class="ar-only">ظاهر للطلاب</span><span class="en-only" style="display:none;">Visible to students</span></span>
          </label>
          <span class="vl-hidden-badge">🙈 <span class="ar-only">مستخبي</span><span class="en-only" style="display:none;">Hidden</span></span>
        </div>
        <a href="/admin/videos/<%= v.id %>" class="btn btn-sm btn-outline-primary">🎞️ <span class="ar-only">الفيديوهات</span><span class="en-only" style="display:none;">Videos</span></a>
        <a href="/admin/videos/<%= v.id %>/access" class="btn btn-sm btn-outline-secondary">🔐 <span class="ar-only">التحكم</span><span class="en-only" style="display:none;">Control</span></a>
      </div>
    </div>
  <% }) %>
</div>
<p id="noVideosMsg" class="text-muted text-center mt-3" style="display:none;"><span class="ar-only">لا توجد دروس مطابقة</span><span class="en-only" style="display:none;">No lessons match</span></p>

<script>
  function applyVideoFilters() {
    const center = document.getElementById('filterCenter').value;
    const subject = document.getElementById('filterSubject').value;
    const q = document.getElementById('filterTitle').value.trim().toLowerCase();
    const items = document.querySelectorAll('.video-card-col');
    let visibleCount = 0;
    items.forEach(col => {
      const centers = col.dataset.centers ? col.dataset.centers.split(',') : [];
      const subjects = col.dataset.subjects ? col.dataset.subjects.split(',') : [];
      const visible = (!center || centers.includes(center)) && (!subject || subjects.includes(subject)) && (!q || (col.dataset.title || '').includes(q));
      col.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });
    document.getElementById('noVideosMsg').style.display = visibleCount === 0 ? 'block' : 'none';
    const en = (localStorage.getItem('language') || 'ar') === 'en';
    document.getElementById('shownCount').textContent = visibleCount === items.length ? '' : (en ? `Showing ${visibleCount} of ${items.length}` : `ظاهر ${visibleCount} من ${items.length}`);
  }

  // كروت ولا صفوف — الاختيار بيتحفظ على الجهاز
  (function () {
    const list = document.getElementById('videosContainer');
    const buttons = document.querySelectorAll('.vl-view button');
    function setView(view) {
      const rows = view === 'rows';
      list.classList.toggle('vl-cards', !rows);
      list.classList.toggle('vl-rows', rows);
      buttons.forEach(b => b.classList.toggle('active', b.dataset.view === (rows ? 'rows' : 'cards')));
      try { localStorage.setItem('videosView', rows ? 'rows' : 'cards'); } catch (e) {}
      if (typeof refitTitles === 'function') setTimeout(refitTitles, 0);
    }
    buttons.forEach(b => b.addEventListener('click', () => setView(b.dataset.view)));
    if ((localStorage.getItem('language') || 'ar') === 'en') document.getElementById('filterTitle').placeholder = '🔍 Search lesson name...';
    let saved = 'cards';
    try { saved = localStorage.getItem('videosView') || 'cards'; } catch (e) {}
    setView(saved);
  })();
</script>

<script>
  // اسم الفيديو بيظهر كامل: الخانة بتطول على قد الاسم، وEnter بيحفظ زي الأول. زرار "حفظ" بيظهر بس لما تعدل
  document.querySelectorAll('.video-title-input').forEach(function (box) {
    function fit() {
      if (!box.offsetParent) return; // الكارت مستخبي (فلتر): هيتظبط لما يظهر
      box.style.height = 'auto';
      box.style.height = box.scrollHeight + 2 + 'px';
    }
    box._fitTitle = fit;
    box.addEventListener('input', function () {
      fit();
      box.form.classList.toggle('dirty', box.value !== box.defaultValue);
    });
    box.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); box.form.requestSubmit ? box.form.requestSubmit() : box.form.submit(); }
    });
    fit();
  });
  // زرار "ظاهر للطلاب": بيتحفظ على طول من غير ما الصفحة تتحمل تاني
  document.querySelectorAll('.vl-visible-toggle').forEach(function (box) {
    box.addEventListener('change', async function () {
      const card = box.closest('.vl-item');
      const want = box.checked;
      if (!want && !confirm('إخفاء الدرس ده عن كل الطلاب؟ (مش هيظهر في البوابة ولا الأبلكيشن لحد ما ترجعه)')) { box.checked = true; return; }
      box.disabled = true;
      try {
        const r = await fetch('/admin/videos/' + box.dataset.videoId + '/visibility', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ visible: want ? '1' : '0' }),
        });
        const data = await r.json().catch(function () { return {}; });
        if (!r.ok || !data.success) throw new Error(data.message || ('HTTP ' + r.status));
        card.classList.toggle('is-hidden', !data.visible);
        box.checked = !!data.visible;
      } catch (e) {
        box.checked = !want;
        alert('❌ متحفظش: ' + e.message);
      } finally {
        box.disabled = false;
      }
    });
  });
  function refitTitles() {
    document.querySelectorAll('.video-title-input').forEach(function (box) { if (box._fitTitle) box._fitTitle(); });
  }
  window.addEventListener('resize', refitTitles);
  document.addEventListener('change', function () { setTimeout(refitTitles, 0); });
  document.addEventListener('click', function () { setTimeout(refitTitles, 0); });
</script>

