<%- include('partials/header') %>

<h3 class="mb-4">🎬 <span class="ar-only">إدارة فيديوهات الحصص</span><span class="en-only" style="display:none;">Manage Session Videos</span></h3>

<div class="card mb-4">
  <div class="card-body">
    <h5 class="mb-3 fw-bold"><span class="ar-only">إنشاء درس جديد مرتبط بحصة</span><span class="en-only" style="display:none;">Create New Lesson Linked to a Session</span></h5>
    <form action="/admin/videos/create" method="POST" class="row g-2">
      <div class="col-md-4">
        <select name="session_ids" class="form-select session-select" multiple required style="height:auto;">
  <% allSessions.forEach(s => { %>
    <option value="<%= s.id %>">
      <%= s.Subject.name %> - <%= s.Center.name %> (<span class="ar-only">حصة</span><span class="en-only" style="display:none;">Session</span> <%= s.lesson_number %> | <span class="ar-only">سيريال</span><span class="en-only" style="display:none;">Serial</span> <%= s.serial_number %>)
    </option>
  <% }) %>
</select>
<small class="text-muted"><span class="ar-only">اضغط Ctrl للاختيار من أكثر من حصة في نفس الوقت</span><span class="en-only" style="display:none;">Press Ctrl to select multiple sessions at once</span></small>
      </div>
      <div class="col-md-6">
        <input type="text" name="title" class="form-control" placeholder="اسم الدرس (مثال: التفاضل - الجزء الأول)" required>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100"><span class="ar-only">إنشاء</span><span class="en-only" style="display:none;">Create</span></button>
      </div>
    </form>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <h5 class="mb-3 fw-bold">🔗 <span class="ar-only">روابط الامتحان لفيديو</span><span class="en-only" style="display:none;">Video Exam Links</span></h5>
    <form action="/admin/videos/session/exam" method="POST" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small"><span class="ar-only">اختر الفيديو</span><span class="en-only" style="display:none;">Choose Video</span></label>
        <select name="video_id" class="form-select" required>
          <option value=""><span class="ar-only">-- اختر فيديو --</span><span class="en-only" style="display:none;">-- Choose Video --</span></option>
          <% videos.forEach(video => { %>
            <option value="<%= video.id %>"><%= video.title %> (ID: <%= video.id %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-5">
        <label class="form-label small"><span class="ar-only">رابط الاختبار</span><span class="en-only" style="display:none;">Exam Link</span></label>
        <input type="url" name="exam_url" class="form-control" placeholder="https://example.com/quiz">
      </div>
      <div class="col-md-5">
        <label class="form-label small"><span class="ar-only">رابط فيديو إجابة الاختبار</span><span class="en-only" style="display:none;">Exam Answer Video Link</span></label>
        <input type="url" name="exam_video_url" class="form-control" placeholder="https://vimeo.com/...">
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-warning w-100"><span class="ar-only">حفظ روابط الاختبار</span><span class="en-only" style="display:none;">Save Exam Links</span></button>
      </div>
    </form>
    <p class="text-muted small mt-2 mb-0"><span class="ar-only">سيتم تطبيق الرابط على كل الحصص المرتبطة بهذا الفيديو، وسيظهر للطلاب في بطاقة فيديو إجابة الاختبار.</span><span class="en-only" style="display:none;">The link will apply to all sessions linked to this video, and will appear to students in the exam answer video card.</span></p>
  </div>
</div>

<%
  const centersMap = new Map();
  const subjectsMap = new Map();
  videos.forEach(v => {
    const linked = [v.Session, ...(v.VideoSessions || []).map(vs => vs.Session)].filter(Boolean);
    linked.forEach(s => {
      if (s.Center) centersMap.set(s.Center.id, s.Center.name);
      if (s.Subject) subjectsMap.set(s.Subject.id, s.Subject.name);
    });
  });
%>

<div class="card mb-3">
  <div class="card-body d-flex flex-wrap gap-3 align-items-end">
    <div>
      <label class="form-label small mb-1"><span class="ar-only">فلترة حسب السنتر</span><span class="en-only" style="display:none;">Filter by Center</span></label>
      <select id="filterCenter" class="form-select form-select-sm" onchange="applyVideoFilters()">
        <option value=""><span class="ar-only">كل السناتر</span><span class="en-only" style="display:none;">All Centers</span></option>
        <% [...centersMap.entries()].forEach(([id, name]) => { %>
          <option value="<%= id %>"><%= name %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="form-label small mb-1"><span class="ar-only">فلترة حسب المادة</span><span class="en-only" style="display:none;">Filter by Subject</span></label>
      <select id="filterSubject" class="form-select form-select-sm" onchange="applyVideoFilters()">
        <option value=""><span class="ar-only">كل المواد</span><span class="en-only" style="display:none;">All Subjects</span></option>
        <% [...subjectsMap.entries()].forEach(([id, name]) => { %>
          <option value="<%= id %>"><%= name %></option>
        <% }) %>
      </select>
    </div>
  </div>
</div>

<h5 class="mb-3 fw-bold"><span class="ar-only">الدروس الموجودة</span><span class="en-only" style="display:none;">Existing Lessons</span></h5>
<div class="row g-3" id="videosContainer">
  <% videos.forEach(v => { %>
    <% const linkedSessions = [v.Session, ...(v.VideoSessions || []).map(videoSession => videoSession.Session)].filter(Boolean); %>
    <% const cardCenterIds = [...new Set(linkedSessions.map(s => s.Center?.id).filter(Boolean))].join(','); %>
    <% const cardSubjectIds = [...new Set(linkedSessions.map(s => s.Subject?.id).filter(Boolean))].join(','); %>
    <div class="col-md-4 video-card-col" data-centers="<%= cardCenterIds %>" data-subjects="<%= cardSubjectIds %>">
      <div class="card h-100">
        <div class="card-body d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
              <form action="/admin/videos/<%= v.id %>/update-title" method="POST" class="d-flex align-items-center gap-2 flex-grow-1">
                <input type="text" name="title" value="<%= v.title %>" class="form-control form-control-sm" required>
                <button type="submit" class="btn btn-sm btn-outline-primary" title="تحديث اسم الفيديو"><span class="ar-only">حفظ</span><span class="en-only" style="display:none;">Save</span></button>
              </form>
              <form action="/admin/videos/delete/<%= v.id %>" method="POST" onsubmit="return confirm('متأكد من حذف الدرس بالكامل؟ سيُحذف كل ما يتعلق به (فيديوهات، صلاحيات مشاهدة).')">
                <button type="submit" class="btn btn-sm btn-outline-danger border-0 py-1 px-2" title="حذف الدرس بالكامل">🗑️</button>
              </form>
            </div>
            <p class="text-muted small mb-3">
              <% if (linkedSessions.length) { %>
                <% linkedSessions.forEach(session => { %>
                  <%= session.Subject?.name %> - <%= session.Center?.name %> (<span class="ar-only">حصة</span><span class="en-only" style="display:none;">Session</span> <%= session.lesson_number %>)<br>
                <% }) %>
              <% } else { %>
                <span class="ar-only">لا توجد حصص مرتبطة</span><span class="en-only" style="display:none;">No Linked Sessions</span>
              <% } %>
            </p>
          </div>
          <div class="d-flex gap-2 mt-2">
            <a href="/admin/videos/<%= v.id %>" class="btn btn-sm btn-outline-primary flex-grow-1"><span class="ar-only">إدارة الفيديوهات</span><span class="en-only" style="display:none;">Manage Videos</span></a>
            <a href="/admin/videos/<%= v.id %>/access" class="btn btn-sm btn-outline-secondary flex-grow-1"><span class="ar-only">التحكم</span><span class="en-only" style="display:none;">Control</span></a>
          </div>

          <% const examSession = linkedSessions.find(session => session.exam_url || session.exam_video_url); %>
          <% const examUrl = examSession?.exam_url || ''; %>
          <% const examVideoUrl = examSession?.exam_video_url || ''; %>
          <% if (examUrl) { %>
            <div class="mt-2">
              <a href="<%= examUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-warning w-100">🔗 <span class="ar-only">فتح رابط الامتحان</span><span class="en-only" style="display:none;">Open Exam Link</span></a>
              <form action="/admin/videos/session/exam/delete" method="POST" class="mt-1" onsubmit="return confirm('حذف رابط الاختبار؟')">
                <input type="hidden" name="video_id" value="<%= v.id %>">
                <input type="hidden" name="field" value="exam_url">
                <button type="submit" class="btn btn-sm btn-outline-danger w-100"><span class="ar-only">حذف رابط الاختبار</span><span class="en-only" style="display:none;">Delete Exam Link</span></button>
              </form>
            </div>
          <% } %>
          <% if (examVideoUrl) { %>
            <div class="mt-2">
              <a href="<%= examVideoUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-info w-100">▶ <span class="ar-only">فتح فيديو إجابة الاختبار</span><span class="en-only" style="display:none;">Open Exam Answer Video</span></a>
              <form action="/admin/videos/session/exam/delete" method="POST" class="mt-1" onsubmit="return confirm('حذف فيديو إجابة الاختبار؟')">
                <input type="hidden" name="video_id" value="<%= v.id %>">
                <input type="hidden" name="field" value="exam_video_url">
                <button type="submit" class="btn btn-sm btn-outline-danger w-100"><span class="ar-only">حذف فيديو الإجابة</span><span class="en-only" style="display:none;">Delete Answer Video</span></button>
              </form>
            </div>
          <% } %>
          <% if (!examUrl && !examVideoUrl) { %>
            <div class="mt-2 small text-muted"><span class="ar-only">لا توجد روابط اختبار لهذه الحصة</span><span class="en-only" style="display:none;">No exam links for this session</span></div>
          <% } %>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<p id="noVideosMsg" class="text-muted text-center mt-3" style="display:none;"><span class="ar-only">لا توجد دروس مطابقة لهذا الفلتر</span><span class="en-only" style="display:none;">No lessons match this filter</span></p>

<script>
  function applyVideoFilters() {
    const center = document.getElementById('filterCenter').value;
    const subject = document.getElementById('filterSubject').value;
    let visibleCount = 0;
    document.querySelectorAll('.video-card-col').forEach(col => {
      const centers = col.dataset.centers ? col.dataset.centers.split(',') : [];
      const subjects = col.dataset.subjects ? col.dataset.subjects.split(',') : [];
      const centerMatch = !center || centers.includes(center);
      const subjectMatch = !subject || subjects.includes(subject);
      const visible = centerMatch && subjectMatch;
      col.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });
    document.getElementById('noVideosMsg').style.display = visibleCount === 0 ? 'block' : 'none';
  }
</script>

<%- include('partials/footer') %>