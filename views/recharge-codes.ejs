<%- include('partials/header') %>

<h3 class="mb-4">🎫 <span class="ar-only">أكواد الشحن</span><span class="en-only" style="display:none;">Recharge Codes</span></h3>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3"><span class="ar-only">توليد أكواد جديدة</span><span class="en-only" style="display:none;">Generate New Codes</span></h6>
    <form action="/admin/recharge-codes/generate" method="POST" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">قيمة الكود (ج)</span><span class="en-only" style="display:none;">Code Value (EGP)</span></label>
        <input type="number" name="amount" class="form-control" placeholder="مثال: 200" required min="1">
      </div>
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">عدد الأكواد</span><span class="en-only" style="display:none;">Number of Codes</span></label>
        <input type="text" class="form-control" value="10 أكواد ثابتة" disabled>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">⚡ <span class="ar-only">Generate + تحميل Excel</span><span class="en-only" style="display:none;">Generate + Download Excel</span></button>
      </div>
    </form>
    <p class="text-muted small mt-2">⚠️ <span class="ar-only">كل ضغطة تنشئ 10 أكواد بدون سنتر، ثم يمكنك ربط المجموعة بسنتر واحد.</span><span class="en-only" style="display:none;">Each click creates 10 codes with no center, then you can link the group to one center.</span></p>
    <form id="batch-generate-form" class="row g-2 align-items-end mt-3">
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">عدد الملفات</span><span class="en-only" style="display:none;">Number of Files</span></label>
        <input type="number" name="file_count" class="form-control" placeholder="مثال: 5" required min="1" max="50">
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary w-100">📁 <span class="ar-only">توليد عدة ملفات</span><span class="en-only" style="display:none;">Generate Multiple Files</span></button>
      </div>
    </form>
    <script>
      document.getElementById('batch-generate-form').addEventListener('submit', async function (event) {
        event.preventDefault();
        const form = event.currentTarget;
        const count = Number(form.file_count.value);
        const amount = form.closest('.card-body').querySelector('input[name="amount"]').value;
        const button = form.querySelector('button');
        if (!amount || !count || count < 1 || count > 50) return;

        button.disabled = true;
        const originalText = button.textContent;
        try {
          button.textContent = `جاري توليد ${count} ملف`;
          const response = await fetch('/admin/recharge-codes/generate-batch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ amount, file_count: count }),
          });
          if (!response.ok) throw new Error('فشل توليد الملفات');
          const blob = await response.blob();
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `recharge_codes_${Date.now()}.zip`;
          link.click();
          URL.revokeObjectURL(url);
        } catch (error) {
          alert(error.message);
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      });
    </script>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3">🔍 <span class="ar-only">البحث عن كود شحن</span><span class="en-only" style="display:none;">Search a Recharge Code</span></h6>
    <form id="code-search-form" class="d-flex gap-2">
      <input type="text" id="code-search-input" class="form-control" placeholder="اكتب الكود (أو جزء منه) لمعرفة حالته والطالب اللي استخدمه" autocomplete="off" style="text-transform:uppercase;">
      <button type="submit" class="btn btn-primary text-nowrap">بحث</button>
    </form>
    <div id="code-search-results" class="mt-3"></div>
  </div>
</div>
<script>
  (function () {
    const form = document.getElementById('code-search-form');
    const input = document.getElementById('code-search-input');
    const out = document.getElementById('code-search-results');
    function row(label, value) {
      const r = document.createElement('div');
      r.className = 'd-flex justify-content-between border-bottom py-1 small';
      const l = document.createElement('span'); l.className = 'text-muted'; l.textContent = label;
      const v = document.createElement('span'); v.className = 'fw-semibold text-end'; v.textContent = value;
      r.appendChild(l); r.appendChild(v);
      return r;
    }
    const fmt = (d) => (d ? new Date(d).toLocaleString('ar-EG') : '—');
    function card(item) {
      const box = document.createElement('div');
      box.className = 'border rounded p-3 mb-3';
      const head = document.createElement('div');
      head.className = 'd-flex justify-content-between align-items-center mb-2';
      const code = document.createElement('code'); code.className = 'fs-5'; code.textContent = item.code;
      const badge = document.createElement('span');
      badge.className = 'badge ' + (item.isUsed ? 'bg-secondary' : 'bg-success');
      badge.textContent = item.isUsed ? 'مستخدم' : 'متاح (لسه ماتستخدمش)';
      head.appendChild(code); head.appendChild(badge);
      box.appendChild(head);
      box.appendChild(row('القيمة', item.amount + ' ج'));
      box.appendChild(row('تاريخ الإنشاء', fmt(item.createdAt)));
      box.appendChild(row('سنتر التوزيع', item.center ? item.center.name + (item.center.hasAccount ? ' (حساب: ' + item.center.username + ')' : ' (بدون حساب)') : 'غير مربوط بسنتر'));
      if (item.isUsed) {
        const u = item.usage || {};
        box.appendChild(row('طريقة الاستخدام', u.kind === 'registration' ? 'تسجيل طالب جديد بالكود' : u.kind === 'recharge' ? 'شحن رصيد من بوابة الطالب' : 'غير معروفة (مفيش حركة رصيد مسجلة)'));
        box.appendChild(row('وقت الاستخدام', fmt(u.at || item.updatedAt)));
        if (u.student) {
          const r = row('استخدمه الطالب', '');
          const link = document.createElement('a');
          link.href = '/students/' + u.student.id; link.textContent = u.student.name + ' (' + u.student.code + ')';
          r.lastChild.appendChild(link); box.appendChild(r);
          box.appendChild(row('تليفون الطالب', u.student.phone || '—'));
          box.appendChild(row('تليفون ولي الأمر', u.student.parentPhone || '—'));
          box.appendChild(row('رصيد الطالب الحالي', u.student.balance + ' ج'));
        } else {
          box.appendChild(row('الطالب', 'غير معروف'));
        }
      }
      return box;
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      out.textContent = 'جاري البحث...';
      try {
        const res = await fetch('/admin/recharge-codes/search?q=' + encodeURIComponent(input.value));
        const data = await res.json();
        out.textContent = '';
        if (!data.success) { out.textContent = data.message || 'حصلت مشكلة'; return; }
        if (!data.results.length) { out.textContent = data.message || 'مفيش كود بالشكل ده.'; return; }
        data.results.forEach((item) => out.appendChild(card(item)));
      } catch (err) { out.textContent = 'حصلت مشكلة أثناء البحث'; }
    });
  })();
</script>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3"><span class="ar-only">إنشاء حساب سنتر</span><span class="en-only" style="display:none;">Create Center Account</span></h6>
    <form action="/admin/recharge-codes/accounts" method="POST" class="row g-2 align-items-end">
      <div class="col-md-3"><label class="form-label small"><span class="ar-only">اسم السنتر الخارجي</span><span class="en-only" style="display:none;">External Center Name</span></label><input name="center_name" class="form-control" placeholder="اكتب اسم السنتر" required maxlength="150"></div>
      <div class="col-md-3"><label class="form-label small"><span class="ar-only">اسم المستخدم</span><span class="en-only" style="display:none;">Username</span></label><input name="username" class="form-control" required></div>
      <div class="col-md-3"><label class="form-label small"><span class="ar-only">كلمة المرور</span><span class="en-only" style="display:none;">Password</span></label><input name="password" type="password" class="form-control" required minlength="6"></div>
      <div class="col-md-3"><button class="btn btn-outline-primary w-100"><span class="ar-only">حفظ الحساب</span><span class="en-only" style="display:none;">Save Account</span></button></div>
    </form>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3"><span class="ar-only">ملخص مبيعات الأكواد حسب سنتر التوزيع</span><span class="en-only" style="display:none;">Code Sales Summary by Distribution Center</span></h6>
    <div class="table-responsive"><table class="table table-sm"><thead class="table-light"><tr><th><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></th><th><span class="ar-only">المستلم</span><span class="en-only" style="display:none;">Received</span></th><th><span class="ar-only">المستخدم</span><span class="en-only" style="display:none;">Used</span></th><th><span class="ar-only">المتاح</span><span class="en-only" style="display:none;">Available</span></th><th><span class="ar-only">قيمة المستخدم</span><span class="en-only" style="display:none;">Used Value</span></th><th><span class="ar-only">الحساب</span><span class="en-only" style="display:none;">Account</span></th></tr></thead><tbody>
      <% centerStats.forEach(item => { %><tr><td><%= item.center.name %></td><td><%= item.stats.receivedCount %></td><td><%= item.stats.usedCount %></td><td><%= item.stats.availableCount %></td><td><%= item.stats.usedAmount %> ج</td><td><%= item.account ? item.account.username : 'غير منشأ' %></td></tr><% }) %>
    </tbody></table></div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0"><span class="ar-only">كل أكواد الشحن</span><span class="en-only" style="display:none;">All Recharge Codes</span></h5>
  <form id="bulk-delete-form" action="/admin/recharge-codes/delete" method="POST" onsubmit="return prepareBulkDelete(event);">
    <button type="submit" class="btn btn-outline-danger">🗑️ <span class="ar-only">حذف المجموعات المحددة</span><span class="en-only" style="display:none;">Delete Selected Groups</span></button>
  </form>
</div>
<script>
  function prepareBulkDelete(event) {
    const form = event.currentTarget;
    form.querySelectorAll('input[name="code_ids"]').forEach(input => input.remove());
    const selectedGroups = document.querySelectorAll('.code-group-checkbox:checked');
    if (!selectedGroups.length) {
      alert('اختر مجموعة واحدة على الأقل');
      return false;
    }
    if (!confirm('هل أنت متأكد من حذف المجموعات المحددة؟')) return false;
    selectedGroups.forEach(group => {
      group.dataset.codeIds.split(',').forEach(codeId => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'code_ids';
        input.value = codeId;
        form.appendChild(input);
      });
    });
    return true;
  }
</script>
<% codesByCenter.forEach(group => { group.codes.forEach((codeGroup, groupIndex) => { %>
  <details class="card shadow-sm mb-4">
    <summary class="px-3 py-2 fw-semibold" style="cursor:pointer;">
      <input type="checkbox" class="code-group-checkbox me-2" data-code-ids="<%= codeGroup.map(c => c.id).join(',') %>" aria-label="تحديد مجموعة الأكواد" onclick="event.stopPropagation()">
      <span class="ar-only">سنتر التوزيع:</span><span class="en-only" style="display:none;">Distribution Center:</span> <%= group.center.name %> <span class="text-muted small">(<span class="ar-only">مجموعة</span><span class="en-only" style="display:none;">Group</span> <%= groupIndex + 1 %>)</span> <span class="text-muted small">- <%= codeGroup.length %> <span class="ar-only">أكواد</span><span class="en-only" style="display:none;">codes</span></span>
    </summary>
    <div class="card-body">
      <form action="/admin/recharge-codes/link" method="POST" class="row g-2 align-items-end mb-3">
        <% codeGroup.forEach(c => { %><input type="hidden" name="code_ids" value="<%= c.id %>"><% }) %>
        <div class="col-md-4">
          <label class="form-label small"><span class="ar-only">تغيير السنتر</span><span class="en-only" style="display:none;">Change Center</span></label>
          <select name="center_id" class="form-select">
            <option value=""><span class="ar-only">إزالة الربط</span><span class="en-only" style="display:none;">Remove Link</span></option>
            <% accountCenters.forEach(center => { %><option value="<%= center.id %>" <%= String(center.id) === String(group.center.id) ? 'selected' : '' %>><%= center.name %></option><% }) %>
          </select>
        </div>
        <div class="col-md-4"><label class="form-label small"><span class="ar-only">كلمة مرور الأدمن للتغيير</span><span class="en-only" style="display:none;">Admin Password to Change</span></label><input type="password" name="admin_password" class="form-control" required></div>
        <div class="col-md-4"><button class="btn btn-outline-danger w-100">🔐 <span class="ar-only">حفظ تغيير الربط</span><span class="en-only" style="display:none;">Save Link Change</span></button></div>
      </form>
      <form action="/admin/recharge-codes/delete" method="POST" class="mb-3" onsubmit="return confirm('هل أنت متأكد من حذف هذه المجموعة؟');">
        <% codeGroup.forEach(c => { %><input type="hidden" name="code_ids" value="<%= c.id %>"><% }) %>
        <button class="btn btn-outline-danger">🗑️ <span class="ar-only">حذف المجموعة</span><span class="en-only" style="display:none;">Delete Group</span></button>
      </form>
      <div class="table-responsive">
        <table class="table table-sm">
          <thead class="table-light">
            <tr><th><span class="ar-only">الكود</span><span class="en-only" style="display:none;">Code</span></th><th><span class="ar-only">القيمة</span><span class="en-only" style="display:none;">Value</span></th><th><span class="ar-only">الحالة</span><span class="en-only" style="display:none;">Status</span></th><th><span class="ar-only">تاريخ الإنشاء</span><span class="en-only" style="display:none;">Created Date</span></th></tr>
          </thead>
          <tbody>
            <% codeGroup.forEach(c => { %>
              <tr>
                <td><code><%= c.code %></code></td>
                <td><%= c.amount %> ج</td>
                <td><span class="badge <%= c.is_used ? 'bg-secondary' : 'bg-success' %>"><% if (c.is_used) { %><span class="ar-only">مستخدم</span><span class="en-only" style="display:none;">Used</span><% } else { %><span class="ar-only">متاح</span><span class="en-only" style="display:none;">Available</span><% } %></span></td>
                <td class="small text-muted"><%= new Date(c.createdAt).toLocaleString('ar-EG') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </details>
<% }) }) %>

<% if (unassignedGroups.length) { %>
  <% unassignedGroups.forEach((codeGroup, groupIndex) => { %>
  <details class="card shadow-sm mb-4">
    <summary class="px-3 py-2 fw-semibold" style="cursor:pointer;">
      <input type="checkbox" class="code-group-checkbox me-2" data-code-ids="<%= codeGroup.map(c => c.id).join(',') %>" aria-label="تحديد مجموعة الأكواد" onclick="event.stopPropagation()">
      <span class="ar-only">أكواد بدون سنتر توزيع</span><span class="en-only" style="display:none;">Codes with No Distribution Center</span> <span class="text-muted small">(<span class="ar-only">مجموعة</span><span class="en-only" style="display:none;">Group</span> <%= groupIndex + 1 %>)</span> <span class="text-muted small">- <%= codeGroup.length %> <span class="ar-only">أكواد</span><span class="en-only" style="display:none;">codes</span></span>
    </summary>
    <div class="card-body">
      <form action="/admin/recharge-codes/link" method="POST" class="row g-2 align-items-end mb-3">
        <% codeGroup.forEach(c => { %><input type="hidden" name="code_ids" value="<%= c.id %>"><% }) %>
        <div class="col-md-8">
          <label class="form-label small"><span class="ar-only">اختر السنتر لربط الأكواد</span><span class="en-only" style="display:none;">Choose the center to link the codes</span></label>
          <select name="center_id" class="form-select" required>
            <option value=""><span class="ar-only">اختر سنتر التوزيع</span><span class="en-only" style="display:none;">Choose the distribution center</span></option>
            <% accountCenters.forEach(center => { %><option value="<%= center.id %>"><%= center.name %></option><% }) %>
          </select>
        </div>
        <div class="col-md-4"><button class="btn btn-success w-100">🔗 <span class="ar-only">ربط المجموعة</span><span class="en-only" style="display:none;">Link Group</span></button></div>
      </form>
      <form action="/admin/recharge-codes/delete" method="POST" class="mb-3" onsubmit="return confirm('هل أنت متأكد من حذف هذه المجموعة؟');">
        <% codeGroup.forEach(c => { %><input type="hidden" name="code_ids" value="<%= c.id %>"><% }) %>
        <button class="btn btn-outline-danger">🗑️ <span class="ar-only">حذف المجموعة</span><span class="en-only" style="display:none;">Delete Group</span></button>
      </form>
      <div class="table-responsive">
        <table class="table table-sm">
          <thead class="table-light"><tr><th><span class="ar-only">الكود</span><span class="en-only" style="display:none;">Code</span></th><th><span class="ar-only">القيمة</span><span class="en-only" style="display:none;">Value</span></th><th><span class="ar-only">الحالة</span><span class="en-only" style="display:none;">Status</span></th><th><span class="ar-only">تاريخ الإنشاء</span><span class="en-only" style="display:none;">Created Date</span></th></tr></thead>
          <tbody>
            <% codeGroup.forEach(c => { %>
              <tr><td><code><%= c.code %></code></td><td><%= c.amount %> ج</td><td><span class="badge <%= c.is_used ? 'bg-secondary' : 'bg-success' %>"><% if (c.is_used) { %><span class="ar-only">مستخدم</span><span class="en-only" style="display:none;">Used</span><% } else { %><span class="ar-only">متاح</span><span class="en-only" style="display:none;">Available</span><% } %></span></td><td class="small text-muted"><%= new Date(c.createdAt).toLocaleString('ar-EG') %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </details>
  <% }) %>
<% } %>

<%- include('partials/footer') %>