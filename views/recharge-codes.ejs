<%- include('partials/header') %>

<h3 class="mb-4">🎫 أكواد الشحن</h3>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3">توليد أكواد جديدة</h6>
    <form action="/admin/recharge-codes/generate" method="POST" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small">قيمة الكود (ج)</label>
        <input type="number" name="amount" class="form-control" placeholder="مثال: 200" required min="1">
      </div>
      <div class="col-md-3">
        <label class="form-label small">عدد الأكواد</label>
        <input type="text" class="form-control" value="10 أكواد ثابتة" disabled>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">⚡ Generate + تحميل Excel</button>
      </div>
    </form>
    <p class="text-muted small mt-2">⚠️ كل ضغطة تنشئ 10 أكواد بدون سنتر، ثم يمكنك ربط المجموعة بسنتر واحد.</p>
    <form id="batch-generate-form" class="row g-2 align-items-end mt-3">
      <div class="col-md-3">
        <label class="form-label small">عدد الملفات</label>
        <input type="number" name="file_count" class="form-control" placeholder="مثال: 5" required min="1" max="50">
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary w-100">📁 توليد عدة ملفات</button>
      </div>
    </form>
    <script>
      document.getElementById('batch-generate-form').addEventListener('submit', async function (event) {
        event.preventDefault();
        const form = event.currentTarget;
        const count = Number(form.file_count.value);
        const amount = form.closest('.card-body').querySelector('input[name="amount"]').value;
        const button = form.querySelector('button');
        if (!amount || !count || count < 1 || count > 50) return;

        button.disabled = true;
        const originalText = button.textContent;
        try {
          button.textContent = `جاري توليد ${count} ملف`;
          const response = await fetch('/admin/recharge-codes/generate-batch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ amount, file_count: count }),
          });
          if (!response.ok) throw new Error('فشل توليد الملفات');
          const blob = await response.blob();
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `recharge_codes_${Date.now()}.zip`;
          link.click();
          URL.revokeObjectURL(url);
        } catch (error) {
          alert(error.message);
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      });
    </script>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3">إنشاء حساب سنتر</h6>
    <form action="/admin/recharge-codes/accounts" method="POST" class="row g-2 align-items-end">
      <div class="col-md-3"><label class="form-label small">اسم السنتر الخارجي</label><input name="center_name" class="form-control" placeholder="اكتب اسم السنتر" required maxlength="150"></div>
      <div class="col-md-3"><label class="form-label small">اسم المستخدم</label><input name="username" class="form-control" required></div>
      <div class="col-md-3"><label class="form-label small">كلمة المرور</label><input name="password" type="password" class="form-control" required minlength="6"></div>
      <div class="col-md-3"><button class="btn btn-outline-primary w-100">حفظ الحساب</button></div>
    </form>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3">ملخص مبيعات الأكواد حسب سنتر التوزيع</h6>
    <div class="table-responsive"><table class="table table-sm"><thead class="table-light"><tr><th>السنتر</th><th>المستلم</th><th>المستخدم</th><th>المتاح</th><th>قيمة المستخدم</th><th>الحساب</th></tr></thead><tbody>
      <% centerStats.forEach(item => { %><tr><td><%= item.center.name %></td><td><%= item.stats.receivedCount %></td><td><%= item.stats.usedCount %></td><td><%= item.stats.availableCount %></td><td><%= item.stats.usedAmount %> ج</td><td><%= item.account ? item.account.username : 'غير منشأ' %></td></tr><% }) %>
    </tbody></table></div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0">كل أكواد الشحن</h5>
  <form id="bulk-delete-form" action="/admin/recharge-codes/delete" method="POST" onsubmit="return prepareBulkDelete(event);">
    <button type="submit" class="btn btn-outline-danger">🗑️ حذف المجموعات المحددة</button>
  </form>
</div>
<script>
  function prepareBulkDelete(event) {
    const form = event.currentTarget;
    form.querySelectorAll('input[name="code_ids"]').forEach(input => input.remove());
    const selectedGroups = document.querySelectorAll('.code-group-checkbox:checked');
    if (!selectedGroups.length) {
      alert('اختر مجموعة واحدة على الأقل');
      return false;
    }
    if (!confirm('هل أنت متأكد من حذف المجموعات المحددة؟')) return false;
    selectedGroups.forEach(group => {
      group.dataset.codeIds.split(',').forEach(codeId => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'code_ids';
        input.value = codeId;
        form.appendChild(input);
      });
    });
    return true;
  }
</script>
<% codesByCenter.forEach(group => { group.codes.forEach((codeGroup, groupIndex) => { %>
  <details class="card shadow-sm mb-4">
    <summary class="px-3 py-2 fw-semibold" style="cursor:pointer;">
      <input type="checkbox" class="code-group-checkbox me-2" data-code-ids="<%= codeGroup.map(c => c.id).join(',') %>" aria-label="تحديد مجموعة الأكواد" onclick="event.stopPropagation()">
      سنتر التوزيع: <%= group.center.name %> <span class="text-muted small">(مجموعة <%= groupIndex + 1 %>)</span> <span class="text-muted small">- <%= codeGroup.length %> أكواد</span>
    </summary>
    <div class="card-body">
      <form action="/admin/recharge-codes/link" method="POST" class="row g-2 align-items-end mb-3">
        <% codeGroup.forEach(c => { %><input type="hidden" name="code_ids" value="<%= c.id %>"><% }) %>
        <div class="col-md-4">
          <label class="form-label small">تغيير السنتر</label>
          <select name="center_id" class="form-select">
            <option value="">إزالة الربط</option>
            <% accountCenters.forEach(center => { %><option value="<%= center.id %>" <%= String(center.id) === String(group.center.id) ? 'selected' : '' %>><%= center.name %></option><% }) %>
          </select>
        </div>
        <div class="col-md-4"><label class="form-label small">كلمة مرور الأدمن للتغيير</label><input type="password" name="admin_password" class="form-control" required></div>
        <div class="col-md-4"><button class="btn btn-outline-danger w-100">🔐 حفظ تغيير الربط</button></div>
      </form>
      <form action="/admin/recharge-codes/delete" method="POST" class="mb-3" onsubmit="return confirm('هل أنت متأكد من حذف هذه المجموعة؟');">
        <% codeGroup.forEach(c => { %><input type="hidden" name="code_ids" value="<%= c.id %>"><% }) %>
        <button class="btn btn-outline-danger">🗑️ حذف المجموعة</button>
      </form>
      <div class="table-responsive">
        <table class="table table-sm">
          <thead class="table-light">
            <tr><th>الكود</th><th>القيمة</th><th>الحالة</th><th>تاريخ الإنشاء</th></tr>
          </thead>
          <tbody>
            <% codeGroup.forEach(c => { %>
              <tr>
                <td><code><%= c.code %></code></td>
                <td><%= c.amount %> ج</td>
                <td><span class="badge <%= c.is_used ? 'bg-secondary' : 'bg-success' %>"><%= c.is_used ? 'مستخدم' : 'متاح' %></span></td>
                <td class="small text-muted"><%= new Date(c.createdAt).toLocaleString('ar-EG') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </details>
<% }) }) %>

<% if (unassignedGroups.length) { %>
  <% unassignedGroups.forEach((codeGroup, groupIndex) => { %>
  <details class="card shadow-sm mb-4">
    <summary class="px-3 py-2 fw-semibold" style="cursor:pointer;">
      <input type="checkbox" class="code-group-checkbox me-2" data-code-ids="<%= codeGroup.map(c => c.id).join(',') %>" aria-label="تحديد مجموعة الأكواد" onclick="event.stopPropagation()">
      أكواد بدون سنتر توزيع <span class="text-muted small">(مجموعة <%= groupIndex + 1 %>)</span> <span class="text-muted small">- <%= codeGroup.length %> أكواد</span>
    </summary>
    <div class="card-body">
      <form action="/admin/recharge-codes/link" method="POST" class="row g-2 align-items-end mb-3">
        <% codeGroup.forEach(c => { %><input type="hidden" name="code_ids" value="<%= c.id %>"><% }) %>
        <div class="col-md-8">
          <label class="form-label small">اختر السنتر لربط الأكواد</label>
          <select name="center_id" class="form-select" required>
            <option value="">اختر سنتر التوزيع</option>
            <% accountCenters.forEach(center => { %><option value="<%= center.id %>"><%= center.name %></option><% }) %>
          </select>
        </div>
        <div class="col-md-4"><button class="btn btn-success w-100">🔗 ربط المجموعة</button></div>
      </form>
      <form action="/admin/recharge-codes/delete" method="POST" class="mb-3" onsubmit="return confirm('هل أنت متأكد من حذف هذه المجموعة؟');">
        <% codeGroup.forEach(c => { %><input type="hidden" name="code_ids" value="<%= c.id %>"><% }) %>
        <button class="btn btn-outline-danger">🗑️ حذف المجموعة</button>
      </form>
      <div class="table-responsive">
        <table class="table table-sm">
          <thead class="table-light"><tr><th>الكود</th><th>القيمة</th><th>الحالة</th><th>تاريخ الإنشاء</th></tr></thead>
          <tbody>
            <% codeGroup.forEach(c => { %>
              <tr><td><code><%= c.code %></code></td><td><%= c.amount %> ج</td><td><span class="badge <%= c.is_used ? 'bg-secondary' : 'bg-success' %>"><%= c.is_used ? 'مستخدم' : 'متاح' %></span></td><td class="small text-muted"><%= new Date(c.createdAt).toLocaleString('ar-EG') %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </details>
  <% }) %>
<% } %>

<%- include('partials/footer') %>