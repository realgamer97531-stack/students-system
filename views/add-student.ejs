<%- include('partials/header') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h3 class="text-primary mb-3">➕ تسجيل طالب جديد</h3>
          <p class="text-muted mb-4">أدخل بيانات الطالب وسيتم حفظها في النظام.</p>

          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert alert-danger"><%= errorMessage %></div>
          <% } %>

          <form action="/students" method="POST" id="addStudentForm">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">اسم الطالب</label>
                <input type="text" name="name" class="form-control" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">تليفون الطالب</label>
                <input type="text" name="phone" class="form-control" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">تليفون ولي الأمر</label>
                <input type="text" name="parent_phone" class="form-control" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">سعر الحصة (ج)</label>
                <input type="number" name="price_per_session" id="priceInput" class="form-control" min="0" step="0.01" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">الرصيد الابتدائي</label>
                <input type="number" name="balance" class="form-control" min="0" step="0.01" value="0">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">المادة</label>
                <select name="subject_id" id="subjectSelect" class="form-select" required>
                  <% (subjects || []).forEach(subj => { 
                       const nameStr = (subj.name || '').toString().trim().toLowerCase();
                       // Only Math Senior 1 => 80, everything else => 90
                       const _def = nameStr === 'math senior 1' ? 80 : 90;
                  %>
                    <option value="<%= subj.id %>" data-price="<%= _def %>"><%= subj.name %></option>
                  <% }) %>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">السنتر</label>
                <select name="center_id" class="form-select" required>
                  <% (centers || []).forEach(center => { %>
                    <option value="<%= center.id %>"><%= center.name %></option>
                  <% }) %>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">مبلغ بوكليت مدفوع</label>
                <input type="number" name="booklet_paid_amount" class="form-control" min="0" step="0.01" value="0">
              </div>

              <div class="col-12">
                <label class="form-label fw-semibold">💬 كومنت الحضور (اختياري)</label>
                <input type="text" name="comment" class="form-control" placeholder="ملاحظة...">
              </div>
            </div>

            <div class="row g-3 mt-1">
              <div class="col-md-6">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" name="booklet_status" value="on" id="bookletStatus">
                  <label class="form-check-label fw-semibold" for="bookletStatus">يوجد بوكليت</label>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" name="register_attendance" value="on" id="registerAttendance">
                  <label class="form-check-label fw-semibold" for="registerAttendance">تسجيل حضور في الحصة الحالية</label>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <button type="submit" class="btn btn-primary fw-bold px-4">💾 حفظ الطالب</button>
              <a href="/students" class="btn btn-outline-secondary ms-2">إلغاء</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

<script>
// Simple mapping of grade names to default prices. Update keys to match subject names.
const gradePriceMap = {
  'senior 1': 80,
  'senior 2': 90,
  'senior 3': 90,
};

function findDefaultPriceForSubject(subjectName) {
  if (!subjectName) return null;
  const key = subjectName.toString().toLowerCase();
  return gradePriceMap[key] || null;
}

document.addEventListener('DOMContentLoaded', () => {
  const subjectSelect = document.getElementById('subjectSelect');
  const priceInput = document.getElementById('priceInput');
  const form = document.getElementById('addStudentForm');
  const submitButton = form.querySelector('button[type="submit"]');
  const phoneField = form.querySelector('input[name="phone"]');
  const parentField = form.querySelector('input[name="parent_phone"]');
  let isSubmitting = false;

  function updatePriceFromSubject() {
    const opt = subjectSelect.options[subjectSelect.selectedIndex];
    const dataPrice = opt ? opt.dataset.price : '';
    if (dataPrice && (!priceInput.value || priceInput.value === '0')) {
      priceInput.value = dataPrice;
      return;
    }
    // fallback to name-based map
    const text = opt ? opt.text : '';
    const def = findDefaultPriceForSubject(text);
    if (def !== null && (!priceInput.value || priceInput.value === '0')) {
      priceInput.value = def;
    }
  }

  subjectSelect.addEventListener('change', updatePriceFromSubject);
  updatePriceFromSubject();

  function isPhoneValid(v) {
    if (!v) return false;
    const digits = v.toString().replace(/[^0-9]/g, '');
    return digits.length === 11;
  }

  form.addEventListener('submit', (e) => {
    if (isSubmitting) {
      e.preventDefault();
      return;
    }

    const phone = phoneField.value.trim();
    const parent = parentField.value.trim();

    if (!isPhoneValid(phone) || !isPhoneValid(parent)) {
      e.preventDefault();
      const pwd = prompt('أرقام التليفون ليست صحيحة. ادخل كلمة المرور الإدارية للموافقة على المتابعة:');
      if (pwd && pwd.trim().length > 0) {
        let hidden = form.querySelector('input[name="admin_password"]');
        if (!hidden) {
          hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'admin_password';
          form.appendChild(hidden);
        }
        hidden.value = pwd.trim();
        isSubmitting = true;
        submitButton.disabled = true;
        form.submit();
      } else {
        alert('لم تُدخل كلمة المرور الإدارية. تم إلغاء الإضافة.');
      }
      return false;
    }

    isSubmitting = true;
    submitButton.disabled = true;
  });
});
</script>