<%- include('partials/header') %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
  <h3 class="mb-0"><%= exam.name %></h3>
  <a href="/exams" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-right"></i> <span class="ar-only">كل الامتحانات</span><span class="en-only" style="display:none;">All exams</span></a>
</div>
<div class="sf-chip-row mb-3">
  <span class="badge bg-primary fs-6"><span class="ar-only">من</span><span class="en-only" style="display:none;">out of</span> <%= exam.max_score %></span>
  <%- sf.subject(exam.Subject || exam.SubjectId) %>
  <% if (exam.Session) { %>
    <%- sf.session(exam.Session) %>
    <span class="badge bg-light text-dark border"><span class="ar-only">سيريال</span><span class="en-only" style="display:none;">Serial</span> <bdi dir="ltr"><%= exam.Session.serial_number %></bdi></span>
    <span class="badge bg-light text-dark border"><bdi dir="ltr"><%= exam.Session.session_date %></bdi></span>
  <% } else { %>
    <span class="badge bg-info text-dark"><span class="ar-only">مستقل</span><span class="en-only" style="display:none;">Independent</span></span>
  <% } %>
  <span class="badge bg-light text-dark border"><i class="bi bi-calendar-check"></i> <bdi dir="ltr"><%= exam.exam_date %></bdi></span>
</div>
<% if (exam.SessionId && exam.Session) { %>
  <p class="text-muted small">⚠️ <span class="ar-only">ظاهر هنا بس الطلاب اللي سجلوا حضورهم في حصة</span><span class="en-only" style="display:none;">Only students who actually attended session</span> <%= exam.Session.lesson_number %> <span class="ar-only">فعليًا.</span><span class="en-only" style="display:none;">are shown here.</span></p>
<% } %>
<input type="text" id="searchBox" class="form-control mb-3" placeholder="🔍 بحث بالاسم أو الكود...">

<form action="/exams/<%= exam.id %>/scores" method="POST">
  <div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table align-middle" id="studentsTable">
      <thead class="table-light">
        <tr>
          <th><span class="ar-only">الكود</span><span class="en-only" style="display:none;">Code</span></th>
          <th><span class="ar-only">اسم الطالب</span><span class="en-only" style="display:none;">Student Name</span></th>
          <th><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></th>
          <th><span class="ar-only">الدرجة</span><span class="en-only" style="display:none;">Score</span></th>
        </tr>
      </thead>
      <tbody>
        <% students.forEach(student => { %>
          <tr data-search="<%= (student.name + ' ' + student.student_code).toLowerCase() %>">
            <td><%= student.student_code %></td>
            <td><%= student.name %></td>
            <td><%= student.Center ? student.Center.name : 'غير محدد' %></td>
            <td>
              <input
                type="number"
                step="0.5"
                name="score_<%= student.id %>"
                class="form-control"
                style="max-width: 120px;"
                value="<%= existingScores[student.id] !== undefined ? existingScores[student.id] : '' %>"
                max="<%= exam.max_score %>"
                min="0">
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <button type="submit" class="btn btn-success mt-3"><span class="ar-only">حفظ كل الدرجات</span><span class="en-only" style="display:none;">Save All Scores</span></button>
</form>

<script>
  document.getElementById('searchBox').addEventListener('input', function () {
    const term = this.value.toLowerCase().trim();
    document.querySelectorAll('#studentsTable tbody tr').forEach(row => {
      const match = row.dataset.search.includes(term);
      row.style.display = match ? '' : 'none';
    });
  });
</script>

<%- include('partials/footer') %>