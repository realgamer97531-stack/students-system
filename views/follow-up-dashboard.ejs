<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
  <div>
    <h3 class="mb-1">🎯 <span class="ar-only">لوحة متابعة الطلاب</span><span class="en-only" style="display:none;">Student Follow-up Dashboard</span></h3>
    <p class="text-muted small mb-0">
      <%= filters.show_all ? (students.length + ' طالب') : (students.length + ' طالب مُسند إليك') %>
      <% if (selectedSession) { %> | <span class="ar-only">حصة رقم</span><span class="en-only" style="display:none;">Session #</span> <%= selectedSession.lesson_number %> - <%= selectedSession.Subject?.name %> - <%= selectedSession.Center?.name %><% } %>
    </p>
  </div>

  <!-- اختيار الحصة -->
  <div class="d-flex gap-2 align-items-center flex-wrap">
    <form method="GET" class="d-flex gap-2 flex-wrap">
      <select name="session_id" class="form-select session-select" style="max-width: 350px;">
        <option value=""><span class="ar-only">-- اختر الحصة --</span><span class="en-only" style="display:none;">-- Select Session --</span></option>
        <% sessions.forEach(s => { %>
          <option value="<%= s.id %>" <%= String(s.id) === String(filters.session_id) ? 'selected':'' %>>
            <%= s.Subject?.name %> - <%= s.Center?.name %> (<span class="ar-only">حصة</span><span class="en-only" style="display:none;">Session</span> <%= s.lesson_number %>)
          </option>
        <% }) %>
      </select>
    </form>
    <% const exportQuery = new URLSearchParams({ session_id: filters.session_id || '', show_all: filters.show_all || '', show_attended: filters.show_attended || '', show_only_attended: filters.show_only_attended || '', center_id: filters.center_id || '', subject_id: filters.subject_id || '', filter_video_type: filters.filter_video_type || '', filter_video_max: filters.filter_video_max || '', filter_hw_status: filters.filter_hw_status || '', filter_exam_max: filters.filter_exam_max || '', filter_missing_exam: filters.filter_missing_exam || '' }).toString(); %>
    <a href="/follow-up-dashboard/export?<%= exportQuery %>" class="btn btn-success btn-sm">📥 <span class="ar-only">تصدير</span><span class="en-only" style="display:none;">Export</span> Excel</a>
    <% if (callCenterIntegrationEnabled && selectedSession && sessionRows.length > 0) { %>
      <button type="button" id="sendFollowUpToCallcenter" class="btn btn-outline-primary btn-sm">☎️ <span class="ar-only">إرسال الظاهرين للاتصال</span><span class="en-only" style="display:none;">Send Visible to Call Center</span></button>
      <span id="followUpCallcenterStatus" class="small text-muted"></span>
    <% } %>
  </div>
</div>

<% if (callCenterIntegrationEnabled && selectedSession) { %>
  <script type="application/json" id="followUpCallcenterConfig"><%- JSON.stringify({
    token: followUpSelectionToken,
    filters: {
      filter_video_type: filters.filter_video_type || '',
      filter_video_max: filters.filter_video_max || '',
      filter_hw_status: filters.filter_hw_status || '',
      filter_exam_max: filters.filter_exam_max || '',
      filter_missing_exam: filters.filter_missing_exam || '',
      session_id: filters.session_id || selectedSession.id,
      show_all: filters.show_all || '',
      show_attended: filters.show_attended || '',
      show_only_attended: filters.show_only_attended || '',
      center_id: filters.center_id || '',
      subject_id: filters.subject_id || ''
    }
  }).replace(/</g, '\\u003c') %></script>
<% } %>

<div class="mb-3">
  <input type="search" id="studentSearch" class="form-control" placeholder="🔍 بحث باسم الطالب أو الكود...">
</div>

<!-- الفلاتر -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <input type="hidden" name="session_id" value="<%= filters.session_id %>">
      <input type="hidden" name="show_all" value="<%= filters.show_all || '' %>">
      <input type="hidden" name="show_attended" value="<%= filters.show_attended || '' %>">
      <input type="hidden" name="show_only_attended" value="<%= filters.show_only_attended || '' %>">
      <div class="col-md-2">
        <label class="form-label small fw-bold"><span class="ar-only">نوع الفيديو</span><span class="en-only" style="display:none;">Video Type</span></label>
        <select name="filter_video_type" class="form-select form-select-sm">
          <option value="explanation" <%= filters.filter_video_type==='explanation'?'selected':'' %>><span class="ar-only">شرح</span><span class="en-only" style="display:none;">Explanation</span></option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold"><span class="ar-only">أقل من (دقيقة)</span><span class="en-only" style="display:none;">Less than (minutes)</span></label>
        <input type="number" name="filter_video_max" class="form-control form-control-sm" value="<%= filters.filter_video_max || '' %>" placeholder="مثال: 5">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold"><span class="ar-only">حالة الواجب</span><span class="en-only" style="display:none;">Homework Status</span></label>
        <select name="filter_hw_status" class="form-select form-select-sm">
          <option value=""><span class="ar-only">الكل</span><span class="en-only" style="display:none;">All</span></option>
          <option value="complete" <%= filters.filter_hw_status==='complete'?'selected':'' %>><span class="ar-only">كامل</span><span class="en-only" style="display:none;">Complete</span></option>
          <option value="incomplete" <%= filters.filter_hw_status==='incomplete'?'selected':'' %>><span class="ar-only">مش كامل</span><span class="en-only" style="display:none;">Incomplete</span></option>
          <option value="no_steps" <%= filters.filter_hw_status==='no_steps'?'selected':'' %>><span class="ar-only">من غير خطوات</span><span class="en-only" style="display:none;">No Steps</span></option>
          <option value="not_done" <%= filters.filter_hw_status==='not_done'?'selected':'' %>><span class="ar-only">مش معمول</span><span class="en-only" style="display:none;">Not Done</span></option>
          <option value="not_checked" <%= filters.filter_hw_status==='not_checked'?'selected':'' %>><span class="ar-only">لم يصحح</span><span class="en-only" style="display:none;">Not Checked</span></option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold"><span class="ar-only">درجة الامتحان أقل من</span><span class="en-only" style="display:none;">Exam Score Less Than</span></label>
        <input type="number" name="filter_exam_max" class="form-control form-control-sm" value="<%= filters.filter_exam_max || '' %>" placeholder="مثال: 50">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold"><span class="ar-only">لم يمتحن (امتحان مستقل)</span><span class="en-only" style="display:none;">Missed Standalone Exam</span></label>
        <select name="filter_missing_exam" class="form-select form-select-sm">
          <option value=""><span class="ar-only">-- بدون --</span><span class="en-only" style="display:none;">-- None --</span></option>
          <% (typeof unlinkedExams !== 'undefined' ? unlinkedExams : []).forEach(exam => { %>
            <option value="<%= exam.id %>" <%= String(exam.id) === String(filters.filter_missing_exam) ? 'selected':'' %>><%= exam.name %><%= exam.exam_date ? ` (${exam.exam_date})` : '' %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold"><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></label>
        <select name="center_id" class="form-select form-select-sm">
          <option value=""><span class="ar-only">الكل</span><span class="en-only" style="display:none;">All</span></option>
          <% (centers || []).forEach(c => { %>
            <option value="<%= c.id %>" <%= String(c.id) === String(filters.center_id) ? 'selected':'' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold"><span class="ar-only">المادة</span><span class="en-only" style="display:none;">Subject</span></label>
        <select name="subject_id" class="form-select form-select-sm">
          <option value=""><span class="ar-only">الكل</span><span class="en-only" style="display:none;">All</span></option>
          <% (subjects || []).forEach(s => { %>
            <option value="<%= s.id %>" <%= String(s.id) === String(filters.subject_id) ? 'selected':'' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold"><span class="ar-only">عرض كل الطلاب</span><span class="en-only" style="display:none;">Show All Students</span></label>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="showAllCheckbox" <%= filters.show_all ? 'checked':'' %> >
          <label class="form-check-label small" for="showAllCheckbox"><span class="ar-only">اظهار جميع الطلاب</span><span class="en-only" style="display:none;">Show All Students</span></label>
        </div>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold"><span class="ar-only">عرض الحاضرين</span><span class="en-only" style="display:none;">Show Attendees</span></label>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="showAttendedCheckbox" <%= filters.show_attended ? 'checked':'' %> >
          <label class="form-check-label small" for="showAttendedCheckbox"><span class="ar-only">إظهار الحاضرين</span><span class="en-only" style="display:none;">Show Attendees</span></label>
        </div>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold"><span class="ar-only">الحضور فقط</span><span class="en-only" style="display:none;">Attendance Only</span></label>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="showOnlyAttendedCheckbox" <%= filters.show_only_attended ? 'checked':'' %> >
          <label class="form-check-label small" for="showOnlyAttendedCheckbox"><span class="ar-only">إظهار الحضور بدون الغياب</span><span class="en-only" style="display:none;">Show Attendance Without Absence</span></label>
        </div>
      </div>
      <div class="col-md-2">
        <button class="btn btn-primary btn-sm w-100"><span class="ar-only">تطبيق</span><span class="en-only" style="display:none;">Apply</span></button>
      </div>
      <div class="col-md-2">
        <a href="/follow-up-dashboard?session_id=<%= filters.session_id %>" class="btn btn-outline-secondary btn-sm w-100"><span class="ar-only">إلغاء الفلاتر</span><span class="en-only" style="display:none;">Clear Filters</span></a>
      </div>
    </form>
  </div>
</div>

<% const hwLabels = { complete:'✅ كامل', incomplete:'⚠️ مش كامل', no_steps:'📝 بلا خطوات', not_done:'❌ مش معمول' }; %>
<% const hwColors = { complete:'var(--sf-success-soft-bg)', incomplete:'var(--sf-warning-soft-bg)', no_steps:'var(--sf-neutral-soft-bg)', not_done:'var(--sf-danger-soft-bg)' }; %>
<% const hwTextColors = { complete:'var(--sf-success-soft-text)', incomplete:'var(--sf-warning-soft-text)', no_steps:'var(--sf-neutral-soft-text)', not_done:'var(--sf-danger-soft-text)' }; %>
<% const _hasFilters = (typeof hasFilters !== 'undefined') ? hasFilters : false; %>

<% if (_hasFilters) { %>
  <div class="alert alert-info small mb-3">🔍 <span class="ar-only">يظهر</span><span class="en-only" style="display:none;">Showing</span> <%= sessionRows.length %> <span class="ar-only">طالب بعد تطبيق الفلاتر</span><span class="en-only" style="display:none;">student(s) after applying filters</span>
    <% if (typeof missingExam !== 'undefined' && missingExam) { %>
      <br>📝 <span class="ar-only">طلاب ملهمش درجة متسجلة في امتحان:</span><span class="en-only" style="display:none;">Students with no recorded score in exam:</span> <strong><%= missingExam.name %></strong>
    <% } %>
  </div>
<% } %>

<!-- جدول الطلاب -->
<% if (!selectedSession && students && students.length > 0) { %>
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h6 class="mb-3"><span class="ar-only">الطلاب المسندين إليك</span><span class="en-only" style="display:none;">Students Assigned to You</span> (<%= students.length %>)</h6>
      <div class="row g-2">
        <% students.forEach(s => { %>
          <div class="col-md-3 follow-up-search-item" data-search="<%= `${s.name} ${s.student_code}`.toLowerCase() %>">
            <div class="p-2 rounded" style="background:var(--sf-primary-light);">
              <div class="small fw-bold"><%= s.name %></div>
              <div style="font-size:0.7rem;color:var(--sf-muted);"><%= s.student_code %></div>
              <div style="font-size:0.7rem;color:var(--sf-muted);"><%= s.Center?.name %> | <%= s.Subject?.name %></div>
              <a href="/follow-up-dashboard/student/<%= s.id %>" class="btn btn-sm mt-1" style="font-size:0.65rem;padding:2px 8px;background:var(--sf-primary);color:#fff;"><span class="ar-only">عرض الملف</span><span class="en-only" style="display:none;">View Profile</span></a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
<% } else if (selectedSession && sessionRows.length > 0) { %>
  <div class="card shadow-sm mb-4">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th style="width:50px;">#</th>
            <th style="width:180px;"><span class="ar-only">الطالب</span><span class="en-only" style="display:none;">Student</span></th>
            <th><span class="ar-only">تليفون الطالب</span><span class="en-only" style="display:none;">Student Phone</span></th>
            <th><span class="ar-only">تليفون ولي الأمر</span><span class="en-only" style="display:none;">Parent Phone</span></th>
            <th><span class="ar-only">الحضور</span><span class="en-only" style="display:none;">Attendance</span></th>
            <th><span class="ar-only">الواجب</span><span class="en-only" style="display:none;">Homework</span></th>
            <th><span class="ar-only">الامتحان</span><span class="en-only" style="display:none;">Exam</span></th>
            <th>📖 <span class="ar-only">شرح</span><span class="en-only" style="display:none;">Explanation</span></th>
            <th>❓ <span class="ar-only">أسئلة</span><span class="en-only" style="display:none;">Questions</span></th>
            <th>✅ <span class="ar-only">واجب</span><span class="en-only" style="display:none;">Homework</span></th>
            <th><span class="ar-only">كومنت</span><span class="en-only" style="display:none;">Comment</span></th>
            <th><span class="ar-only">كومنت</span><span class="en-only" style="display:none;">Comment</span> Call Center</th>
          </tr>
        </thead>
        <tbody>
          <% sessionRows.forEach((row, index) => { %>
            <tr class="follow-up-search-item" data-student-id="<%= row.student.id %>" data-search="<%= `${row.student.name} ${row.student.student_code}`.toLowerCase() %>">
              <td><%= index + 1 %></td>
              <td>
                <a href="/follow-up-dashboard/student/<%= row.student.id %>" class="fw-bold d-block"><%= row.student.name %></a>
                <span class="text-muted" style="font-size:0.7rem;"><%= row.student.student_code %></span><br>
                <span class="text-muted" style="font-size:0.65rem;"><%= row.student.Center?.name %> | <%= row.student.Subject?.name %></span>
              </td>
              <td><%= row.student.phone || '-' %></td>
              <td><%= row.student.parent_phone || '-' %></td>
              <td>
                <% if (row.attended) { %>
                  <span class="badge" style="background:var(--sf-success-soft-bg);color:var(--sf-success-soft-text);">✓ <%= row.attendedWhere %></span>
                  <% if (row.attendanceTime) { %><br><span style="font-size:0.65rem;color:var(--sf-muted);"><%= new Date(row.attendanceTime).toLocaleTimeString('ar-EG', {hour:'2-digit',minute:'2-digit'}) %></span><% } %>
                <% } else { %>
                  <span class="badge" style="background:var(--sf-danger-soft-bg);color:var(--sf-danger-soft-text);"><span class="ar-only">غائب</span><span class="en-only" style="display:none;">Absent</span></span>
                <% } %>
              </td>
              <td>
                <% if (row.hwStatus) { %>
                  <span class="badge" style="background:<%= hwColors[row.hwStatus] %>;color:<%= hwTextColors[row.hwStatus] %>;font-size:0.7rem;"><%= hwLabels[row.hwStatus] %></span>
                <% } else { %><span class="text-muted small">-</span><% } %>
              </td>
              <td>
                <% if (row.examScore !== null) { %>
                  <span class="fw-bold" style="color:<%= (row.examScore/row.examMax*100)>=60?'var(--sf-success-soft-text)':'var(--sf-danger-soft-text)' %>;">
                    <%= row.examScore %>/<%= row.examMax %>
                  </span>
                <% } else { %><span class="text-muted small">-</span><% } %>
              </td>
              <td>
                <% const expMin = Math.floor((row.videoWatch.explanation||0)/60); %>
                <% const expTotal = Math.floor((row.videoWatch.explanationTotal||0)/60); %>
                <% if (expTotal > 0) { %>
                  <span style="color:<%= expMin/expTotal>=0.7?'var(--sf-success-soft-text)':'var(--sf-warning-soft-text)' %>;font-size:0.8rem;font-weight:600;"><%= expMin %>/<%= expTotal %>د</span>
                <% } else { %><span class="text-muted small">-</span><% } %>
              </td>
              <td>
                <% const qMin = Math.floor((row.videoWatch.questions||0)/60); %>
                <% const qTotal = Math.floor((row.videoWatch.questionsTotal||0)/60); %>
                <% if (qTotal > 0) { %>
                  <span style="color:<%= qMin/qTotal>=0.7?'var(--sf-success-soft-text)':'var(--sf-warning-soft-text)' %>;font-size:0.8rem;font-weight:600;"><%= qMin %>/<%= qTotal %>د</span>
                <% } else { %><span class="text-muted small">-</span><% } %>
              </td>
              <td>
                <% const hwMin = Math.floor((row.videoWatch.homework_solution||0)/60); %>
                <% const hwTotal = Math.floor((row.videoWatch.hwTotal||0)/60); %>
                <% if (hwTotal > 0) { %>
                  <span style="color:<%= hwMin/hwTotal>=0.7?'var(--sf-success-soft-text)':'var(--sf-warning-soft-text)' %>;font-size:0.8rem;font-weight:600;"><%= hwMin %>/<%= hwTotal %>د</span>
                <% } else { %><span class="text-muted small">-</span><% } %>
              </td>
              <td style="min-width:160px;">
                <form action="/follow-up-dashboard/comment" method="POST" class="d-flex gap-1 follow-up-comment-form">
                  <input type="hidden" name="student_id" value="<%= row.student.id %>">
                  <input type="hidden" name="session_id" value="<%= selectedSession.id %>">
                  <input type="hidden" name="redirect_to" value="/follow-up-dashboard?session_id=<%= selectedSession.id %>">
                  <input type="text" name="comment" class="form-control form-control-sm" style="font-size:0.75rem;" value="<%= row.sessionComment || '' %>" placeholder="كومنت...">
                  <button class="btn btn-sm" style="padding:2px 8px;background:var(--sf-primary-light);color:var(--sf-primary);white-space:nowrap;font-size:0.7rem;"><span class="ar-only">حفظ</span><span class="en-only" style="display:none;">Save</span></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } else if (selectedSession) { %>
  <div class="alert alert-secondary"><span class="ar-only">لا يوجد طلاب مطابقين للفلاتر المختارة</span><span class="en-only" style="display:none;">No students match the selected filters</span></div>
<% } else { %>
  <div class="alert alert-secondary"><span class="ar-only">لا يوجد طلاب مسندين إليك حالياً</span><span class="en-only" style="display:none;">No students currently assigned to you</span></div>
<% } %>

<!-- قائمة الغائبين -->
<% if (absentStudents.length > 0 && !_hasFilters) { %>
<div class="card shadow-sm" style="border-right:4px solid var(--sf-danger);">
  <div class="card-body">
    <h6 class="mb-3">🔴 <span class="ar-only">الغائبون</span><span class="en-only" style="display:none;">Absentees</span> (<%= absentStudents.length %>)</h6>
    <div class="row g-2">
      <% absentStudents.forEach(row => { %>
          <div class="col-md-3 follow-up-search-item" data-search="<%= `${row.student.name} ${row.student.student_code}`.toLowerCase() %>">
          <div class="p-2 rounded" style="background:var(--sf-danger-soft-bg);">
            <div class="small fw-bold"><%= row.student.name %></div>
            <div style="font-size:0.7rem;color:var(--sf-muted);"><%= row.student.student_code %></div>
            <div style="font-size:0.7rem;color:var(--sf-muted);"><%= row.student.Center?.name %></div>
            <a href="/follow-up-dashboard/student/<%= row.student.id %>" class="btn btn-sm mt-1" style="font-size:0.65rem;padding:2px 8px;background:var(--sf-danger-soft-text);color:#fff;"><span class="ar-only">عرض الملف</span><span class="en-only" style="display:none;">View Profile</span></a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<% } %>

<script>
  // Auto-submit form when session is changed
  document.addEventListener('DOMContentLoaded', function() {
    const sessionSelect = document.querySelector('form.d-flex select[name="session_id"]');
    if (sessionSelect) {
      $(sessionSelect).on('change', function() {
        this.form.submit();
      });
    }
    const showAllCheckbox = document.getElementById('showAllCheckbox');
    const showAllHidden = document.querySelector('form.row input[name="show_all"]');
    if (showAllCheckbox && showAllHidden) {
      showAllCheckbox.addEventListener('change', () => {
        showAllHidden.value = showAllCheckbox.checked ? '1' : '';
      });
    }
    const showAttendedCheckbox = document.getElementById('showAttendedCheckbox');
    const showAttendedHidden = document.querySelector('form.row input[name="show_attended"]');
    if (showAttendedCheckbox && showAttendedHidden) {
      showAttendedCheckbox.addEventListener('change', () => {
        showAttendedHidden.value = showAttendedCheckbox.checked ? '1' : '';
      });
    }
    const showOnlyAttendedCheckbox = document.getElementById('showOnlyAttendedCheckbox');
    const showOnlyAttendedHidden = document.querySelector('form.row input[name="show_only_attended"]');
    if (showOnlyAttendedCheckbox && showOnlyAttendedHidden) {
      showOnlyAttendedCheckbox.addEventListener('change', () => {
        showOnlyAttendedHidden.value = showOnlyAttendedCheckbox.checked ? '1' : '';
      });
    }

    document.querySelectorAll('.follow-up-comment-form').forEach(form => {
      form.addEventListener('submit', async event => {
        event.preventDefault();
        const button = form.querySelector('button[type="submit"]');
        const originalText = button ? button.textContent : '';
        if (button) {
          button.disabled = true;
          button.textContent = 'جارٍ الحفظ...';
        }
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || 'تعذر حفظ الكومنت');
          if (button) {
            button.textContent = 'تم الحفظ';
            setTimeout(() => { button.textContent = originalText; }, 1200);
          }
        } catch (error) {
          if (button) button.textContent = 'فشل الحفظ';
          setTimeout(() => { if (button) button.textContent = originalText; }, 1600);
        } finally {
          if (button) button.disabled = false;
        }
      });
    });

    const studentSearch = document.getElementById('studentSearch');
    if (studentSearch) {
      studentSearch.addEventListener('input', () => {
        const term = studentSearch.value.trim().toLowerCase();
        document.querySelectorAll('.follow-up-search-item').forEach(item => {
          item.style.display = !term || item.dataset.search.includes(term) ? '' : 'none';
        });
      });
    }

    const callcenterButton = document.getElementById('sendFollowUpToCallcenter');
    const callcenterStatus = document.getElementById('followUpCallcenterStatus');
    const callcenterConfigElement = document.getElementById('followUpCallcenterConfig');
    if (callcenterButton && callcenterConfigElement) {
      const callcenterConfig = JSON.parse(callcenterConfigElement.textContent);
      callcenterButton.addEventListener('click', async () => {
        const items = Array.from(document.querySelectorAll('.follow-up-search-item[data-student-id]'));
        const availableStudentIds = items.map(item => item.dataset.studentId);
        const studentIds = items
          .filter(item => item.style.display !== 'none')
          .map(item => item.dataset.studentId);
        if (!studentIds.length) {
          if (callcenterStatus) callcenterStatus.textContent = ' لا يوجد طلاب ظاهرون للإرسال';
          return;
        }

        callcenterButton.disabled = true;
        if (callcenterStatus) callcenterStatus.textContent = ' جاري الإرسال...';
        try {
          const response = await fetch('/follow-up-dashboard/send-to-callcenter', {
            method: 'POST',
            headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
            body: JSON.stringify({
              student_ids: studentIds,
              available_student_ids: availableStudentIds,
              selection_token: callcenterConfig.token,
              filters: { ...callcenterConfig.filters, search: studentSearch?.value.trim() || '' },
            }),
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'تعذر الإرسال');
          if (callcenterStatus) callcenterStatus.textContent = ` تم إنشاء جلسة اتصال رقم ${result.sessionId} (${result.imported} طالب)`;
        } catch (error) {
          if (callcenterStatus) callcenterStatus.textContent = ` فشل الإرسال: ${error.message}`;
        } finally {
          callcenterButton.disabled = false;
        }
      });
    }
  });
</script>

<%- include('partials/footer') %>