<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shady Elsharkawy | نظام المتابعة</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Select2 for modern dropdowns -->
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
  <style>
    :root {
      --sf-primary: #4338CA;
      --sf-primary-dark: #312E81;
      --sf-primary-light: #EEF0FB;
      --sf-accent: #14B8A6;
      --sf-accent-dark: #0F9488;
      --sf-warning: #F59E0B;
      --sf-danger: #E11D48;
      --sf-info: #0EA5E9;
      --sf-bg: #F4F5FC;
      --sf-sidebar: #191653;
      --sf-sidebar-hover: #312E81;
      --sf-text: #181527;
      --sf-muted: #6B7280;
      --sf-radius: 16px;
      --sf-radius-sm: 11px;
      --sf-shadow: 0 2px 8px rgba(30, 27, 75, 0.06);
      --sf-shadow-md: 0 10px 28px rgba(30, 27, 75, 0.12);
      --sf-shadow-lg: 0 20px 48px rgba(30, 27, 75, 0.16);
      --sf-card-bg: #FFFFFF;
      --sf-input-border: #E2E4F3;
      --sf-table-header-bg: #EEF0FB;
      --sf-ease: cubic-bezier(0.4, 0, 0.2, 1);

      /* Soft tinted panels/badges used across pages (ad-hoc inline colors, now centralized) */
      --sf-success-soft-bg: #D1FAE5;
      --sf-success-soft-text: #047857;
      --sf-warning-soft-bg: #FEF3C7;
      --sf-warning-soft-text: #92400E;
      --sf-danger-soft-bg: #FEE2E2;
      --sf-danger-soft-text: #B91C1C;
      --sf-info-soft-bg: #E0F2FE;
      --sf-info-soft-text: #0369A1;
      --sf-neutral-soft-bg: #F3F4F6;
      --sf-neutral-soft-text: #374151;
      --sf-panel-bg: #F8F9FC;
    }

    /* Dark Mode Variables */
    [data-theme="dark"] {
      --sf-primary: #6366F1;
      --sf-primary-dark: #4F46E5;
      --sf-primary-light: rgba(99, 102, 241, 0.12);
      --sf-accent: #14B8A6;
      --sf-accent-dark: #0d9488;
      --sf-warning: #FBBF24;
      --sf-danger: #FB7185;
      --sf-info: #38BDF8;
      --sf-bg: #0F172A;
      --sf-sidebar: #1E293B;
      --sf-sidebar-hover: #334155;
      --sf-text: #E2E8F0;
      --sf-muted: #94A3B8;
      --sf-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
      --sf-shadow-md: 0 8px 24px rgba(0, 0, 0, 0.45);
      --sf-shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.55);
      --sf-card-bg: #1E293B;
      --sf-input-border: #334155;
      --sf-table-header-bg: #111827; /* Cleaned up to contrast beautifully with the cards */

      /* Same soft tints, tuned for dark mode using the same wash-of-accent-color formula as the badges below */
      --sf-success-soft-bg: rgba(16, 185, 129, 0.15);
      --sf-success-soft-text: #34D399;
      --sf-warning-soft-bg: rgba(245, 158, 11, 0.15);
      --sf-warning-soft-text: #FBBF24;
      --sf-danger-soft-bg: rgba(225, 29, 72, 0.15);
      --sf-danger-soft-text: #FB7185;
      --sf-info-soft-bg: rgba(14, 165, 233, 0.15);
      --sf-info-soft-text: #38BDF8;
      --sf-neutral-soft-bg: rgba(148, 163, 184, 0.12);
      --sf-neutral-soft-text: #CBD5E1;
      --sf-panel-bg: #17223A;
    }

    * { font-family: 'Cairo', sans-serif; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    ::selection { background: var(--sf-primary); color: #fff; }

    /* Visible scrollbars with better colors */
    ::-webkit-scrollbar { width: 12px; height: 12px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--sf-accent); border-radius: 10px; box-shadow: inset 0 0 0 3px var(--sf-bg); }
    ::-webkit-scrollbar-thumb:hover { background: var(--sf-primary); }
    
    /* Sidebar scrollbar on the right */
    .sidebar::-webkit-scrollbar { width: 12px; }
    .sidebar::-webkit-scrollbar-thumb { background: var(--sf-accent); }
    .sidebar::-webkit-scrollbar-thumb:hover { background: #FF6B6B; }
    
    /* Main content scrollbar on the left */
    .main-content::-webkit-scrollbar { width: 12px; }
    .main-content::-webkit-scrollbar-thumb { background: var(--sf-primary); }
    .main-content::-webkit-scrollbar-thumb:hover { background: var(--sf-accent); }

    body {
      display: flex;
      min-height: 100vh;
      margin: 0;
      background: var(--sf-bg);
      color: var(--sf-text);
      transition: background 0.25s var(--sf-ease), color 0.25s var(--sf-ease);
      -webkit-font-smoothing: antialiased;
    }

    :focus-visible {
      outline: 2px solid var(--sf-accent);
      outline-offset: 2px;
      border-radius: 4px;
    }

    .sidebar {
      width: 254px;
      background: linear-gradient(180deg, var(--sf-sidebar) 0%, #15132E 100%);
      color: #fff;
      padding: 22px 0;
      flex-shrink: 0;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      z-index: 1040;
      transition: transform 0.3s var(--sf-ease);
      box-shadow: 2px 0 18px rgba(0,0,0,0.12);
    }

    .sf-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-bottom: 6px;
    }
    .sf-logo-mark {
      width: 36px; height: 36px;
      background: linear-gradient(135deg, var(--sf-accent), var(--sf-primary));
      border-radius: 11px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; color: #fff; font-size: 1.1rem;
      box-shadow: 0 4px 12px rgba(20, 184, 166, 0.35);
    }
    .sf-logo-text { font-weight: 800; font-size: 1.18rem; color: #fff; letter-spacing: 0.2px; }
    .sf-logo-text span { color: var(--sf-accent); }

    .sidebar p.welcome {
      text-align: center; font-size: 0.78rem; color: #A5B4FC; margin-bottom: 18px;
      padding-bottom: 18px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      margin-left: 18px; margin-right: 18px;
    }

    .user-avatar {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--sf-accent);
      margin: 0 auto 8px;
      display: block;
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    .user-avatar:hover {
      transform: scale(1.05);
    }

    .user-placeholder {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: rgba(20, 184, 166, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin: 0 auto 8px;
      border: 2px solid rgba(20, 184, 166, 0.5);
    }

    .sf-nav-label {
      font-size: 0.68rem;
      font-weight: 700;
      color: #7C7FB8;
      padding: 4px 24px 8px;
      letter-spacing: 0.3px;
    }

    .sidebar a {
      display: flex;
      align-items: center;
      gap: 11px;
      color: #C7C9E8;
      padding: 10.5px 22px;
      margin: 1px 10px;
      border-radius: 10px;
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 500;
      line-height: 1.3;
      transition: background 0.2s var(--sf-ease), color 0.2s var(--sf-ease), transform 0.15s var(--sf-ease);
      border-right: 3px solid transparent;
    }
    .sidebar a:hover {
      background: rgba(255,255,255,0.08);
      color: #fff;
      border-right-color: var(--sf-accent);
      transform: translateX(-2px);
      opacity: 1;
    }
    .sidebar a.sf-active {
      background: rgba(20, 184, 166, 0.14);
      color: #fff;
      border-right-color: var(--sf-accent);
      font-weight: 700;
    }
    .sidebar hr { border-color: rgba(255,255,255,0.08); margin: 10px 22px; }

    .main-content {
      flex-grow: 1;
      padding: 28px;
      min-width: 0;
      animation: sf-fade-in 0.35s var(--sf-ease);
    }

    @keyframes sf-fade-in {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .container, .container-fluid { 
      background: var(--sf-bg);
    }

    h3, h4, h5, h6 { font-weight: 700; color: var(--sf-text); letter-spacing: -0.2px; }
    h1, h2 { color: var(--sf-text); font-weight: 800; letter-spacing: -0.3px; }

    /* Consistent page-title rhythm: almost every page opens with an h3 (+ optional subtitle) */
    .main-content > h3:first-child,
    .main-content > div:first-child > h3,
    .main-content > .d-flex:first-child h3 {
      font-size: 1.55rem;
      margin-bottom: 4px;
    }
    .main-content > p.text-muted:first-of-type,
    .main-content > div:first-child p.text-muted,
    .main-content > .d-flex:first-child p.text-muted {
      font-size: 0.93rem;
      margin-bottom: 0;
    }

    .card-body { padding: 1.35rem; }
    .card-body.p-0 { padding: 0 !important; }

    .card {
      border: none;
      border-radius: var(--sf-radius);
      box-shadow: var(--sf-shadow);
      background: var(--sf-card-bg);
      color: var(--sf-text);
      transition: box-shadow 0.25s var(--sf-ease), transform 0.25s var(--sf-ease);
    }
    .card:hover { box-shadow: var(--sf-shadow-md); }
    .card-header {
      background: transparent;
      border-bottom: 1px solid var(--sf-input-border);
      font-weight: 700;
      border-top-left-radius: var(--sf-radius) !important;
      border-top-right-radius: var(--sf-radius) !important;
    }
    .card-footer {
      background: transparent;
      border-top: 1px solid var(--sf-input-border);
    }

    .list-group-item {
      background-color: var(--sf-card-bg);
      color: var(--sf-text);
      border-color: var(--sf-input-border);
    }
    .list-group-item.list-group-item-action:hover,
    .list-group-item.list-group-item-action:focus {
      background-color: var(--sf-table-header-bg);
      color: var(--sf-text);
    }

    .btn {
      border-radius: var(--sf-radius-sm);
      font-weight: 600;
      font-size: 0.88rem;
      padding: 0.55rem 1.15rem;
      transition: transform 0.15s var(--sf-ease), box-shadow 0.15s var(--sf-ease), background 0.15s var(--sf-ease), border-color 0.15s var(--sf-ease);
    }
    .btn:hover { transform: translateY(-1px); }
    .btn:active { transform: translateY(0); }
    .btn-primary {
      background: var(--sf-primary);
      border-color: var(--sf-primary);
      box-shadow: 0 3px 10px rgba(67, 56, 202, 0.25);
    }
    .btn-primary:hover { background: var(--sf-primary-dark); border-color: var(--sf-primary-dark); box-shadow: 0 6px 16px rgba(67, 56, 202, 0.32); }
    .btn-success { background: var(--sf-accent); border-color: var(--sf-accent); box-shadow: 0 3px 10px rgba(20, 184, 166, 0.25); }
    .btn-success:hover { background: var(--sf-accent-dark); border-color: var(--sf-accent-dark); box-shadow: 0 6px 16px rgba(20, 184, 166, 0.32); }
    .btn-outline-primary, .btn-outline-secondary, .btn-outline-danger { background: transparent; }
    .btn-sm { border-radius: 8px; }

    /* GLOBAL SYSTEM-WIDE MODERN TABLES: no cell grid, soft row separators, rounded frame */
    .table {
      --sf-row-line: color-mix(in srgb, var(--sf-input-border) 75%, transparent);
      border-collapse: separate !important;
      border-spacing: 0;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--sf-input-border) !important;
      background: var(--sf-card-bg) !important;
      color: var(--sf-text) !important;
      margin-bottom: 0.5rem;
    }
    .table > :not(caption) > * > * { border-width: 0; box-shadow: none !important; }
    .table thead th {
      background: var(--sf-table-header-bg) !important;
      color: var(--sf-muted) !important;
      font-weight: 700;
      font-size: 0.78rem;
      letter-spacing: 0.2px;
      white-space: nowrap;
      padding: 0.8rem 0.9rem;
      border: none !important;
      border-bottom: 1px solid var(--sf-input-border) !important;
      position: sticky;
      top: 0;
      z-index: 1;
    }
    .table tbody tr {
      background: var(--sf-card-bg) !important;
      transition: background 0.15s var(--sf-ease);
    }
    .table tbody tr:hover {
      background: color-mix(in srgb, var(--sf-primary) 5%, var(--sf-card-bg)) !important;
    }
    .table td {
      font-size: 0.88rem;
      vertical-align: middle;
      color: var(--sf-text) !important;
      padding: 0.75rem 0.9rem;
      border: none !important;
      border-bottom: 1px solid var(--sf-row-line) !important;
      background: transparent !important;
    }
    .table tbody tr:last-child > td { border-bottom: none !important; }
    .table.table-sm td, .table.table-sm th { padding: 0.5rem 0.65rem; }
    .table.table-bordered td, .table.table-bordered th { border-inline-start: 1px solid var(--sf-row-line) !important; }
    .table.table-bordered td:first-child, .table.table-bordered th:first-child { border-inline-start: none !important; }
    .table.table-striped > tbody > tr:nth-of-type(odd) { background: color-mix(in srgb, var(--sf-table-header-bg) 45%, var(--sf-card-bg)) !important; }
    /* row highlight classes pages use for status (were flattened before) */
    .table tbody tr.table-success { background: var(--sf-success-soft-bg) !important; }
    .table tbody tr.table-danger { background: var(--sf-danger-soft-bg) !important; }
    .table tbody tr.table-warning { background: var(--sf-warning-soft-bg) !important; }
    .table tbody tr.table-info { background: var(--sf-info-soft-bg) !important; }
    .table tbody tr.table-secondary { background: var(--sf-neutral-soft-bg) !important; }

    /* a table directly inside a card: let the card be the frame */
    .card > .table, .card > .table-responsive > .table, .card-body > .table-responsive > .table, .table-responsive.card > .table { border: none !important; border-radius: 0; }
    .table-responsive {
      border-radius: var(--sf-radius);
      scrollbar-width: thin;
    }
    .table-responsive.card { padding: 0 !important; overflow-x: auto; }

    /* System link behavior handling color dynamics */
    .table td a {
      color: var(--sf-primary) !important;
      font-weight: 600;
    }
    [data-theme="dark"] .table td a {
      color: #60a5fa !important;
    }

    /* Clean translucent badges across all pages */
    .badge.bg-success {
      background-color: rgba(20, 184, 166, 0.15) !important;
      color: var(--sf-accent) !important;
      border: 1px solid rgba(20, 184, 166, 0.3);
    }
    .badge.bg-secondary {
      background-color: var(--sf-input-border) !important;
      color: var(--sf-muted) !important;
    }
    .badge.bg-primary {
      background-color: rgba(67, 56, 202, 0.13) !important;
      color: var(--sf-primary) !important;
      border: 1px solid rgba(67, 56, 202, 0.3);
    }
    .badge.bg-warning {
      background-color: rgba(245, 158, 11, 0.15) !important;
      color: #B45309 !important;
      border: 1px solid rgba(245, 158, 11, 0.3);
    }
    [data-theme="dark"] .badge.bg-warning { color: var(--sf-warning) !important; }
    .badge.bg-danger {
      background-color: rgba(225, 29, 72, 0.13) !important;
      color: var(--sf-danger) !important;
      border: 1px solid rgba(225, 29, 72, 0.3);
    }
    .badge.bg-info {
      background-color: rgba(14, 165, 233, 0.13) !important;
      color: var(--sf-info) !important;
      border: 1px solid rgba(14, 165, 233, 0.3);
    }

    .badge { font-weight: 600; padding: 0.42em 0.75em; border-radius: 8px; letter-spacing: 0.1px; }

    /* Bootstrap utility classes used across pages as "just a light panel/box" - not theme-aware by
       default, so in dark mode they used to stay hard-coded white/near-white. Map them onto the
       theme instead. (.bg-dark / .text-white are intentionally left alone: those are meant to stay
       dark regardless of theme, e.g. table-dark headers.) */
    .bg-light { background-color: var(--sf-panel-bg) !important; }
    .bg-white { background-color: var(--sf-card-bg) !important; }
    .text-dark { color: var(--sf-text) !important; }
    [data-theme="dark"] .badge.bg-light { color: var(--sf-text) !important; border-color: var(--sf-input-border) !important; }

    /* Soft tinted panels/badges: many pages set these inline (background:#EEF0FB, #D1FAE5, #FEF3C7,
       #FEE2E2, #F3F4F6...); these classes give the same pages a themed alternative. */
    .soft-primary { background-color: var(--sf-primary-light) !important; color: var(--sf-primary) !important; }
    .soft-success { background-color: var(--sf-success-soft-bg) !important; color: var(--sf-success-soft-text) !important; }
    .soft-warning { background-color: var(--sf-warning-soft-bg) !important; color: var(--sf-warning-soft-text) !important; }
    .soft-danger { background-color: var(--sf-danger-soft-bg) !important; color: var(--sf-danger-soft-text) !important; }
    .soft-info { background-color: var(--sf-info-soft-bg) !important; color: var(--sf-info-soft-text) !important; }
    .soft-neutral { background-color: var(--sf-neutral-soft-bg) !important; color: var(--sf-neutral-soft-text) !important; }
    .soft-panel { background-color: var(--sf-panel-bg) !important; color: var(--sf-text) !important; }

    /* ===== Center / subject colors =====
       .sf-chip  = one center or subject: an oval filled with a soft wash of its color
       .sf-mix   = a session (subject + center): a gentle blend of both colors */
    .sf-chip {
      --c: #94A3B8;
      display: inline-flex; align-items: center; gap: 6px;
      max-width: 100%;
      padding: 3px 11px 3px 12px;
      border-radius: 999px;
      font-size: 0.8rem; font-weight: 700; line-height: 1.55;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      vertical-align: middle;
      background: color-mix(in srgb, var(--c) 17%, var(--sf-card-bg));
      color: color-mix(in srgb, var(--c) 58%, #0B0A14) !important;
      border: 1px solid color-mix(in srgb, var(--c) 36%, transparent);
    }
    [data-theme="dark"] .sf-chip {
      background: color-mix(in srgb, var(--c) 24%, var(--sf-card-bg));
      color: color-mix(in srgb, var(--c) 52%, #FFFFFF) !important;
      border-color: color-mix(in srgb, var(--c) 45%, transparent);
    }
    .sf-dot, .sf-mix-dot {
      width: 8px; height: 8px; border-radius: 50%; flex: none; display: inline-block;
      background: var(--c);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 22%, transparent);
    }
    .sf-mix {
      --c1: #94A3B8; --c2: #94A3B8;
      display: inline-flex; align-items: center; gap: 7px;
      max-width: 100%;
      padding: 3px 12px;
      border-radius: 999px;
      font-size: 0.8rem; font-weight: 600; line-height: 1.55;
      white-space: nowrap; vertical-align: middle;
      color: var(--sf-text) !important;
      /* 60/40 blend so neither color shouts; each side keeps a light wash of its own color */
      background: linear-gradient(90deg,
        color-mix(in srgb, var(--c1) 16%, var(--sf-card-bg)) 0%,
        color-mix(in srgb, color-mix(in srgb, var(--c1) 60%, var(--c2)) 14%, var(--sf-card-bg)) 50%,
        color-mix(in srgb, var(--c2) 16%, var(--sf-card-bg)) 100%);
      border: 1px solid color-mix(in srgb, color-mix(in srgb, var(--c1) 50%, var(--c2)) 32%, transparent);
    }
    [dir="rtl"] .sf-mix {
      background: linear-gradient(270deg,
        color-mix(in srgb, var(--c1) 16%, var(--sf-card-bg)) 0%,
        color-mix(in srgb, color-mix(in srgb, var(--c1) 60%, var(--c2)) 14%, var(--sf-card-bg)) 50%,
        color-mix(in srgb, var(--c2) 16%, var(--sf-card-bg)) 100%);
    }
    [data-theme="dark"] .sf-mix { filter: saturate(1.15) brightness(1.08); }
    .sf-mix-dot {
      width: 10px; height: 10px;
      background: conic-gradient(var(--c1) 0 50%, var(--c2) 50% 100%);
      box-shadow: 0 0 0 2px color-mix(in srgb, color-mix(in srgb, var(--c1) 50%, var(--c2)) 22%, transparent);
    }
    .sf-mix-text { overflow: hidden; text-overflow: ellipsis; }
    .sf-mix-sep { font-style: normal; opacity: 0.45; margin: 0 5px; }
    .sf-mix-lesson { font-weight: 800; }
    .sf-chip-row { display: inline-flex; flex-wrap: wrap; gap: 6px; align-items: center; }

    /* A native <select> whose options carry data-sf-color shows the chosen item's color as a dot */
    .sf-color-select {
      background-image:
        radial-gradient(circle at center, var(--sf-sel-color, transparent) 0 5px, transparent 5.5px),
        var(--bs-form-select-bg-img) !important;
      background-repeat: no-repeat !important;
      background-size: 14px 14px, 16px 12px !important;
    }
    [dir="rtl"] .sf-color-select { background-position: right 0.75rem center, left 0.75rem center !important; padding-right: 2.1rem !important; }
    [dir="ltr"] .sf-color-select { background-position: left 0.75rem center, right 0.75rem center !important; padding-left: 2.1rem !important; }

    /* Tables with foldable columns: cells marked .sf-x stay hidden until the arrow in the header opens them */
    .sf-collapsible:not(.sf-cols-open) .sf-x { display: none !important; }
    .table.sf-collapsible { overflow: visible; } /* overflow:hidden would stop the pinned arrow column from sticking */
    /* slimmer rows on foldable tables, and even tighter once every column is open so it all fits on screen */
    .table.sf-collapsible > :not(caption) > * > * { padding: 0.5rem 0.6rem; }
    .table.sf-collapsible .sf-chip { font-size: 0.74rem; padding: 1px 8px; gap: 5px; }
    .table.sf-collapsible .btn-sm { padding: 0.22rem 0.55rem; font-size: 0.78rem; border-radius: 8px; }
    .table.sf-collapsible .sf-icon-btn { width: 28px; height: 28px; }
    .table.sf-collapsible .badge { font-size: 0.7rem; padding: 0.3em 0.55em; }
    .table.sf-collapsible.sf-cols-open > :not(caption) > * > * { padding: 0.4rem 0.4rem; font-size: 0.78rem; }
    .table.sf-collapsible.sf-cols-open thead th { white-space: normal; line-height: 1.25; font-size: 0.72rem; }
    .sf-collapsible.sf-cols-open .sf-x-hint { display: none !important; }
    .sf-collapsible .sf-x { animation: sf-col-in 0.25s var(--sf-ease); }
    @keyframes sf-col-in { from { opacity: 0; } to { opacity: 1; } }
    .sf-collapsible th.sf-xtoggle-cell, .sf-collapsible td.sf-xtoggle-cell { width: 1%; padding-inline: 6px !important; }
    /* the arrow column stays pinned to the edge, so "less" is reachable even when the open table scrolls sideways */
    @media (min-width: 769px) { /* pinned only on PC/tablet: on a phone it covered the columns underneath */
      .sf-collapsible th.sf-xtoggle-cell, .sf-collapsible td.sf-xtoggle-cell { position: sticky; inset-inline-end: 0; z-index: 2; background: var(--sf-card-bg) !important; }
      .sf-collapsible thead th.sf-xtoggle-cell { background: var(--sf-table-header-bg) !important; z-index: 3; }
      .sf-collapsible.sf-cols-open td.sf-xtoggle-cell, .sf-collapsible.sf-cols-open th.sf-xtoggle-cell { box-shadow: 8px 0 12px -10px rgba(0,0,0,0.25) !important; }
      [dir="ltr"] .sf-collapsible.sf-cols-open td.sf-xtoggle-cell, [dir="ltr"] .sf-collapsible.sf-cols-open th.sf-xtoggle-cell { box-shadow: -8px 0 12px -10px rgba(0,0,0,0.25) !important; }
    }
    .sf-xtoggle {
      display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;
      border: 1px solid var(--sf-input-border); background: var(--sf-card-bg); color: var(--sf-primary);
      border-radius: 999px; padding: 3px 10px; font-size: 0.75rem; font-weight: 700; cursor: pointer;
      transition: background 0.15s var(--sf-ease);
    }
    .sf-xtoggle:hover { background: var(--sf-primary-light); }
    .sf-cols-open .sf-xtoggle { padding: 3px 7px; }
    .sf-cols-open .sf-xtoggle span { display: none; } /* open: arrow only, so the squeezed table keeps its room */
    .sf-xtoggle i { font-size: 0.8rem; transition: transform 0.2s var(--sf-ease); }
    [dir="ltr"] .sf-xtoggle i { transform: scaleX(-1); }
    .sf-cols-open .sf-xtoggle i { transform: scaleX(-1); }
    [dir="ltr"] .sf-cols-open .sf-xtoggle i { transform: none; }

    /* Modern list groups */
    .list-group { border-radius: 14px; overflow: hidden; }
    .list-group-item { padding: 0.8rem 1rem; border-inline: none; transition: background 0.15s var(--sf-ease); }
    .list-group-flush > .list-group-item { border-inline: none; }

    /* Row action toolbars: compact, never spill over neighbouring cells */
    .sf-actions { display: flex; align-items: center; justify-content: flex-end; gap: 6px; flex-wrap: nowrap; }
