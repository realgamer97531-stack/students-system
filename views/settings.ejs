<%- include('partials/header') %>

<% function canShow(key) { return userRole === 'admin' || (userPermissions && userPermissions.includes(key)); } %>

<div class="container-fluid">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <!-- Header -->
      <div class="mb-5">
        <h2 class="mb-2">
          <span class="ar-only">⚙️ الإعدادات</span>
          <span class="en-only" style="display:none;">⚙️ Settings</span>
        </h2>
        <p class="text-muted">
          <span class="ar-only">تخصيص تجربة التطبيق الخاصة بك</span>
          <span class="en-only" style="display:none;">Customize your app experience</span>
        </p>
      </div>

      <!-- Theme Settings -->
      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h5 class="mb-1">
                <span class="ar-only">🌙 الوضع الليلي</span>
                <span class="en-only" style="display:none;">🌙 Dark Mode</span>
              </h5>
              <p class="text-muted small mb-0">
                <span class="ar-only">تبديل بين الوضع الفاتح والوضع الليلي</span>
                <span class="en-only" style="display:none;">Toggle between light and dark mode</span>
              </p>
            </div>
            <div class="form-check form-switch" style="transform: scale(1.5); transform-origin: right;">
              <input class="form-check-input" type="checkbox" id="darkModeToggle" 
                     onchange="toggleDarkMode()">
            </div>
          </div>
        </div>
      </div>

      <!-- Language Settings -->
      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h5 class="mb-1">
                <span class="ar-only">🌐 اللغة</span>
                <span class="en-only" style="display:none;">🌐 Language</span>
              </h5>
              <p class="text-muted small mb-0">
                <span class="ar-only">اختر لغتك المفضلة</span>
                <span class="en-only" style="display:none;">Choose your preferred language</span>
              </p>
            </div>
            <select id="languageSelect" class="form-select" style="width: auto; max-width: 150px;"
                    onchange="changeLanguage()">
              <option value="ar" id="lang-ar">العربية</option>
              <option value="en" id="lang-en">English</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Display Settings -->
      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">
            <span class="ar-only">📊 معلومات النظام</span>
            <span class="en-only" style="display:none;">📊 System Information</span>
          </h5>
          
          <div class="row g-3">
            <div class="col-md-6">
              <div class="p-3 rounded" style="background: var(--sf-table-header-bg);">
                <small class="text-muted">
                  <span class="ar-only">اسم المستخدم</span>
                  <span class="en-only" style="display:none;">Username</span>
                </small>
                <p class="mb-0"><strong><%= userName %></strong></p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-3 rounded" style="background: var(--sf-table-header-bg);">
                <small class="text-muted">
                  <span class="ar-only">الدور</span>
                  <span class="en-only" style="display:none;">Role</span>
                </small>
                <p class="mb-0"><strong>
                  <span class="ar-only"><%= userRole === 'admin' ? 'أدمن' : 'أسيستانت' %></span>
                  <span class="en-only" style="display:none;"><%= userRole === 'admin' ? 'Admin' : 'Assistant' %></span>
                </strong></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if (userRole === 'admin') { %>
      <% if (typeof successMessage !== 'undefined') { %>
      <div class="alert alert-success"> <%= successMessage %> </div>
      <% } %>
      <% if (typeof errorMessage !== 'undefined') { %>
      <div class="alert alert-danger"> <%= errorMessage %> </div>
      <% } %>
      <% if (typeof sessionToolsOutput !== 'undefined') { %>
      <div class="alert alert-secondary">
        <h6 class="mb-2">نتيجة العملية</h6>
        <pre class="small mb-0" style="max-height: 360px; overflow: auto; white-space: pre-wrap;"><%= sessionToolsOutput %></pre>
      </div>
      <% } %>
      <div class="card mb-4 shadow-sm" id="colors-tool">
        <div class="card-body">
          <h5 class="mb-1">🎨 <span class="ar-only">ألوان السناتر والمواد</span><span class="en-only" style="display:none;">Center &amp; subject colors</span></h5>
          <p class="text-muted small mb-3">
            <span class="ar-only">كل سنتر ومادة ليه لون بيظهر في كل القوايم. الحصة بتظهر بخليط هادي من لون المادة ولون السنتر. "تلقائي" = لون ثابت بيختاره السيستم.</span>
            <span class="en-only" style="display:none;">Each center and subject gets a color shown in every list. A session shows a soft blend of its subject and center colors. "Auto" = a fixed color picked by the system.</span>
          </p>
          <form action="/settings/colors" method="POST" id="colorsForm">
            <div class="row g-4">
              <% [['center', sf.centers, 'السناتر', 'Centers'], ['subject', sf.subjects, 'المواد', 'Subjects']].forEach(([kind, list, arTitle, enTitle]) => { %>
                <div class="col-lg-6">
                  <h6 class="small fw-bold text-muted mb-2"><span class="ar-only"><%= arTitle %></span><span class="en-only" style="display:none;"><%= enTitle %></span></h6>
                  <% if (!list.length) { %><div class="text-muted small">—</div><% } %>
                  <div class="list-group">
                    <% list.forEach(item => { %>
                      <div class="list-group-item d-flex align-items-center gap-2 color-row" data-kind="<%= kind %>" data-id="<%= item.id %>">
                        <span class="sf-chip color-preview flex-shrink-1" style="--c:<%= item.color %>"><i class="sf-dot"></i><%= item.name %></span>
                        <span class="ms-auto"></span>
                        <input type="color" class="form-control form-control-color color-input" name="<%= kind %>_<%= item.id %>" value="<%= item.color %>" title="اختار اللون / Pick a color" data-auto-value="<%= item.auto %>">
                        <div class="form-check form-switch mb-0 text-nowrap">
                          <input class="form-check-input color-auto" type="checkbox" name="<%= kind %>_auto_<%= item.id %>" value="1" id="auto_<%= kind %>_<%= item.id %>" <%= item.saved ? '' : 'checked' %>>
                          <label class="form-check-label small" for="auto_<%= kind %>_<%= item.id %>"><span class="ar-only">تلقائي</span><span class="en-only" style="display:none;">Auto</span></label>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3 p-3 rounded soft-panel">
              <span class="small fw-bold text-muted"><span class="ar-only">شكل الحصة:</span><span class="en-only" style="display:none;">Session preview:</span></span>
              <select id="mixSubject" class="form-select form-select-sm" style="width:auto">
                <% sf.subjects.forEach(item => { %><option value="<%= item.id %>"><%= item.name %></option><% }) %>
              </select>
              <select id="mixCenter" class="form-select form-select-sm" style="width:auto">
                <% sf.centers.forEach(item => { %><option value="<%= item.id %>"><%= item.name %></option><% }) %>
              </select>
              <span id="mixPreview"></span>
            </div>
            <button type="submit" class="btn btn-primary mt-3">💾 <span class="ar-only">احفظ الألوان</span><span class="en-only" style="display:none;">Save colors</span></button>
          </form>
        </div>
      </div>
      <script>
        (function () {
          const rows = document.querySelectorAll('#colorsForm .color-row');
          function rowColor(row) { return row.querySelector('.color-input').value; }
          function paint(row) { row.querySelector('.color-preview').style.setProperty('--c', rowColor(row)); }
          function find(kind, id) { return document.querySelector('#colorsForm .color-row[data-kind="' + kind + '"][data-id="' + id + '"]'); }
          function esc(t) { const d = document.createElement('div'); d.textContent = t; return d.innerHTML; }
          function mix() {
            const sId = document.getElementById('mixSubject').value;
            const cId = document.getElementById('mixCenter').value;
            const sRow = find('subject', sId), cRow = find('center', cId);
            const out = document.getElementById('mixPreview');
            if (!sRow || !cRow) { out.innerHTML = ''; return; }
            const sName = sRow.querySelector('.color-preview').textContent.trim();
            const cName = cRow.querySelector('.color-preview').textContent.trim();
            out.innerHTML = '<span class="sf-mix" style="--c1:' + rowColor(sRow) + ';--c2:' + rowColor(cRow) + '"><i class="sf-mix-dot"></i><b class="sf-mix-lesson">حصة 1</b><span class="sf-mix-text">' + esc(sName) + '<i class="sf-mix-sep">·</i>' + esc(cName) + '</span></span>';
          }
          rows.forEach(function (row) {
            const input = row.querySelector('.color-input');
            const auto = row.querySelector('.color-auto');
            input.addEventListener('input', function () { auto.checked = false; paint(row); mix(); });
            auto.addEventListener('change', function () {
              if (auto.checked) input.value = input.dataset.autoValue || input.value;
              paint(row); mix();
            });
          });
          document.getElementById('mixSubject').addEventListener('change', mix);
          document.getElementById('mixCenter').addEventListener('change', mix);
          mix();
        })();
      </script>

      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-2">🛠️ أدوات الحصة</h5>
          <p class="text-muted small mb-3">اختر السيريال لتنفيذ إجراء على هذه الحصة فقط. الحذف نهائي.</p>
          <% const availableSessions = typeof sessions !== 'undefined' ? sessions : []; %>
          <form action="/settings/session-tools" method="POST" class="row g-2 align-items-end">
            <div class="col-md-5">
              <label for="sessionSerial" class="form-label">الحصة</label>
              <select id="sessionSerial" name="session_serial" class="form-select" required>
                <option value="">اختر الحصة</option>
                <% availableSessions.forEach(session => { %>
                <option value="<%= session.serial_number %>">
                  سيريال <%= session.serial_number %> | حصة <%= session.lesson_number %> | <%= session.session_date %> | <%= session.status === 'cancelled' ? 'ملغاة' : 'عادية' %>
                </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-7 d-flex flex-wrap gap-2">
              <button type="submit" name="action" value="preview-delete" class="btn btn-outline-secondary">معاينة حذف الحصة</button>
              <button type="submit" name="action" value="mark-complete" class="btn btn-success" onclick="return confirm('سيتم جعل واجب كل طالب حاضر في هذه الحصة كاملًا. هل تريد المتابعة؟');">تحديد واجب الحاضرين ككامل</button>
              <button type="submit" name="action" value="delete" class="btn btn-danger" onclick="return confirm('تحذير: سيتم حذف الحصة وكل سجلاتها وتسجيلاتها نهائيًا. هل تريد المتابعة؟');">حذف الحصة نهائيًا</button>
            </div>
          </form>
        </div>
      </div>
      <%
        const lessonToolSessions = availableSessions.map(s => ({
          id: s.id, lesson: s.lesson_number, serial: s.serial_number, date: s.session_date, cancelled: s.status === 'cancelled',
          centerId: s.CenterId, subjectId: s.SubjectId,
          center: s.Center ? s.Center.name : '', subject: s.Subject ? s.Subject.name : '',
          c1: sf.color('subject', s.Subject || s.SubjectId), c2: sf.color('center', s.Center || s.CenterId),
        }));
        const lessonToolCenters = typeof settingsCenters !== 'undefined' ? settingsCenters : [];
        const lessonToolSubjects = typeof settingsSubjects !== 'undefined' ? settingsSubjects : [];
      %>
      <div class="card mb-4 shadow-sm" id="move-center-tool">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
          <div>
            <h5 class="mb-1">🏢 السناتر</h5>
            <p class="text-muted small mb-0">إضافة سنتر جديد بأساس السيريال بتاعه، أو نقل طلاب وحصص مادة من سنتر لسنتر (بمعاينة ونسخة احتياطية وتراجع).</p>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <a href="/settings/centers" class="btn btn-outline-success">🏢 السناتر + سنتر جديد</a>
            <a href="/settings/move-center" class="btn btn-outline-primary">🔀 نقل مادة بين السناتر</a>
          </div>
        </div>
      </div>
      <div class="card mb-4 shadow-sm" id="lesson-number-tool">
        <div class="card-body">
          <h5 class="mb-2">🔢 تغيير الرقم النسبي لحصة</h5>
          <p class="text-muted small mb-3">
            اختار السنتر والمادة والحصة واكتب الرقم النسبي الجديد. السيريال بيتحسب من جديد تلقائي،
            ومينفعش تختار رقم موجود بالفعل لحصة تانية في نفس السنتر والمادة.
          </p>
          <form action="/settings/session-lesson-number" method="POST" class="row g-2 align-items-end" id="lessonNumberForm">
            <div class="col-md-3">
              <label class="form-label" for="lnCenter">السنتر</label>
              <select id="lnCenter" class="form-select">
                <option value="">كل السناتر</option>
                <% lessonToolCenters.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="lnSubject">المادة</label>
              <select id="lnSubject" class="form-select">
                <option value="">كل المواد</option>
                <% lessonToolSubjects.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="lnSession">الحصة</label>
              <select id="lnSession" name="session_id" class="form-select" required></select>
            </div>
            <div class="col-md-2">
              <label class="form-label" for="lnNumber">الرقم الجديد</label>
              <input type="number" min="1" id="lnNumber" name="lesson_number" class="form-control" required>
            </div>
            <div class="col-12">
              <div id="lnHint" class="small text-muted mb-2"></div>
              <button type="submit" class="btn btn-primary">💾 غيّر الرقم النسبي</button>
            </div>
          </form>
        </div>
      </div>
      <script>
        (function () {
          const sessions = <%- JSON.stringify(lessonToolSessions).replace(/</g, '\\u003c') %>;
          const center = document.getElementById('lnCenter');
          const subject = document.getElementById('lnSubject');
          const select = document.getElementById('lnSession');
          const number = document.getElementById('lnNumber');
          const hint = document.getElementById('lnHint');
          const form = document.getElementById('lessonNumberForm');
          function current() { return sessions.find(s => String(s.id) === select.value); }
          function attr(v) { return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }
          function fill() {
            const list = sessions.filter(s => (!center.value || String(s.centerId) === center.value) && (!subject.value || String(s.subjectId) === subject.value));
            select.innerHTML = '<option value="">' + (list.length ? 'اختار الحصة' : 'مفيش حصص') + '</option>' + list.map(s =>
              '<option value="' + s.id + '" data-sf-session="1" data-sf-subject="' + attr(s.subject) + '" data-sf-center="' + attr(s.center) + '" data-sf-c1="' + attr(s.c1) + '" data-sf-c2="' + attr(s.c2) +
              '" data-sf-lesson="' + attr(s.lesson) + '" data-sf-serial="' + attr(s.serial) + '" data-sf-date="' + attr(s.date || '') + '" data-sf-status="' + (s.cancelled ? 'cancelled' : '') + '">' +
              attr('حصة ' + s.lesson + ' | ' + s.subject + ' | ' + s.center + ' | سيريال ' + s.serial + ' | ' + (s.date || '') + (s.cancelled ? ' | ملغاة' : '')) + '</option>').join('');
            check();
          }
          function check() {
            const s = current();
            if (!s) { hint.textContent = ''; return; }
            const n = Number(number.value);
            if (!n) { hint.className = 'small text-muted mb-2'; hint.textContent = 'الرقم الحالي: ' + s.lesson; return; }
            const clash = sessions.find(o => o.id !== s.id && o.centerId === s.centerId && o.subjectId === s.subjectId && o.lesson === n);
            if (n === s.lesson) { hint.className = 'small text-muted mb-2'; hint.textContent = 'ده نفس الرقم الحالي.'; }
            else if (clash) { hint.className = 'small text-danger fw-bold mb-2'; hint.textContent = '❌ فيه حصة تانية برقم ' + n + ' في نفس السنتر والمادة (سيريال ' + clash.serial + ').'; }
            else { hint.className = 'small text-success mb-2'; hint.textContent = '✔️ حصة ' + s.lesson + ' هتبقى حصة ' + n + '.'; }
          }
          center.addEventListener('change', fill);
          subject.addEventListener('change', fill);
          select.addEventListener('change', check);
          // the session list is a Select2 dropdown: it fires jQuery's change, not the native one
          document.addEventListener('DOMContentLoaded', function () { if (window.jQuery) jQuery(select).on('select2:select select2:clear', check); });
          number.addEventListener('input', check);
          form.addEventListener('submit', (e) => {
            const s = current();
            if (!s || !confirm('تغيير حصة ' + s.lesson + ' (' + s.subject + ' - ' + s.center + ') إلى رقم ' + number.value + '؟')) e.preventDefault();
          });
          fill();
        })();
      </script>
      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-2">📚 البوكليتس</h5>
          <p class="text-muted small mb-3">إدارة أسعار الطباعة والبيع والكمية والحجوزات لكل مادة من مكان واحد.</p>
          <div class="d-flex flex-wrap gap-2">
            <a href="/admin/booklets" class="btn btn-primary btn-sm">إدارة البوكليتس</a>
          </div>
        </div>
      </div>

      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-2">💾 قاعدة البيانات</h5>
          <p class="text-muted small mb-3">تصدير أو استيراد قاعدة البيانات بالكامل.</p>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <a href="/admin/backups" class="btn btn-outline-primary">🛡️ النسخ الاحتياطية اليومية</a>
            <a href="/admin/deleted-students" class="btn btn-outline-danger">🗂️ الطلاب المحذوفين</a>
            <a href="/admin/sync-devices" class="btn btn-outline-secondary">💻 أجهزة برنامج الديسكتوب</a>
          </div>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <a href="/settings/export-database" class="btn btn-success">تصدير قاعدة البيانات</a>
            <form action="/settings/import-database" method="POST" enctype="multipart/form-data" class="d-flex gap-2 align-items-center flex-wrap">
              <input type="file" name="database_file" accept=".sql" class="form-control" required>
              <button type="submit" class="btn btn-primary">استيراد قاعدة البيانات</button>
            </form>
          </div>
        </div>
      </div>

      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-2">🧹 أدوات تنظيف البيانات</h5>
          <p class="text-muted small mb-3">مسح بيانات محددة من النظام. كل عملية تحتاج كلمة مرور الأدمن للتأكيد.</p>
          <div class="row g-3">
            <div class="col-md-6">
              <form action="/settings/clear-db" method="POST" class="card p-3 h-100">
                <h6>مسح كل شيء</h6>
                <p class="small text-muted">يحذف كل الجداول والبيانات من قاعدة البيانات.</p>
                <div class="mb-2">
                  <input type="password" name="password" class="form-control" placeholder="أدخل كلمة المرور" required>
                </div>
                <button type="submit" class="btn btn-danger w-100">مسح كل البيانات</button>
              </form>
            </div>
            <div class="col-md-6">
              <form action="/settings/clear-students" method="POST" class="card p-3 h-100">
                <h6>مسح الطلاب وبياناتهم</h6>
                <p class="small text-muted">يحذف كل الطلاب وسجلاتهم المرتبطة.</p>
                <div class="mb-2">
                  <input type="password" name="password" class="form-control" placeholder="أدخل كلمة المرور" required>
                </div>
                <button type="submit" class="btn btn-warning w-100">مسح الطلاب</button>
              </form>
            </div>
            <div class="col-md-6">
              <form action="/settings/clear-sessions" method="POST" class="card p-3 h-100">
                <h6>مسح الجلسات</h6>
                <p class="small text-muted">يحذف كل جلسات المنصة وسجلات الحضور والواجب.</p>
                <div class="mb-2">
                  <input type="password" name="password" class="form-control" placeholder="أدخل كلمة المرور" required>
                </div>
                <button type="submit" class="btn btn-warning w-100">مسح الجلسات</button>
              </form>
            </div>
            <div class="col-md-6">
              <form action="/settings/clear-videos" method="POST" class="card p-3 h-100">
                <h6>مسح الفيديوهات</h6>
                <p class="small text-muted">يحذف كل الفيديوهات ومنح الوصول.</p>
                <div class="mb-2">
                  <input type="password" name="password" class="form-control" placeholder="أدخل كلمة المرور" required>
                </div>
                <button type="submit" class="btn btn-warning w-100">مسح الفيديوهات</button>
              </form>
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Back Button -->
      <div class="mb-4">
        <button class="btn btn-secondary" onclick="window.history.back()">
          <span class="ar-only">← رجوع</span>
          <span class="en-only" style="display:none;">← Back</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleDarkMode() {
    const checkbox = document.getElementById('darkModeToggle');
    const theme = checkbox.checked ? 'dark' : 'light';
    localStorage.setItem('theme', theme);
    document.documentElement.setAttribute('data-theme', theme);
  }

  function changeLanguage() {
    const select = document.getElementById('languageSelect');
    const lang = select.value;
    localStorage.setItem('language', lang);
    window.location.reload();
  }

  function applyLanguageDisplay() {
    const lang = localStorage.getItem('language') || 'ar';
    const arElements = document.querySelectorAll('.ar-only');
    const enElements = document.querySelectorAll('.en-only');

    if (lang === 'ar') {
      arElements.forEach(el => el.style.display = '');
      enElements.forEach(el => el.style.display = 'none');
    } else {
      arElements.forEach(el => el.style.display = 'none');
      enElements.forEach(el => el.style.display = '');
    }
  }

  function initializeSettings() {
    const theme = localStorage.getItem('theme') || 'light';
    const lang = localStorage.getItem('language') || 'ar';
    
    document.getElementById('darkModeToggle').checked = theme === 'dark';
    document.getElementById('languageSelect').value = lang;
    
    applyLanguageDisplay();
  }

  document.addEventListener('DOMContentLoaded', initializeSettings);
  initializeSettings();
</script>

