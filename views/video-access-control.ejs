<%- include('partials/header') %>

<h3 class="mb-4">🔐 <span class="ar-only">التحكم في مشاهدات:</span><span class="en-only" style="display:none;">Viewing Control:</span> <%= video.title %></h3>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3"><span class="ar-only">الإعدادات العامة (تخص كل الطلاب)</span><span class="en-only" style="display:none;">General Settings (apply to all students)</span></h6>
    <form action="/admin/videos/<%= video.id %>/session-settings" method="POST" class="row g-2 align-items-end">
      <div class="col-md-3 form-check ms-2">
        <input type="checkbox" class="form-check-input" name="is_free_for_all" id="freeCheck"
          <%= video.Session.is_free_for_all ? 'checked' : '' %>>
        <label class="form-check-label" for="freeCheck"><span class="ar-only">مفتوحة مجانًا للجميع</span><span class="en-only" style="display:none;">Free and Open to Everyone</span></label>
      </div>
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">عدد المشاهدات (حضر بالسنتر)</span><span class="en-only" style="display:none;">Number of Views (attended at the center)</span></label>
        <input type="number" name="views_if_attended" class="form-control" value="<%= video.Session.views_if_attended %>">
      </div>
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">عدد المشاهدات (دفع)</span><span class="en-only" style="display:none;">Number of Views (paid)</span></label>
        <input type="number" name="views_if_paid" class="form-control" value="<%= video.Session.views_if_paid %>">
      </div>
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">مدة الإتاحة بالساعات لكل الطلاب</span><span class="en-only" style="display:none;">Access Duration in Hours for All Students</span></label>
        <input type="number" name="access_duration_hours" class="form-control" value="<%= video.Session.access_duration_hours || 72 %>" min="1" required>
      </div>
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">رابط الامتحان</span><span class="en-only" style="display:none;">Exam Link</span></label>
        <input type="url" name="exam_url" class="form-control" value="<%= video.Session.exam_url || '' %>" placeholder="https://example.com/exam">
      </div>
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">فيديو إجابة الاختبار (يُضاف لاحقًا)</span><span class="en-only" style="display:none;">Exam Answer Video (added later)</span></label>
        <input type="url" name="exam_video_url" class="form-control" value="<%= video.Session.exam_video_url || '' %>" placeholder="https://vimeo.com/...">
      </div>
      <div class="col-md-12">
        <button type="submit" class="btn btn-primary w-100"><span class="ar-only">حفظ</span><span class="en-only" style="display:none;">Save</span></button>
      </div>
    </form>
    <div class="row g-2 mt-2">
      <% if (video.Session.exam_url) { %>
        <div class="col-md-6">
          <form action="/admin/videos/<%= video.id %>/session-link/delete" method="POST" onsubmit="return confirm('حذف رابط الاختبار؟')">
            <input type="hidden" name="field" value="exam_url">
            <button type="submit" class="btn btn-sm btn-outline-danger w-100"><span class="ar-only">حذف رابط الاختبار</span><span class="en-only" style="display:none;">Delete Exam Link</span></button>
          </form>
        </div>
      <% } %>
      <% if (video.Session.exam_video_url) { %>
        <div class="col-md-6">
          <form action="/admin/videos/<%= video.id %>/session-link/delete" method="POST" onsubmit="return confirm('حذف فيديو إجابة الاختبار؟')">
            <input type="hidden" name="field" value="exam_video_url">
            <button type="submit" class="btn btn-sm btn-outline-danger w-100"><span class="ar-only">حذف فيديو الإجابة</span><span class="en-only" style="display:none;">Delete Answer Video</span></button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>

<% const priceSession = video.Session || {}; %>
<% const showPrice = (value) => (value === null || value === undefined || value === '') ? 'سعر حصة الطالب العادي' : (value + ' ج (' + Math.round(value / normalPrice * 1000) / 10 + '%)'); %>
<% if (priceMessage) { %>
  <div class="alert alert-success"><%= priceMessage %></div>
<% } %>
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-2">💰 <span class="ar-only">سعر الحصة (للي بيدفع من رصيده عشان يشوفها أونلاين)</span><span class="en-only" style="display:none;">Session price (paid from balance to watch online)</span></h6>
    <p class="small text-muted mb-3">
      <span class="ar-only">السعر الحالي — طلاب السناتر:</span><span class="en-only" style="display:none;">Current price — center students:</span>
      <strong><%= showPrice(priceSession.video_price_center) %></strong>
      &nbsp;•&nbsp;
      <span class="ar-only">طلاب الأونلاين:</span><span class="en-only" style="display:none;">online students:</span>
      <strong><%= showPrice(priceSession.video_price_online) %></strong>
      <br>
      <span class="ar-only">السعر ده للطالب اللي حصته بالسعر العادي (<%= normalPrice %> ج). اللي حصته بسعر تاني بيدفع بنفس النسبة — مثلاً لو حطيت <%= normalPrice * 2 %> ج (200%) اللي حصته 50 ج هيدفع 100 ج.</span>
      <br>
      <span class="ar-only">سيب السعر فاضي عشان يرجع لسعر حصة كل طالب العادي.</span><span class="en-only" style="display:none;">Leave the price empty to go back to each student's normal session price.</span>
    </p>
    <form id="videoPriceForm" action="/admin/videos/<%= video.id %>/price" method="POST" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">السعر للطالب العادي (ج)</span><span class="en-only" style="display:none;">Price (EGP)</span></label>
        <input type="number" name="price" min="0" step="0.5" class="form-control" placeholder="سعر الطالب العادي">
      </div>
      <div class="col-md-6">
        <label class="form-label small d-block"><span class="ar-only">السعر ده لمين؟</span><span class="en-only" style="display:none;">Who does this price apply to?</span></label>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="scope" id="priceScopeCenter" value="center" required>
          <label class="form-check-label" for="priceScopeCenter"><span class="ar-only">طلاب السناتر بس</span><span class="en-only" style="display:none;">Center students only</span></label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="scope" id="priceScopeOnline" value="online">
          <label class="form-check-label" for="priceScopeOnline"><span class="ar-only">طلاب الأونلاين بس</span><span class="en-only" style="display:none;">Online students only</span></label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="scope" id="priceScopeBoth" value="both">
          <label class="form-check-label" for="priceScopeBoth"><span class="ar-only">الاتنين</span><span class="en-only" style="display:none;">Both</span></label>
        </div>
      </div>
      <input type="hidden" name="apply_existing" value="no">
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100"><span class="ar-only">حفظ السعر</span><span class="en-only" style="display:none;">Save price</span></button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="videoPriceModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><span class="ar-only">تأكيد سعر الحصة</span><span class="en-only" style="display:none;">Confirm session price</span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="videoPriceModalBody"></div>
      <div class="modal-footer flex-column align-items-stretch gap-2">
        <button type="button" class="btn btn-warning" id="videoPriceApplyAll"><span class="ar-only">طبّق السعر الجديد على اللي اشتروها كمان</span><span class="en-only" style="display:none;">Also apply to students who already bought it</span></button>
        <button type="button" class="btn btn-primary" id="videoPriceApplyNew"><span class="ar-only">السعر الجديد للي هيشتري بعد كده بس</span><span class="en-only" style="display:none;">Only for future purchases</span></button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><span class="ar-only">رجوع</span><span class="en-only" style="display:none;">Back</span></button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const form = document.getElementById('videoPriceForm');
    const modalEl = document.getElementById('videoPriceModal');
    const body = document.getElementById('videoPriceModalBody');
    const applyAll = document.getElementById('videoPriceApplyAll');
    const applyNew = document.getElementById('videoPriceApplyNew');
    let confirmed = false;

    const line = (text, className) => {
      const el = document.createElement('div');
      if (className) el.className = className;
      el.textContent = text;
      body.appendChild(el);
      return el;
    };
    const money = (n) => (Math.round(Number(n) * 100) / 100) + ' ج';

    function submitWith(applyExisting) {
      form.querySelector('input[name="apply_existing"]').value = applyExisting ? 'yes' : 'no';
      confirmed = true;
      applyAll.disabled = applyNew.disabled = true;
      form.submit();
    }
    applyAll.addEventListener('click', () => {
      if (confirm('متأكد؟ رصيد الطلاب اللي اشتروا الحصة هيتعدل بالفرق دلوقتي.')) submitWith(true);
    });
    applyNew.addEventListener('click', () => submitWith(false));

    form.addEventListener('submit', async (event) => {
      if (confirmed) return;
      event.preventDefault();
      const data = new FormData(form);
      const scope = data.get('scope');
      if (!scope) return alert('اختار السعر ده لطلاب السناتر ولا الأونلاين ولا الاتنين');
      const price = String(data.get('price') || '').trim();
      const scopeText = { center: 'طلاب السناتر بس', online: 'طلاب الأونلاين بس', both: 'طلاب السناتر والأونلاين' }[scope];

      body.textContent = '';
      line('السعر الجديد: ' + (price === '' ? 'سعر حصة الطالب العادي' : money(price) + ' (' + Math.round(Number(price) / <%= normalPrice %> * 1000) / 10 + '% من السعر العادي <%= normalPrice %> ج)') + ' — لـ ' + scopeText, 'fw-bold mb-2');
      const loading = line('بيحسب مين اشترى الحصة...', 'text-muted');
      const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
      modal.show();
      applyAll.disabled = applyNew.disabled = true;

      try {
        const query = new URLSearchParams({ price, scope });
        const response = await fetch('/admin/videos/<%= video.id %>/price-preview?' + query.toString(), { headers: { Accept: 'application/json' } });
        const result = await response.json();
        loading.remove();
        if (!response.ok || !result.success) {
          line('❌ ' + (result.message || 'حصلت مشكلة'), 'text-danger');
          return;
        }
        applyNew.disabled = false;
        if (result.buyers === 0) {
          line('محدش من ' + scopeText + ' اشترى الحصة دي من رصيده لسه — السعر الجديد هيطبق على اللي هيشتري بعد كده.');
          applyAll.style.display = 'none';
          return;
        }
        applyAll.style.display = '';
        applyAll.disabled = false;
        line('فيه ' + result.buyers + ' طالب من ' + scopeText + ' اشتروا الحصة دي قبل كده من رصيدهم. لو طبّقت عليهم السعر الجديد:');
        const list = document.createElement('ul');
        list.className = 'mb-2';
        body.appendChild(list);
        const item = (text) => { const li = document.createElement('li'); li.textContent = text; list.appendChild(li); };
        if (result.refund.count) item(result.refund.count + ' طالب هيرجعلهم فرق (إجمالي ' + money(result.refund.total) + ')');
        if (result.charge.count) item(result.charge.count + ' طالب هيتخصم منهم فرق (إجمالي ' + money(result.charge.total) + ')');
        if (result.unchanged) item(result.unchanged + ' طالب دفعوا نفس السعر — مش هيتغير حاجة');
        if (result.unknown) item(result.unknown + ' طالب مش لاقيين حركة دفعهم — مش هيتغير حسابهم');

        const details = document.createElement('details');
        const summary = document.createElement('summary');
        summary.textContent = 'تفاصيل الطلاب';
        details.appendChild(summary);
        result.students.forEach((s) => {
          const row = document.createElement('div');
          row.className = 'small border-bottom py-1';
          const change = s.paid === null ? 'مش معروف دفع كام' : (s.diff > 0 ? 'يرجعله ' + money(s.diff) : s.diff < 0 ? 'يتخصم منه ' + money(-s.diff) : 'من غير تغيير');
          row.textContent = s.name + ' (' + s.code + (s.online ? '، أونلاين' : '') + ') — دفع ' + (s.paid === null ? '؟' : money(s.paid)) + ' ← ' + money(s.newPrice) + ' — ' + change;
          details.appendChild(row);
        });
        body.appendChild(details);
      } catch (error) {
        loading.remove();
        line('❌ مش قادر يوصل للسيرفر — جرب تاني', 'text-danger');
      }
    });

    modalEl.addEventListener('hidden.bs.modal', () => { if (!confirmed) applyAll.disabled = applyNew.disabled = false; });
  })();
</script>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3">🏫 <span class="ar-only">الحصص المسموح لها بمشاهدة هذا الفيديو</span><span class="en-only" style="display:none;">Sessions Allowed to Watch This Video</span></h6>

    <div class="d-flex flex-wrap gap-2 mb-3">
      <% if (videoSessions.length === 0) { %>
        <span class="text-muted small"><span class="ar-only">لا توجد حصص مرتبطة (الفيديو مرئي للجميع!)</span><span class="en-only" style="display:none;">No linked sessions (the video is visible to everyone!)</span></span>
      <% } %>
      <% videoSessions.forEach(vs => { %>
        <div class="d-flex align-items-center gap-1 p-2 rounded" style="background:var(--sf-primary-light);font-size:0.8rem;">
          <span><strong><%= vs.Session?.Subject?.name %></strong> - <%= vs.Session?.Center?.name %> (<span class="ar-only">حصة</span><span class="en-only" style="display:none;">Session</span> <%= vs.Session?.lesson_number %>)</span>
          <form action="/admin/videos/<%= video.id %>/remove-session/<%= vs.SessionId %>" method="POST">
            <button class="btn btn-sm" style="padding:1px 6px;background:var(--sf-danger-soft-bg);color:var(--sf-danger-soft-text);font-size:0.65rem;">✕</button>
          </form>
        </div>
      <% }) %>
    </div>

    <form action="/admin/videos/<%= video.id %>/add-session" method="POST" class="d-flex gap-2">
      <select name="session_id" class="form-select session-select" placeholder="إضافة حصة جديدة" required>
        <option value=""><span class="ar-only">-- إضافة حصة جديدة --</span><span class="en-only" style="display:none;">-- Add New Session --</span></option>
        <% allSessions.forEach(s => { %>
          <% const alreadyAdded = videoSessions.some(vs => vs.SessionId === s.id); %>
          <% if (!alreadyAdded) { %>
            <option value="<%= s.id %>"><%= s.Subject?.name %> - <%= s.Center?.name %> (<span class="ar-only">حصة</span><span class="en-only" style="display:none;">Session</span> <%= s.lesson_number %> | <span class="ar-only">سيريال</span><span class="en-only" style="display:none;">Serial</span> <%= s.serial_number %>)</option>
          <% } %>
        <% }) %>
      </select>
      <button class="btn btn-sm btn-primary">+ <span class="ar-only">إضافة</span><span class="en-only" style="display:none;">Add</span></button>
    </form>
  </div>
</div>

<div class="card shadow-sm mb-3">
  <div class="card-body">
    <h6 class="mb-3">👤 <span class="ar-only">وصول فردي لطلاب بعينهم (خارج المجموعات المسموح بها)</span><span class="en-only" style="display:none;">Individual Access for Specific Students (Outside Allowed Groups)</span></h6>

    <div class="mb-3">
      <input id="studentSearch" type="text" class="form-control" placeholder="🔍 بحث بالاسم أو الكود">
    </div>

    <% if (students.length === 0) { %>
      <p class="text-muted small"><span class="ar-only">لا يوجد طالب لديه وصول لهذا الفيديو حتى الآن.</span><span class="en-only" style="display:none;">No student has access to this video yet.</span></p>
    <% } else { %>
      <div class="table-responsive mb-3">
        <table class="table table-sm align-middle" id="studentsTable">
          <thead class="table-light">
            <tr>
              <th><span class="ar-only">الكود</span><span class="en-only" style="display:none;">Code</span></th>
              <th><span class="ar-only">الاسم</span><span class="en-only" style="display:none;">Name</span></th>
              <th><span class="ar-only">الفرقة / السنتر</span><span class="en-only" style="display:none;">Group / Center</span></th>
              <th><span class="ar-only">مصدر الوصول</span><span class="en-only" style="display:none;">Access Source</span></th>
              <th><span class="ar-only">المتبقي</span><span class="en-only" style="display:none;">Remaining</span></th>
              <th><span class="ar-only">تعديل</span><span class="en-only" style="display:none;">Edit</span></th>
              <th><span class="ar-only">إلغاء</span><span class="en-only" style="display:none;">Cancel</span></th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach(student => { %>
              <% const grant = grantsMap[student.id]; %>
              <% const accessSource = manualAccessMap[student.id] ? 'وصول فردي' : 'من الحصة'; %>
              <% const grantStart = grant && (grant.access_started_at || grant.createdAt); %>
              <% const grantHours = grant && (grant.access_duration_hours || video.Session.access_duration_hours || 72); %>
              <% const grantExpiry = grantStart ? new Date(grant.access_expires_at || new Date(grantStart).getTime() + grantHours * 60 * 60 * 1000) : null; %>
              <% const grantEnded = !!(grantExpiry && grantExpiry.getTime() <= Date.now()); %>
              <% const remaining = grant ? (grantEnded ? '⛔ انتهت ' + grantExpiry.toLocaleString('ar-EG') : 'غير محدود حتى ' + (grantExpiry ? grantExpiry.toLocaleString('ar-EG') : 'أول فتح')) : (video.Session.is_free_for_all ? 'غير محدود' : 'لم يتم فتح بعد'); %>
              <tr data-search="<%= (student.name + ' ' + student.student_code).toLowerCase() %>">
                <td><%= student.student_code %></td>
                <td><%= student.name %></td>
                <td class="small text-muted"><%= student.Subject?.name %> - <%= student.Center?.name %></td>
                <td><%= accessSource %><%= grant ? ' (' + grant.method + ')' : '' %></td>
                <td class="<%= grantEnded ? 'text-danger fw-bold' : '' %>"><%= remaining %></td>
                <td>
                  <form action="/admin/videos/<%= video.id %>/grant/<%= student.id %>" method="POST" class="row g-1 align-items-center">
                    <input type="hidden" name="session_id" value="<%= grant ? grant.SessionId : video.SessionId %>">
                    <input type="hidden" name="extend_hours" value="">
                    <div class="col-auto">
                      <input type="number" name="access_duration_hours" class="form-control form-control-sm" style="width:110px;" value="<%= grant && grant.access_duration_hours ? grant.access_duration_hours : (video.Session.access_duration_hours || 72) %>" min="1" title="مدة الإتاحة بالساعات">
                    </div>
                    <div class="col-auto">
                      <button type="button" class="btn btn-sm btn-outline-success add-24-hours" title="زوّد 24 ساعة (من آخر الإتاحة، أو من دلوقتي لو كانت خلصت)">+24 <span class="ar-only">ساعة</span><span class="en-only" style="display:none;">Hours</span></button>
                    </div>
                    <div class="col-auto">
                      <button class="btn btn-sm btn-outline-primary"><span class="ar-only">حفظ</span><span class="en-only" style="display:none;">Save</span></button>
                    </div>
                  </form>
                </td>
                <td>
                  <form action="/admin/videos/<%= video.id %>/remove-student-access-by-student/<%= student.id %>" method="POST">
                    <button class="btn btn-sm btn-outline-danger"><span class="ar-only">إلغاء</span><span class="en-only" style="display:none;">Cancel</span></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <form action="/admin/videos/<%= video.id %>/add-student-access" method="POST" class="d-flex gap-2">
      <input type="text" name="student_code" class="form-control form-control-sm" style="max-width:200px;"
        placeholder="كود الطالب (STU-XXXXX)" required>
      <button class="btn btn-sm btn-success">+ <span class="ar-only">إضافة طالب</span><span class="en-only" style="display:none;">Add Student</span></button>
    </form>
  </div>
</div>

<script>
  document.getElementById('studentSearch').addEventListener('input', function () {
    const term = this.value.toLowerCase().trim();
    document.querySelectorAll('#studentsTable tbody tr').forEach(row => {
      row.style.display = row.dataset.search.includes(term) ? '' : 'none';
    });
  });

  // +24: بيزوّد 24 ساعة على الإتاحة الحالية (أو من دلوقتي لو كانت خلصت) ويحفظ على طول
  document.querySelectorAll('.add-24-hours').forEach(button => {
    button.addEventListener('click', function () {
      this.form.querySelector('input[name="extend_hours"]').value = '24';
      this.disabled = true;
      this.form.submit();
    });
  });
</script>

<%- include('partials/footer') %>