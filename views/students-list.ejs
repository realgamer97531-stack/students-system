<%- include('partials/header') %>

<style>
  /* System-Compliant Adaptive Table Styling */
  .custom-adaptive-card {
    background: var(--sf-card-bg) !important;
    border: 1px solid var(--sf-input-border) !important;
    transition: background 0.2s, border 0.2s;
  }
  
  .custom-adaptive-table {
    background: transparent !important;
    color: var(--sf-text) !important;
    border-collapse: collapse !important;
  }

  .custom-adaptive-table thead tr {
    background: var(--sf-table-header-bg) !important;
  }

  .custom-adaptive-table th {
    color: var(--sf-text) !important;
    font-weight: 700;
    font-size: 0.85rem;
    border: 1px solid var(--sf-input-border) !important;
    padding: 12px 8px !important;
  }

  .custom-adaptive-table tbody tr {
    background: var(--sf-card-bg) !important;
    border-bottom: 1px solid var(--sf-input-border) !important;
    transition: background 0.2s;
  }

  .custom-adaptive-table tbody tr:hover {
    background: var(--sf-table-header-bg) !important;
  }

  .custom-adaptive-table td {
    color: var(--sf-text) !important;
    font-size: 0.88rem;
    vertical-align: middle;
    border: 1px solid var(--sf-input-border) !important;
    padding: 12px 8px !important;
  }

  /* Code column - no wrapping */
  .custom-adaptive-table td:nth-child(2) {
    white-space: nowrap;
    color: var(--sf-muted) !important;
    font-family: 'Courier New', monospace;
    font-weight: 600;
  }

  /* Secondary data dimming for better visual hierarchy */
  .custom-adaptive-table td:nth-child(4), /* Student Phone */
  .custom-adaptive-table td:nth-child(5), /* Parent Phone */
  .custom-adaptive-table td:nth-child(6), /* Subject */
  .custom-adaptive-table td:nth-child(7), /* Center */
  .custom-adaptive-table td:nth-child(8), /* Price */
  .custom-adaptive-table td:nth-child(9)  /* Balance */ {
    color: var(--sf-muted) !important;
  }

  /* Profile photo styling */
  .student-photo {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    object-fit: cover;
    border: 2px solid var(--sf-primary-light);
    display: block;
  }

  .student-photo-placeholder {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--sf-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    border: 2px solid var(--sf-input-border);
  }

  /* Student row clickable styling */
  .custom-adaptive-table tbody tr {
    cursor: pointer;
  }

  .custom-adaptive-table tbody tr:hover {
    background: var(--sf-primary-light) !important;
    transform: translateX(-2px);
  }

  /* Student name styling - smooth and modern */
  .student-name {
    color: var(--sf-text) !important;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .student-name:hover {
    color: var(--sf-primary) !important;
  }

  .custom-adaptive-table tbody tr:hover .student-name {
    color: var(--sf-primary) !important;
  }

  /* Badge Customizations */
  .badge.bg-success {
    background-color: rgba(20, 184, 166, 0.15) !important; /* var(--sf-accent) translucent background */
    color: var(--sf-accent) !important;
    border: 1px solid rgba(20, 184, 166, 0.3);
  }

  .badge.bg-secondary {
    background-color: var(--sf-input-border) !important;
    color: var(--sf-muted) !important;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h3>
    <span class="ar-only">قائمة الطلاب (<%= students.length %>)</span>
    <span class="en-only" style="display:none;">Students List (<%= students.length %>)</span>
  </h3>
  <div>
    <a href="/students/export?<%= new URLSearchParams(filters).toString() %>" class="btn btn-outline-success">
      <span class="ar-only">📥 تصدير إكسيل</span>
      <span class="en-only" style="display:none;">📥 Export Excel</span>
    </a>
    <a href="/students/new" class="btn btn-primary">
      <span class="ar-only">+ تسجيل طالب جديد</span>
      <span class="en-only" style="display:none;">+ Add Student</span>
    </a>
    <% if (userRole === 'admin') { %>
      <a href="/students/bulk-template" class="btn btn-outline-success btn-sm">⬇ تحميل التيمبليت</a>
      <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#bulkUploadModal">
        📤 رفع Excel
      </button>
    <% } %>
  </div>
</div>

<form method="GET" action="/students" class="row g-2 mb-3">
  <div class="col-md-4">
    <input type="text" name="search" class="form-control" 
      placeholder="🔍 بحث بالاسم، الكود، أو التليفون"
      value="<%= filters.search %>" title="Search by name, code, phone, or parent phone">
  </div>
  <div class="col-md-3">
    <select name="center_id" class="form-select">
      <option value="">
        <span class="ar-only">-- كل السناتر --</span>
        <span class="en-only" style="display:none;">-- All Centers --</span>
      </option>
      <% centers.forEach(c => { %>
        <option value="<%= c.id %>" <%= String(filters.center_id) === String(c.id) ? 'selected' : '' %>>
          <%= c.name %>
        </option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-3">
    <select name="subject_id" class="form-select">
      <option value="">
        <span class="ar-only">-- كل المواد --</span>
        <span class="en-only" style="display:none;">-- All Subjects --</span>
      </option>
      <% subjects.forEach(s => { %>
        <option value="<%= s.id %>" <%= String(filters.subject_id) === String(s.id) ? 'selected' : '' %>>
          <%= s.name %>
        </option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-2">
    <button type="submit" class="btn btn-secondary w-100">
      <span class="ar-only">بحث</span>
      <span class="en-only" style="display:none;">Search</span>
    </button>
  </div>
  <div class="col-12">
    <div class="d-flex flex-wrap gap-3 mt-1">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" name="booklet_remaining_only" value="1" id="bookletRemainingOnly" <%= filters.booklet_remaining_only ? 'checked' : '' %>>
        <label class="form-check-label small" for="bookletRemainingOnly">باقي له في البوكليت</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="checkbox" name="low_balance_only" value="1" id="lowBalanceOnly" <%= filters.low_balance_only ? 'checked' : '' %>>
        <label class="form-check-label small" for="lowBalanceOnly">رصيده 90 ج أو أقل</label>
      </div>
    </div>
  </div>
</form>

<div class="table-responsive custom-adaptive-card rounded shadow-sm p-3">
  <table class="table custom-adaptive-table align-middle m-0">
    <thead>
      <tr>
        <th style="width: 80px;"><span class="ar-only">الصورة</span><span class="en-only" style="display:none;">Photo</span></th>
        <th><span class="ar-only">الكود</span><span class="en-only" style="display:none;">Code</span></th>
        <th><span class="ar-only">الاسم</span><span class="en-only" style="display:none;">Name</span></th>
        <th><span class="ar-only">تليفون الطالب</span><span class="en-only" style="display:none;">Student Phone</span></th>
        <th><span class="ar-only">تليفون ولي الأمر</span><span class="en-only" style="display:none;">Parent Phone</span></th>
        <th><span class="ar-only">المادة</span><span class="en-only" style="display:none;">Subject</span></th>
        <th><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></th>
        <th><span class="ar-only">السعر</span><span class="en-only" style="display:none;">Price</span></th>
        <th><span class="ar-only">المدفوع للبوكليت</span><span class="en-only" style="display:none;">Paid Booklet</span></th>
        <th><span class="ar-only">الرصيد</span><span class="en-only" style="display:none;">Balance</span></th>
        <th><span class="ar-only">البوكليت</span><span class="en-only" style="display:none;">Booklet</span></th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach(student => { %>
        <tr onclick="window.location.href='/students/<%= student.id %>'">
          <td style="padding: 8px !important;">
            <% if (student.profile_photo_url) { %>
              <img src="<%= student.profile_photo_url %>" alt="<%= student.name %>" class="student-photo" loading="lazy">
            <% } else { %>
              <div class="student-photo-placeholder">👤</div>
            <% } %>
          </td>
          <td><%= student.student_code %></td>
          <td><span class="student-name"><%= student.name %></span></td>
          <td><%= student.phone %></td>
          <td><%= student.parent_phone %></td>
          <td><%= student.Subject ? student.Subject.name : '-' %></td>
          <td><%= student.Center ? student.Center.name : '-' %></td>
          <td><%= student.price_per_session %> ج</td>
          <td><%= typeof bookletPaidTotals !== 'undefined' ? (bookletPaidTotals[student.id] || 0) + ' ج' : '0 ج' %></td>
          <td><%= student.balance %> ج</td>
          <td>
            <% if (student.booklet_status) { %>
              <span class="badge bg-success">
                <span class="ar-only">تم الشراء</span>
                <span class="en-only" style="display:none;">Purchased</span>
              </span>
            <% } else { %>
              <span class="badge bg-secondary">
                <span class="ar-only">لسه</span>
                <span class="en-only" style="display:none;">Pending</span>
              </span>
            <% } %>
            <% if (userRole === 'admin') { %>
              <form action="/students/<%= student.id %>/delete" method="POST" class="d-inline ms-2"
                onsubmit="event.stopPropagation(); return confirm('متأكد من حذف الطالب <%= student.name %>؟ سيتم حذف كل بياناته نهائياً.')">
                <button class="btn btn-sm btn-outline-danger">🗑 حذف</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="modal fade" id="bulkUploadModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">📤 رفع طلاب من Excel</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/students/bulk-upload" method="POST" enctype="multipart/form-data" id="bulkUploadForm">
        <div class="modal-body">
          <div class="alert alert-info small">
            تأكد إن الملف على نفس شكل التيمبليت بالظبط.<br>
            <a href="/students/bulk-template">⬇ تحميل التيمبليت</a>
          </div>
          <input type="file" name="excel_file" class="form-control" accept=".xlsx,.xls" required>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
          <button type="submit" class="btn btn-primary">رفع وإضافة</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.getElementById('bulkUploadForm').addEventListener('submit', function () {
    const submitButton = this.querySelector('button[type="submit"]');
    if (submitButton.disabled) return false;
    submitButton.disabled = true;
  });
</script>

<%- include('partials/footer') %>