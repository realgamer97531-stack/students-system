<%- include('partials/header') %>

<h3 class="mb-4">📊 <span class="ar-only">نظرة عامة</span><span class="en-only" style="display:none;">Overview</span></h3>

<!-- كروت الإحصائيات -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card shadow-sm border-0 text-center p-3">
      <div class="text-muted small"><span class="ar-only">إجمالي الطلاب</span><span class="en-only" style="display:none;">Total Students</span></div>
      <div class="fs-3 fw-bold text-primary"><%= totalStudents %></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card shadow-sm border-0 text-center p-3">
      <div class="text-muted small"><span class="ar-only">إجمالي أرصدة الطلاب</span><span class="en-only" style="display:none;">Total Students Balance</span></div>
      <div class="fs-3 fw-bold text-success"><%= totalBalance %> ج</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card shadow-sm border-0 text-center p-3">
      <div class="text-muted small"><span class="ar-only">طلاب محتاجين تجديد</span><span class="en-only" style="display:none;">Students Needing Renewal</span></div>
      <div class="fs-3 fw-bold text-danger"><%= lowBalanceCount %></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card shadow-sm border-0 text-center p-3">
      <div class="text-muted small"><span class="ar-only">حصص اليوم</span><span class="en-only" style="display:none;">Today's Sessions</span></div>
      <div class="fs-3 fw-bold text-info"><%= todaySessions %></div>
      <div class="text-muted small mt-1"><span class="ar-only">حضور اليوم:</span><span class="en-only" style="display:none;">Today's Attendance:</span> <%= todayAttendance %></div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <!-- جراف الحضور آخر 7 أيام -->
  <div class="col-md-7">
    <div class="card shadow-sm p-3">
      <h6 class="mb-3"><span class="ar-only">الحضور في آخر 7 أيام</span><span class="en-only" style="display:none;">Attendance in the Last 7 Days</span></h6>
      <canvas id="attendanceChart" height="120"></canvas>
    </div>
  </div>

  <!-- توزيع الطلاب على السناتر -->
  <div class="col-md-5">
    <div class="card shadow-sm p-3">
      <h6 class="mb-3"><span class="ar-only">توزيع الطلاب على السناتر</span><span class="en-only" style="display:none;">Students Distribution by Center</span></h6>
      <canvas id="centersChart" height="180"></canvas>
    </div>
  </div>
</div>

<div class="row g-3">
  <!-- توزيع الطلاب على المواد -->
  <div class="col-md-5">
    <div class="card shadow-sm p-3">
      <h6 class="mb-3"><span class="ar-only">توزيع الطلاب على المواد</span><span class="en-only" style="display:none;">Students Distribution by Subject</span></h6>
      <canvas id="subjectsChart" height="180"></canvas>
    </div>
  </div>

  <!-- آخر النشاطات -->
  <div class="col-md-7">
    <div class="card shadow-sm p-3">
      <h6 class="mb-3"><span class="ar-only">آخر النشاطات</span><span class="en-only" style="display:none;">Recent Activities</span></h6>
      <ul class="list-group list-group-flush">
        <% if (activityFeed.length === 0) { %>
          <li class="list-group-item text-muted small"><span class="ar-only">لا يوجد نشاط حتى الآن</span><span class="en-only" style="display:none;">No activity yet</span></li>
        <% } %>
        <% activityFeed.forEach(item => { %>
          <li class="list-group-item small d-flex justify-content-between">
            <span><%= item.text %></span>
            <span class="text-muted" style="white-space: nowrap;">
              <%= new Date(item.time).toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' }) %>
            </span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Keep chart text/gridlines readable in dark mode too
  (function themeChartDefaults() {
    const styles = getComputedStyle(document.documentElement);
    Chart.defaults.color = styles.getPropertyValue('--sf-muted').trim() || '#6B7280';
    Chart.defaults.borderColor = styles.getPropertyValue('--sf-input-border').trim() || '#E2E4F3';
  })();

  // جراف الحضور آخر 7 أيام
  const dayCounts = <%- JSON.stringify(dayCounts) %>;
  new Chart(document.getElementById('attendanceChart'), {
    type: 'bar',
    data: {
      labels: Object.keys(dayCounts),
      datasets: [{
        label: 'عدد الحضور',
        data: Object.values(dayCounts),
        backgroundColor: '#0d6efd',
      }],
    },
    options: { plugins: { legend: { display: false } } },
  });

  // جراف توزيع السناتر
  const centerCounts = <%- JSON.stringify(centerCounts) %>;
  new Chart(document.getElementById('centersChart'), {
    type: 'doughnut',
    data: {
      labels: Object.keys(centerCounts),
      datasets: [{
        data: Object.values(centerCounts),
        backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6610f2', '#fd7e14', '#20c997'],
      }],
    },
  });

  // جراف توزيع المواد
  const subjectCounts = <%- JSON.stringify(subjectCounts) %>;
  new Chart(document.getElementById('subjectsChart'), {
    type: 'doughnut',
    data: {
      labels: Object.keys(subjectCounts),
      datasets: [{
        data: Object.values(subjectCounts),
        backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6610f2', '#fd7e14'],
      }],
    },
  });
</script>

<%- include('partials/footer') %>