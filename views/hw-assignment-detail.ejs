<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center gap-2 mb-1">
  <h3 class="mb-0">📝 <%= assignment.title %></h3>
  <a class="btn btn-outline-success btn-sm" href="/hw/assignments/<%= assignment.id %>/export?<%= new URLSearchParams({ student_search: student_search || '', show_all_students: show_all_students ? '1' : '', marked_filter: marked_filter || 'all' }).toString() %>">
    📥 <span class="ar-only">تصدير Excel</span><span class="en-only" style="display:none;">Export Excel</span>
  </a>
</div>
<p class="text-muted mb-2"><span class="ar-only">واجب رقم</span><span class="en-only" style="display:none;">Homework #</span> <%= assignment.order_number %> | <%= assignment.start_date %> → <%= assignment.end_date %></p>
<p class="text-muted mb-3">
  <% if (assignment.Subject) { %>📚 <%= assignment.Subject.name %><br><% } %>
  <% if (assignment.Session && assignment.Session.Subject && assignment.Session.Center) { %>🔗 <span class="ar-only">الحصة الرئيسية:</span><span class="en-only" style="display:none;">Main Session:</span> <%= assignment.Session.Subject.name %> - <%= assignment.Session.Center.name %> - <span class="ar-only">حصة</span><span class="en-only" style="display:none;">Session</span> <%= assignment.Session.lesson_number %><br><% } %>
  <% const linkedSessions = (assignment.LinkedSessions || []).filter(s => String(s.id) !== String(assignment.SessionId)); %>
  <% if (linkedSessions.length) { %>
    🔗 <span class="ar-only">حصص مرتبطة:</span><span class="en-only" style="display:none;">Linked Sessions:</span> <%= linkedSessions.map(s => `${s.Subject?.name || 'غير معروف'} - ${s.Center?.name || 'غير معروف'} (حصة ${s.lesson_number})`).join('، ') %>
  <% } %>
</p>
<% if (assignment.submission_type === 'link') { %>
  <div class="alert alert-info py-2">
    🔗 <span class="ar-only">ده واجب "رابط خارجي": الطالب بيتحول مباشرة للرابط</span><span class="en-only" style="display:none;">This is an "External Link" homework: the student is redirected directly to the link</span> <a href="<%= assignment.external_link %>" target="_blank" rel="noopener"><%= assignment.external_link %></a> <span class="ar-only">بدل ما يرفع الواجب على المنصة، فمفيش تتبع للتسليم هنا.</span><span class="en-only" style="display:none;">instead of uploading the homework on the platform, so there is no submission tracking here.</span>
  </div>
<% } %>
<% if (assistantOnlyView) { %>
  <div class="alert alert-info py-2">
    <span class="ar-only">هذا العرض يعرض طلابك المتابعين فقط.</span><span class="en-only" style="display:none;">This view shows only your assigned students.</span>
    <% if (assignedStudentCount === 0) { %>
      <span class="ar-only">لا يوجد طلاب مسندين لك لهذا الواجب.</span><span class="en-only" style="display:none;">You have no students assigned to this homework.</span>
    <% } else { %>
      <span class="ar-only">عدد الطلاب المتاحين:</span><span class="en-only" style="display:none;">Available students:</span> <strong><%= assignedStudentCount %></strong>.
    <% } %>
  </div>
<% } %>

<div class="card mb-4">
  <div class="card-body">
    <form action="/hw/assignments/<%= assignment.id %>" method="GET" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">بحث عن طالب</span><span class="en-only" style="display:none;">Search for Student</span></label>
        <input type="text" name="student_search" value="<%= student_search %>" class="form-control" placeholder="الاسم أو كود الطالب">
      </div>
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">حالة التقييم</span><span class="en-only" style="display:none;">Grading Status</span></label>
        <select name="marked_filter" class="form-select">
          <option value="all" <%= marked_filter === 'all' ? 'selected' : '' %>><span class="ar-only">الكل</span><span class="en-only" style="display:none;">All</span></option>
          <option value="marked" <%= marked_filter === 'marked' ? 'selected' : '' %>><span class="ar-only">المصحح</span><span class="en-only" style="display:none;">Graded</span></option>
          <option value="not_marked" <%= marked_filter === 'not_marked' ? 'selected' : '' %>><span class="ar-only">غير مصحح</span><span class="en-only" style="display:none;">Not Graded</span></option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small"><span class="ar-only">عرض جميع الطلاب</span><span class="en-only" style="display:none;">Show All Students</span></label>
        <div class="form-check mt-1">
          <input class="form-check-input" type="checkbox" id="showAllStudents" name="show_all_students" value="1" <%= show_all_students ? 'checked' : '' %>>
          <label class="form-check-label" for="showAllStudents"><span class="ar-only">عرض جميع الطلاب</span><span class="en-only" style="display:none;">Show All Students</span></label>
        </div>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary w-100"><span class="ar-only">بحث</span><span class="en-only" style="display:none;">Search</span></button>
      </div>
    </form>
  </div>
</div>

<% const statusLabels = { submitted: 'تم التسليم', complete: 'كامل', incomplete: 'مش كامل', no_steps: 'من غير خطوات', not_done: 'مش معمول' }; %>
<% const statusColors = { submitted: 'var(--sf-neutral-soft-text)', complete: 'var(--sf-success-soft-text)', incomplete: 'var(--sf-warning-soft-text)', no_steps: 'var(--sf-neutral-soft-text)', not_done: 'var(--sf-danger-soft-text)' }; %>
<% const statusBgColors = { submitted: 'var(--sf-neutral-soft-bg)', complete: 'var(--sf-success-soft-bg)', incomplete: 'var(--sf-warning-soft-bg)', no_steps: 'var(--sf-neutral-soft-bg)', not_done: 'var(--sf-danger-soft-bg)' }; %>

<!-- الطلاب اللي سلموا -->
<h5 class="mb-3">✅ <span class="ar-only">سلّموا الواجب</span><span class="en-only" style="display:none;">Submitted Homework</span> (<%= submissions.length %>)</h5>
<div class="row g-3 mb-4">
  <% submissions.forEach(sub => { %>
    <div class="col-md-4">
      <% const submissionPaths = JSON.parse(sub.images || '[]'); %>
      <div class="card shadow-sm h-100" role="button" tabindex="0"
        data-submission-id="<%= sub.id %>"
        style="border-right: 4px solid <%= statusColors[sub.status] %>;cursor:pointer;">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <strong class="small"><%= sub.Student.name %></strong>
            <span class="badge" style="background:<%= statusBgColors[sub.status] %>;color:<%= statusColors[sub.status] %>;">
              <%= statusLabels[sub.status] %>
            </span>
          </div>
          <p class="small text-muted mb-0 mt-2"><%= submissionPaths.length %> <span class="ar-only">ملف مرفق</span><span class="en-only" style="display:none;">attached file(s)</span></p>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<!-- الطلاب اللي مسلموش ومصححوش -->
<% if (notSubmittedAndNotGraded.length > 0) { %>
  <h5 class="mb-3">⚠️ <span class="ar-only">لم يسلّموا ولم يصحَّح لهم</span><span class="en-only" style="display:none;">Not Submitted and Not Graded</span> (<%= notSubmittedAndNotGraded.length %>)</h5>
  <div class="card shadow-sm">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-sm">
          <thead class="table-light">
            <tr><th><span class="ar-only">الكود</span><span class="en-only" style="display:none;">Code</span></th><th><span class="ar-only">الاسم</span><span class="en-only" style="display:none;">Name</span></th><th><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></th><th><span class="ar-only">تليفون ولي الأمر</span><span class="en-only" style="display:none;">Parent Phone</span></th><th></th></tr>
          </thead>
          <tbody>
            <% notSubmittedAndNotGraded.forEach(s => { %>
              <tr>
                <td><%= s.student_code %></td>
                <td><%= s.name %></td>
                <td><%= s.Center ? s.Center.name : '-' %></td>
                <td><%= s.parent_phone || '-' %></td>
                <td>
                  <% if (s.parent_phone) { %>
                    <a href="https://wa.me/2<%= s.parent_phone.replace(/^0/, '') %>?text=السلام+عليكم،+ابنك+<%= encodeURIComponent(s.name) %>+لم+يسلم+الواجب+بتاع+<%= encodeURIComponent(assignment.title) %>+حتى+الآن"
                      target="_blank" class="btn btn-sm btn-success">
                      💬 <span class="ar-only">واتساب</span><span class="en-only" style="display:none;">WhatsApp</span>
                    </a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<div class="modal fade" id="submissionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="submissionModalTitle"><span class="ar-only">تفاصيل التسليم</span><span class="en-only" style="display:none;">Submission Details</span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="submissionModalBody"></div>
    </div>
  </div>
</div>

<!-- مودال عرض الصور -->
<div class="modal fade" id="imgModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content bg-dark">
      <div class="modal-header border-0">
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center p-2">
        <img id="modalImg" style="max-width:100%;max-height:80vh;border-radius:10px;">
      </div>
    </div>
  </div>
</div>

<script>
function openImg(src) {
  document.getElementById('modalImg').src = src;
  new bootstrap.Modal(document.getElementById('imgModal')).show();
}

let submissionModal;
const statusLabels = {
  complete: '<span class="ar-only">كامل</span><span class="en-only" style="display:none;">Complete</span>',
  incomplete: '<span class="ar-only">مش كامل</span><span class="en-only" style="display:none;">Incomplete</span>',
  no_steps: '<span class="ar-only">من غير خطوات</span><span class="en-only" style="display:none;">No Steps</span>',
  not_done: '<span class="ar-only">مش معمول</span><span class="en-only" style="display:none;">Not Done</span>'
};
const statusColors = { complete:'var(--sf-success-soft-text)', incomplete:'var(--sf-warning-soft-text)', no_steps:'var(--sf-neutral-soft-text)', not_done:'var(--sf-danger-soft-text)' };

function escapeHtml(value) {
  return String(value ?? '').replace(/[&<>'"]/g, character => ({
    '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;'
  }[character]));
}

async function openSubmission(card) {
  const modalBody = document.getElementById('submissionModalBody');
  modalBody.innerHTML = '<p class="text-center text-muted my-4"><span class="ar-only">جاري تحميل تفاصيل التسليم...</span><span class="en-only" style="display:none;">Loading submission details...</span></p>';
  submissionModal.show();

  try {
    const response = await fetch(`/hw/submissions/${card.dataset.submissionId}`);
    const data = await response.json();
    if (!response.ok || !data.success) throw new Error(data.message || 'فشل تحميل التسليم');

    const submission = data.submission;
    document.getElementById('submissionModalTitle').textContent = submission.studentName;
    const files = submission.paths.map(filePath => {
      const displayUrl = filePath.startsWith('http') ? filePath : `https://shadyelsharkawy.com/${filePath}`;
      const safeUrl = escapeHtml(displayUrl);
      const fileName = escapeHtml(filePath.split('/').pop());
      if (/\.(jpe?g|png|gif|webp)(\?.*)?$/i.test(filePath)) {
        return `<img src="${safeUrl}" alt="صورة الواجب" onclick="openImg(this.src)" style="width:90px;height:90px;object-fit:cover;border-radius:8px;cursor:pointer;background:var(--sf-neutral-soft-bg);">`;
      }
      return `<a href="${safeUrl}" target="_blank" class="d-flex align-items-center justify-content-center rounded border text-center" style="width:90px;height:90px;background:var(--sf-panel-bg);color:var(--sf-text);text-decoration:none;font-size:0.78rem;">${/\.pdf(\?.*)?$/i.test(filePath) ? '📄' : '🔗'}<br><span style="font-size:0.65rem;line-height:1.1;">${fileName}</span></a>`;
    }).join('');
    const gradingButtons = ['complete','incomplete','no_steps','not_done'].map(status =>
      `<button onclick="gradeSubmission(${submission.id}, '${status}', ${submission.assignmentId})" class="btn btn-sm" style="font-size:0.72rem;padding:4px 8px;background:${submission.status === status ? statusColors[status] : 'var(--sf-neutral-soft-bg)'};color:${submission.status === status ? '#fff' : 'var(--sf-neutral-soft-text)'};">${statusLabels[status]}</button>`
    ).join('');

    modalBody.innerHTML = `
      <p class="small text-muted mb-1">🎓 ${escapeHtml(submission.subjectName)} | ${escapeHtml(submission.centerName)}<br>
        🔖 ${escapeHtml(submission.studentCode)}<br>
        📁 ${submission.paths.length} <span class="ar-only">ملف مرفق</span><span class="en-only" style="display:none;">attached file(s)</span> | 🕐 ${new Date(submission.createdAt).toLocaleString('ar-EG')}
      </p>
      ${submission.comment ? `<p class="small bg-light rounded p-2 mb-3">💬 ${escapeHtml(submission.comment)}</p>` : ''}
      <div class="d-flex flex-wrap gap-1 mb-3">${files}</div>
      <div class="d-flex gap-1 flex-wrap">${gradingButtons}</div>
      <form action="/hw/submissions/${submission.id}/delete" method="POST" class="mt-3" onsubmit="return confirm('سيتم حذف تسليم هذا الطالب وملفاته من الاستضافة نهائياً. هل أنت متأكد؟')">
        <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ <span class="ar-only">حذف التسليم والملفات</span><span class="en-only" style="display:none;">Delete Submission and Files</span></button>
      </form>`;
  } catch (error) {
    modalBody.innerHTML = `<p class="text-danger">❌ ${escapeHtml(error.message)}</p>`;
  }
}

document.addEventListener('DOMContentLoaded', () => {
  submissionModal = new bootstrap.Modal(document.getElementById('submissionModal'));
  document.querySelectorAll('[data-submission-id]').forEach(card => {
    card.addEventListener('click', () => openSubmission(card));
    card.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openSubmission(card);
      }
    });
  });
});

async function gradeSubmission(subId, status, assignmentId) {
  const statusLabels = { complete:'كامل', incomplete:'مش كامل', no_steps:'من غير خطوات', not_done:'مش معمول' };
  if (!confirm(`تأكيد تصحيح الواجب كـ "${statusLabels[status]}"؟`)) return;

  const res = await fetch(`/hw/submissions/${subId}/grade`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status, assignment_id: assignmentId }),
  });
  const data = await res.json();
  if (data.success) location.reload();
  else alert('❌ حصلت مشكلة');
}
</script>

<%- include('partials/footer') %>