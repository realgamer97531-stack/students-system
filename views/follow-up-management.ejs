<%- include('partials/header') %>

<h3 class="mb-4">🎯 <span class="ar-only">إدارة توزيع المتابعة</span><span class="en-only" style="display:none;">Follow-up Distribution Management</span></h3>

<!-- الأسيستانتس وإحصائياتهم -->
<div class="row g-3 mb-4">
  <% Object.values(assistantStats).forEach(stat => { %>
    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <strong><%= stat.user.name %></strong>
            <span class="badge" style="background:var(--sf-primary-light);color:var(--sf-primary);"><%= stat.count %> <span class="ar-only">طالب</span><span class="en-only" style="display:none;">Students</span></span>
          </div>
          <form action="/admin/follow-up-management/settings" method="POST" class="d-flex gap-1 mb-2">
            <input type="number" name="max_<%= stat.user.id %>" class="form-control form-control-sm"
              value="<%= settings['max_' + stat.user.id] || 50 %>" placeholder="الحد الأقصى">
            <button class="btn btn-sm btn-outline-primary"><span class="ar-only">حفظ</span><span class="en-only" style="display:none;">Save</span></button>
          </form>
          <div style="max-height:150px;overflow-y:auto;">
            <% stat.students.forEach(s => { %>
              <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                <span style="font-size:0.78rem;"><%= s?.name %></span>
                <form action="/admin/follow-up-management/unassign/<%= s?.id %>" method="POST">
                  <button class="btn btn-sm" style="padding:1px 6px;background:var(--sf-danger-soft-bg);color:var(--sf-danger-soft-text);font-size:0.65rem;"><span class="ar-only">إلغاء</span><span class="en-only" style="display:none;">Cancel</span></button>
                </form>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<!-- تعيين يدوي -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3"><span class="ar-only">تعيين طالب يدوياً</span><span class="en-only" style="display:none;">Manually Assign Student</span></h6>
    <form action="/admin/follow-up-management/assign" method="POST" class="row g-2">
      <div class="col-md-4">
        <select name="student_id" class="form-select form-select-sm" required>
          <option value=""><span class="ar-only">-- اختر الطالب --</span><span class="en-only" style="display:none;">-- Select Student --</span></option>
          <% unassignedStudents.forEach(s => { %>
            <option value="<%= s.id %>"><%= s.name %> - <%= s.student_code %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <select name="assistant_id" class="form-select form-select-sm" required>
          <option value=""><span class="ar-only">-- اختر الأسيستانت --</span><span class="en-only" style="display:none;">-- Select Assistant --</span></option>
          <% followUpEligible.forEach(u => { %>
            <option value="<%= u.id %>"><%= u.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <button class="btn btn-primary btn-sm w-100"><span class="ar-only">تعيين</span><span class="en-only" style="display:none;">Assign</span></button>
      </div>
    </form>
  </div>
</div>

<!-- توزيع تلقائي -->
<div class="card shadow-sm mb-4">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <h6 class="mb-1"><span class="ar-only">توزيع تلقائي</span><span class="en-only" style="display:none;">Auto Distribution</span> (Round-Robin)</h6>
      <p class="small text-muted mb-0"><span class="ar-only">سيوزع</span><span class="en-only" style="display:none;">Will distribute</span> <%= unassignedStudents.length %> <span class="ar-only">طالب غير مُعيَّن على الأسيستانتس المتاحين</span><span class="en-only" style="display:none;">unassigned students to the available assistants</span></p>
    </div>
    <form action="/admin/follow-up-management/auto-assign" method="POST">
      <button class="btn btn-success" onclick="return confirm('سيتم التوزيع التلقائي. متأكد؟')">⚡ <span class="ar-only">توزيع تلقائي</span><span class="en-only" style="display:none;">Auto Distribution</span></button>
    </form>
  </div>
</div>

<!-- كل الطلاب -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h6 class="mb-3">👥 <span class="ar-only">كل الطلاب</span><span class="en-only" style="display:none;">All Students</span></h6>

    <form action="/admin/follow-up-management/bulk-assign" method="POST" id="bulkForm">
      <div class="d-flex gap-2 mb-3 align-items-center flex-wrap p-2 rounded" style="background:var(--sf-primary-light);">
        <div class="form-check mb-0">
          <input type="checkbox" class="form-check-input" id="selectAll" onchange="toggleAll(this)">
          <label class="form-check-label small fw-bold" for="selectAll"><span class="ar-only">تحديد الكل</span><span class="en-only" style="display:none;">Select All</span></label>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
          <select id="filterSubject" name="subject_id" class="form-select form-select-sm" style="width:180px;">
            <option value=""><span class="ar-only">-- تصفية بالمادة --</span><span class="en-only" style="display:none;">-- Filter by Subject --</span></option>
            <% subjects.forEach(sub => { %>
              <option value="<%= sub.id %>" <%= selectedSubjectId == sub.id ? 'selected' : '' %>><%= sub.name %></option>
            <% }) %>
          </select>
          <select id="filterCenter" name="center_id" class="form-select form-select-sm" style="width:180px;">
            <option value=""><span class="ar-only">-- تصفية بالسنتر --</span><span class="en-only" style="display:none;">-- Filter by Center --</span></option>
            <% centers.forEach(center => { %>
              <option value="<%= center.id %>" <%= selectedCenterId == center.id ? 'selected' : '' %>><%= center.name %></option>
            <% }) %>
          </select>
          <button type="button" class="btn btn-sm btn-outline-primary" onclick="applyFollowUpFilters()"><span class="ar-only">تطبيق التصفية</span><span class="en-only" style="display:none;">Apply Filter</span></button>
        </div>
        <select name="assistant_id" class="form-select form-select-sm" style="width:180px;">
          <option value=""><span class="ar-only">-- اختر أسيستانت --</span><span class="en-only" style="display:none;">-- Select Assistant --</span></option>
          <% followUpEligible.forEach(u => { %>
            <option value="<%= u.id %>"><%= u.name %></option>
          <% }) %>
        </select>
        <button type="submit" name="action" value="assign" class="btn btn-sm btn-primary"><span class="ar-only">تعيين للمختارين</span><span class="en-only" style="display:none;">Assign Selected</span></button>
        <button type="submit" name="action" value="unassign" class="btn btn-sm btn-outline-danger"
          onclick="return confirm('إلغاء تعيين كل المحددين؟')"><span class="ar-only">إلغاء تعيين المختارين</span><span class="en-only" style="display:none;">Unassign Selected</span></button>
        <span class="small text-muted ms-auto" id="selectedCount">0 محدد</span>
      </div>

      <input type="text" id="studentBulkSearch" class="form-control form-control-sm mb-3" placeholder="🔍 بحث...">

      <div class="table-responsive" style="max-height:500px;overflow-y:auto;">
        <table class="table table-sm table-hover" id="bulkTable">
          <thead class="table-light" style="position:sticky;top:0;">
            <tr>
              <th style="width:40px;"></th>
              <th><span class="ar-only">الطالب</span><span class="en-only" style="display:none;">Student</span></th>
              <th><span class="ar-only">المادة</span><span class="en-only" style="display:none;">Subject</span></th>
              <th><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></th>
              <th><span class="ar-only">الأسيستانت الحالي</span><span class="en-only" style="display:none;">Current Assistant</span></th>
            </tr>
          </thead>
          <tbody>
            <%
              const assignedMap = {};
              assignments.forEach(a => { assignedMap[a.StudentId] = a.Assistant; });
            %>
            <% allStudentsForBulk.forEach(s => { %>
              <tr data-search="<%= (s.name + ' ' + s.student_code + ' ' + (s.Subject?.name||'') + ' ' + (s.Center?.name||'')).toLowerCase() %>">
                <td>
                  <input type="checkbox" name="student_ids" value="<%= s.id %>"
                    class="form-check-input student-checkbox" onchange="updateCount()">
                </td>
                <td>
                  <span class="small fw-bold"><%= s.name %></span><br>
                  <span class="text-muted" style="font-size:0.68rem;"><%= s.student_code %></span>
                </td>
                <td><span class="small"><%= s.Subject?.name || '-' %></span></td>
                <td><span class="small"><%= s.Center?.name || '-' %></span></td>
                <td>
                  <% const currentAss = assignedMap[s.id]; %>
                  <% if (currentAss) { %>
                    <span class="badge" style="background:var(--sf-primary-light);color:var(--sf-primary);font-size:0.7rem;"><%= currentAss.name %></span>
                  <% } else { %>
                    <span class="badge bg-secondary" style="font-size:0.65rem;"><span class="ar-only">غير محدد</span><span class="en-only" style="display:none;">Unassigned</span></span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </form>
  </div>
</div>

<script>
function toggleAll(master) {
  document.querySelectorAll('#bulkTable tbody tr').forEach(row => {
    const checkbox = row.querySelector('.student-checkbox');
    if (!checkbox) return;
    if (row.style.display === 'none') return;
    checkbox.checked = master.checked;
  });
  updateCount();
}

function updateCount() {
  const count = document.querySelectorAll('.student-checkbox:checked').length;
  document.getElementById('selectedCount').textContent = count + ' محدد';
}

document.getElementById('studentBulkSearch').addEventListener('input', function() {
  const term = this.value.toLowerCase();
  document.querySelectorAll('#bulkTable tbody tr').forEach(row => {
    row.style.display = row.dataset.search.includes(term) ? '' : 'none';
  });
  document.getElementById('selectAll').checked = false;
  updateCount();
});

function applyFollowUpFilters() {
  const subjectId = document.getElementById('filterSubject').value;
  const centerId = document.getElementById('filterCenter').value;
  const params = new URLSearchParams(window.location.search);
  if (subjectId) params.set('subject_id', subjectId);
  else params.delete('subject_id');
  if (centerId) params.set('center_id', centerId);
  else params.delete('center_id');
  window.location.search = params.toString();
}
</script>

<%- include('partials/footer') %>