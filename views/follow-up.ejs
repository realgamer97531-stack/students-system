<%- include('partials/header') %>

<h3 class="mb-2">⚠️ <span class="ar-only">طلاب محتاجين متابعة</span><span class="en-only" style="display:none;">Students Needing Follow-up</span></h3>
<p class="text-muted mb-4"><span class="ar-only">نظام متقدم لمتابعة أداء الطلاب مع تحليل شامل للمخاطر</span><span class="en-only" style="display:none;">An advanced system for tracking student performance with comprehensive risk analysis</span></p>

<style>
  .severity-critical { background-color: #fee2e2; border-right: 4px solid #dc2626; border-radius: 8px; }
  .severity-warning { background-color: #fef3c7; border-right: 4px solid #f59e0b; border-radius: 8px; }
  .severity-caution { background-color: #e0f2fe; border-right: 4px solid #0284c7; border-radius: 8px; }
  [data-theme="dark"] .severity-critical { background-color: rgba(220, 38, 38, 0.15); }
  [data-theme="dark"] .severity-warning { background-color: rgba(245, 158, 11, 0.15); }
  [data-theme="dark"] .severity-caution { background-color: rgba(2, 132, 199, 0.15); }
  
  .risk-badge { 
    font-size: 0.85rem; 
    font-weight: bold;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .risk-critical { background: #dc2626; color: white; }
  .risk-warning { background: #f59e0b; color: white; }
  .risk-caution { background: #0284c7; color: white; }

  .student-row { cursor: pointer; transition: transform 0.2s cubic-bezier(0.4,0,0.2,1), background 0.2s ease; }
  .student-row:hover { transform: translateX(-4px); }
  
  .details-section { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .details-section.open { max-height: 500px; }
  
  .stat-mini { display: inline-block; margin: 4px 8px 4px 0; padding: 4px 10px; background: var(--sf-table-header-bg, #f3f4f6); color: var(--sf-text, inherit); border-radius: 6px; font-size: 0.85rem; }
  .exam-item { background: var(--sf-table-header-bg, #f9fafb); color: var(--sf-text, inherit); padding: 8px 10px; margin: 4px 0; border-radius: 6px; font-size: 0.85rem; }
  
  .badge-flag {
    display: inline-block;
    margin: 2px 4px;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: bold;
  }
  .badge-critical { background: #fee2e2; color: #991b1b; }
  .badge-warning { background: #fef3c7; color: #92400e; }
  [data-theme="dark"] .badge-critical { background: rgba(220, 38, 38, 0.2); color: #fca5a5; }
  [data-theme="dark"] .badge-warning { background: rgba(245, 158, 11, 0.2); color: #fcd34d; }
</style>

<div class="card shadow-sm">
  <div class="card-body">
    <% if (result.length === 0) { %>
      <div class="alert alert-success mb-0">🎉 <span class="ar-only">مفيش حد محتاج متابعة دلوقتي - وضع ممتاز!</span><span class="en-only" style="display:none;">No one needs follow-up right now - excellent status!</span></div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th style="width: 5%;"><span class="ar-only">مستوى الخطورة</span><span class="en-only" style="display:none;">Risk Level</span></th>
              <th style="width: 8%;"><span class="ar-only">الكود</span><span class="en-only" style="display:none;">Code</span></th>
              <th style="width: 12%;"><span class="ar-only">الاسم</span><span class="en-only" style="display:none;">Name</span></th>
              <th style="width: 10%;"><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></th>
              <th style="width: 10%;"><span class="ar-only">المادة</span><span class="en-only" style="display:none;">Subject</span></th>
              <th style="width: 8%;"><span class="ar-only">الرصيد</span><span class="en-only" style="display:none;">Balance</span></th>
              <th style="width: 47%;"><span class="ar-only">الأسباب والتفاصيل</span><span class="en-only" style="display:none;">Reasons and Details</span></th>
            </tr>
          </thead>
          <tbody>
            <% result.forEach((r, index) => { %>
              <tr class="student-row severity-<%= r.severity %>" onclick="toggleDetails(this, <%= index %>)">
                <td>
                  <span class="risk-badge risk-<%= r.severity %>">
                    <% if (r.severity === 'critical') { %>🔴 <span class="ar-only">حرج</span><span class="en-only" style="display:none;">Critical</span><% }
                       else if (r.severity === 'warning') { %>🟠 <span class="ar-only">تحذير</span><span class="en-only" style="display:none;">Warning</span><% }
                       else { %>🟡 <span class="ar-only">تنبيه</span><span class="en-only" style="display:none;">Alert</span><% } %>
                  </span>
                  <div style="font-size: 0.75rem; color: var(--sf-muted); margin-top: 2px;"><span class="ar-only">نقاط:</span><span class="en-only" style="display:none;">Points:</span> <%= r.riskScore %></div>
                </td>
                <td><strong><%= r.student.student_code %></strong></td>
                <td>
                  <a href="/students/<%= r.student.id %>" style="text-decoration: none; color: inherit;">
                    <strong><%= r.student.name %></strong>
                  </a>
                  <br>
                  <small class="text-muted"><span class="ar-only">آخر حضور:</span><span class="en-only" style="display:none;">Last attendance:</span> <%= r.lastAttendance %></small>
                </td>
                <td><%= r.student.Center.name %></td>
                <td><%= r.student.Subject.name %></td>
                <td>
                  <% if (r.student.balance < 100) { %>
                    <span class="badge bg-danger"><%= r.student.balance %> ج</span>
                  <% } else { %>
                    <span class="badge bg-success"><%= r.student.balance %> ج</span>
                  <% } %>
                </td>
                <td>
                  <% r.reasons.forEach(reason => { %>
                    <div style="margin: 2px 0; font-size: 0.9rem;"><%= reason %></div>
                  <% }) %>
                </td>
              </tr>

              <!-- صف التفاصيل المخفي -->
              <tr class="details-row" id="details-<%= index %>" style="display: none;">
                <td colspan="7" class="p-3">
                  <div class="row">
                    <!-- قسم الإحصائيات -->
                    <div class="col-md-4">
                      <h6 class="fw-bold mb-2">📊 <span class="ar-only">الإحصائيات</span><span class="en-only" style="display:none;">Statistics</span></h6>
                      <div class="stat-mini">
                        📅 <span class="ar-only">حضور:</span><span class="en-only" style="display:none;">Attendance:</span> <strong><%= r.statistics.attendanceRate %>%</strong>
                      </div>
                      <div class="stat-mini">
                        ✅ <span class="ar-only">واجبات:</span><span class="en-only" style="display:none;">Homework:</span> <strong><%= r.statistics.homeworkQuality %>%</strong>
                      </div>
                      <div class="stat-mini">
                        📈 <span class="ar-only">متوسط امتحانات:</span><span class="en-only" style="display:none;">Average exam score:</span> <strong><%= r.statistics.averageExamScore %>%</strong>
                      </div>
                    </div>

                    <!-- قسم الأعلام والتحذيرات -->
                    <div class="col-md-4">
                      <h6 class="fw-bold mb-2">🚩 <span class="ar-only">الأعلام</span><span class="en-only" style="display:none;">Flags</span></h6>
                      <% if (r.flags.lowBalance) { %>
                        <span class="badge-flag badge-critical">💳 <span class="ar-only">رصيد منخفض</span><span class="en-only" style="display:none;">Low balance</span></span>
                      <% } %>
                      <% if (r.flags.absentSessions === true) { %>
                        <span class="badge-flag badge-critical">🔴 <span class="ar-only">غياب متكرر</span><span class="en-only" style="display:none;">Repeated absence</span></span>
                      <% } else if (r.flags.absentSessions === 'warning') { %>
                        <span class="badge-flag badge-warning">🟡 <span class="ar-only">غياب واحد</span><span class="en-only" style="display:none;">One absence</span></span>
                      <% } %>
                      <% if (r.flags.poorHomework === true) { %>
                        <span class="badge-flag badge-critical">🟠 <span class="ar-only">واجبات ضعيفة</span><span class="en-only" style="display:none;">Poor homework</span></span>
                      <% } else if (r.flags.poorHomework === 'warning') { %>
                        <span class="badge-flag badge-warning">🟡 <span class="ar-only">واجب ضعيف</span><span class="en-only" style="display:none;">Weak homework</span></span>
                      <% } %>
                      <% if (r.flags.unfinalizedExams) { %>
                        <span class="badge-flag badge-warning">📝 <span class="ar-only">امتحانات لم تُصحح</span><span class="en-only" style="display:none;">Uncorrected exams</span></span>
                      <% } %>
                      <% if (r.flags.lowExamScores) { %>
                        <span class="badge-flag badge-critical">📊 <span class="ar-only">علامات منخفضة</span><span class="en-only" style="display:none;">Low scores</span></span>
                      <% } %>
                      <% if (r.flags.warnings) { %>
                        <span class="badge-flag badge-critical">⚠️ <span class="ar-only">تنبيهات معلقة</span><span class="en-only" style="display:none;">Pending warnings</span></span>
                      <% } %>
                    </div>

                    <!-- قسم آخر امتحانات -->
                    <div class="col-md-4">
                      <h6 class="fw-bold mb-2">📋 <span class="ar-only">آخر امتحانات</span><span class="en-only" style="display:none;">Recent Exams</span></h6>
                      <% if (r.statistics.recentExams.length > 0) { %>
                        <% r.statistics.recentExams.forEach(exam => { %>
                          <div class="exam-item">
                            <span class="ar-only">حصة #</span><span class="en-only" style="display:none;">Session #</span><strong><%= exam.lesson %></strong>:
                            <span class="<%= exam.percentage >= 60 ? 'text-success' : exam.percentage >= 40 ? 'text-warning' : 'text-danger' %>" style="font-weight: bold;">
                              <%= exam.score %>/<%= exam.maxScore %> (<%= exam.percentage %>%)
                            </span>
                          </div>
                        <% }) %>
                      <% } else { %>
                        <small class="text-muted"><span class="ar-only">لا توجد امتحانات</span><span class="en-only" style="display:none;">No exams</span></small>
                      <% } %>
                    </div>
                  </div>

                  <!-- قسم التنبيهات المعلقة -->
                  <% if (r.warnings && r.warnings.length > 0) { %>
                    <div class="mt-3 pt-3 border-top">
                      <h6 class="fw-bold text-danger">⚠️ <span class="ar-only">التنبيهات المعلقة</span><span class="en-only" style="display:none;">Pending Warnings</span></h6>
                      <ul class="mb-0 small">
                        <% r.warnings.forEach(w => { %>
                          <li><strong><%= w.reason %></strong> <span class="text-muted">(<%= new Date(w.createdAt).toLocaleDateString('ar-EG') %>)</span></li>
                        <% }) %>
                      </ul>
                    </div>
                  <% } %>

                  <!-- أزرار الإجراءات السريعة -->
                  <div class="mt-3 pt-3 border-top">
                    <button class="btn btn-sm btn-primary" onclick="alert('رسالة: سيتم إضافة هذه الميزة قريباً')">💬 <span class="ar-only">إرسال رسالة</span><span class="en-only" style="display:none;">Send Message</span></button>
                    <button class="btn btn-sm btn-warning" onclick="alert('جدولة: سيتم إضافة هذه الميزة قريباً')">📅 <span class="ar-only">جدولة متابعة</span><span class="en-only" style="display:none;">Schedule Follow-up</span></button>
                    <button class="btn btn-sm btn-info" onclick="window.location.href='/students/<%= r.student.id %>'">👁️ <span class="ar-only">عرض الملف</span><span class="en-only" style="display:none;">View Profile</span></button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
function toggleDetails(row, index) {
  const detailsRow = document.getElementById(`details-${index}`);
  if (detailsRow.style.display === 'none') {
    detailsRow.style.display = 'table-row';
    row.classList.add('fw-bold');
  } else {
    detailsRow.style.display = 'none';
    row.classList.remove('fw-bold');
  }
}
</script>

<%- include('partials/footer') %>