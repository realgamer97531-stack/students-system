<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-1">⭐ متابعة نقاط الطلاب</h3>
    <p class="text-muted small mb-0">قائمة الطلاب وإجمالي نقاطهم</p>
  </div>
</div>

<div class="table-responsive card p-3">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr>
        <th>#</th>
        <th>الطالب</th>
        <th>الكود</th>
        <th>المادة</th>
        <th>السنتر</th>
        <th class="text-center">النقاط</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach((student, index) => { %>
        <tr role="button" onclick="window.location.href='/admin/points/<%= student.id %>'">
          <td><%= index + 1 %></td>
          <td class="fw-bold"><%= student.name %></td>
          <td><%= student.student_code || '-' %></td>
          <td><%= student.Subject ? student.Subject.name : '-' %></td>
          <td><%= student.Center ? student.Center.name : '-' %></td>
          <td class="text-center">
            <span class="badge <%= Number(student.points || 0) >= 100 ? 'bg-warning text-dark' : 'bg-primary' %> px-3 py-2">
              <%= student.points || 0 %>
            </span>
          </td>
          <td class="text-end">
            <a href="/admin/points/<%= student.id %>" class="btn btn-sm btn-outline-primary">التفاصيل</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
