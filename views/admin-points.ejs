<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-1">⭐ <span class="ar-only">متابعة نقاط الطلاب</span><span class="en-only" style="display:none;">Student Points Tracking</span></h3>
    <p class="text-muted small mb-0"><span class="ar-only">قائمة الطلاب وإجمالي نقاطهم</span><span class="en-only" style="display:none;">List of students and their total points</span></p>
  </div>
</div>

<div class="table-responsive card p-3">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr>
        <th>#</th>
        <th><span class="ar-only">الطالب</span><span class="en-only" style="display:none;">Student</span></th>
        <th><span class="ar-only">الكود</span><span class="en-only" style="display:none;">Code</span></th>
        <th><span class="ar-only">المادة</span><span class="en-only" style="display:none;">Subject</span></th>
        <th><span class="ar-only">السنتر</span><span class="en-only" style="display:none;">Center</span></th>
        <th class="text-center"><span class="ar-only">النقاط</span><span class="en-only" style="display:none;">Points</span></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach((student, index) => { %>
        <tr role="button" onclick="window.location.href='/admin/points/<%= student.id %>'">
          <td><%= index + 1 %></td>
          <td class="fw-bold"><%= student.name %></td>
          <td><%= student.student_code || '-' %></td>
          <td><%= student.Subject ? student.Subject.name : '-' %></td>
          <td><%= student.Center ? student.Center.name : '-' %></td>
          <td class="text-center">
            <span class="badge bg-primary px-3 py-2">
              <%= student.points || 0 %>
            </span>
          </td>
          <td class="text-end">
            <a href="/admin/points/<%= student.id %>" class="btn btn-sm btn-outline-primary"><span class="ar-only">التفاصيل</span><span class="en-only" style="display:none;">Details</span></a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
