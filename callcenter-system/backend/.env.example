PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# --- Hostinger MySQL connection ---
# Find these under hPanel → Databases → MySQL Databases.
# You must also enable "Remote MySQL" (hPanel → Databases → Remote MySQL)
# and add the IP address of whatever server runs this backend — Hostinger
# blocks remote connections from unlisted IPs by default.
DB_HOST=your-db-host.hostinger.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# Set to true only if Hostinger requires/offers SSL for your plan
DB_SSL=false

# Used only by npm run seed to create the first admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Administrator

# Optional: customize the exact column header text your Excel files use.
# Leave blank to just use the built-in defaults (Name, Phone, Parent Phone,
# Grade, Subject, Student ID / ID / Student Code, all matched case-insensitively).
# Only set these if your spreadsheets use different wording, e.g.:
# COLUMN_HEADER_NAME=Full Name
# COLUMN_HEADER_STUDENT_ID=National ID
COLUMN_HEADER_STUDENT_ID=
COLUMN_HEADER_NAME=
COLUMN_HEADER_PHONE=
COLUMN_HEADER_PARENT_PHONE=
COLUMN_HEADER_GRADE=
COLUMN_HEADER_SUBJECT=
CALLCENTER_SERVICE_TOKEN=01000733148
CALLCENTER_COMMENT_CALLBACK_URL=https://students-system-production-6b89.up.railway.app/api/internal/callcenter/session-comment